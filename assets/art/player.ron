            (part: "crouch3", at: (8, 31)),
            (part: "hero_torso_hip", at: (17, 30), turn: -35),
            (part: "hero_head", at: (14, 9)),
            (part: "arm", at: (16, 25), turn: 35, outline: true, tag: "front_arm"),
