        'B': (112, 66, 30),       // boots
        'U': (172, 108, 46),      // boots, lit (the cuff)
        'C': (78, 48, 22),        // boots, the far foot
        'o': (40, 28, 14),        // soles
        'V': (196, 150, 96),      // pack: the bedroll, lit
