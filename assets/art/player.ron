// The player: an adventurer in a green tunic, drawn on the humanoid rig
// (parts put together into poses; crates/art). Facing right; the game
// mirrors it. ~33 px tall on a 9×23 body (the head may overhang it).
(
    size: (36, 38),
    feet: (17.5, 38),
    outline: (26, 20, 20),
    palette: {
        'j': (126, 86, 56),     // hair, lit
        'L': (104, 182, 124),   // tunic, lit
        'o': (40, 28, 24),      // soles
        'w': (238, 236, 240),   // eye white
        'r': (176, 104, 96),    // mouth
        'U': (98, 70, 52),      // boot cuff
        'h': (96, 62, 40),      // hair
        'H': (70, 44, 30),      // hair, shade
        's': (232, 184, 150),   // skin
        'S': (196, 140, 110),   // skin, shade
        'k': (34, 26, 30),      // eye
        't': (72, 150, 96),     // tunic
        'T': (52, 112, 72),     // tunic, shade
        'b': (104, 70, 44),     // belt
        'y': (220, 186, 90),    // buckle
        'p': (88, 84, 110),     // trousers
        'q': (66, 62, 84),      // trousers, the far leg
        'B': (72, 50, 38),      // boots
        'C': (54, 38, 30),      // boots, the far foot
    },
    parts: {
        "head": (rows: [
            "...hhhhhh...",
            ".hhjjjhhhh..",
            "hhjjhhhhhhh.",
            "hhhhhhhhhhhh",
            "HHhhhhhsssss",
            "HHhhSssHHss.",
            "HHhSsssswks.",
            "HHhSSssswkss",
            ".HhSsssssssS",
            "..HSSsssrr..",
            "...SSSss....",
        ]),
        "blink": (rows: [
            "...hhhhhh...",
            ".hhjjjhhhh..",
            "hhjjhhhhhhh.",
            "hhhhhhhhhhhh",
            "HHhhhhhsssss",
            "HHhhSssHHss.",
            "HHhSssssssss",
            "HHhSSsssSSss",
            ".HhSsssssssS",
            "..HSSsssrr..",
            "...SSSss....",
        ]),
        "torso": (rows: [
            "..TTtsstt..",
            ".TTTtsttLt.",
            "TTTTtttLLt.",
            "TTTttttLtt.",
            "TTTtttttLt.",
            "TTTttttttt.",
            "bbbbbbbyyb.",
            "TTTtttttLt.",
            "TTTTTttttT.",
        ]),
        // Arms hang from the shoulder (pivot); the hand is where a weapon goes.
        "arm": (pivot: (0, 0), points: { "hand": (0, 8) }, rows: [
            "tLt",
            "tLt",
            "Ttt",
            "ss.",
            "ss.",
            "Ss.",
            "Ss.",
            "sss",
            "sS.",
        ]),
        "arm_fwd": (pivot: (0, 0), points: { "hand": (5, 6) }, rows: [
            "tLt...",
            "tLLt..",
            ".ttt..",
            "..sss.",
            "...ss.",
            "...Ss.",
            "...sss",
            "....sS",
        ]),
        "arm_back": (pivot: (3, 0), points: { "hand": (0, 6) }, rows: [
            "...tLt",
            "..tLLt",
            "..ttt.",
            ".sss..",
            ".ss...",
            "sS....",
            "sss...",
            "sS....",
        ]),
        "arm_up": (pivot: (0, 12), points: { "hand": (4, 1) }, rows: [
            "....s.",
            "...sss",
            "...Sss",
            "...Ss.",
            "...Ss.",
            "..Ss..",
            "..Ss..",
            "..Ss..",
            ".Ss...",
            ".Ss...",
            "tLt...",
            "tLt...",
            "Ttt...",
        ]),
        // Reaching up and forward (a jump; a hand on a wall).
        "arm_reach": (pivot: (0, 8), points: { "hand": (7, 1) }, rows: [
            "......ss.",
            "......sss",
            ".....Sss.",
            ".....Ss..",
            "....Ss...",
            "...Ss....",
            "..tLt....",
            ".tLt.....",
            "TtT......",
        ]),
        // Thrown forward and up (a jump).
        "arm_lift": (pivot: (0, 5), points: { "hand": (7, 1) }, rows: [
            "......ss.",
            ".....ssss",
            ".....Sss.",
            "tLt.Ss...",
            "tttSs....",
            "TTt......",
        ]),
        // The front arm pointing where it aims (casting, later weapons): at
        // angles from straight down to straight up (the fan below).
        "aimm90": (pivot: (2, 0), points: { "hand": (1, 9) }, rows: [
            "tLt",
            "tLt",
            "Ttt",
            "Ss.",
            "Ss.",
            "Ss.",
            "Ss.",
            "Ss.",
            "sss",
            "Sss",
            "Ss.",
        ]),
        "aimm60": (pivot: (1, 0), points: { "hand": (4, 8) }, rows: [
            "tL....",
            "tLL...",
            "TtL...",
            ".Tt...",
            ".Ss...",
            "..Ss..",
            "..Sss.",
            "...Sss",
            "...sss",
            "....Ss",
        ]),
        "aimm30": (pivot: (1, 0), points: { "hand": (8, 5) }, rows: [
            ".LL.......",
            "ttL.......",
            "TTtL......",
            "..Ttss....",
            "...SSssss.",
            ".....SSsss",
            ".......SSs",
        ]),
        "aim0": (pivot: (0, 0), points: { "hand": (9, 1) }, rows: [
            "tLL.....ss.",
            "tttssssssss",
            "TTTSSSSSSSS",
        ]),
        "aim30": (pivot: (0, 4), points: { "hand": (8, 1) }, rows: [
            ".......ss.",
            "......ssss",
            ".....ssSS.",
            ".LLLsSS...",
            "ttttt.....",
            "TTTT......",
        ]),
        "aim60": (pivot: (0, 8), points: { "hand": (5, 1) }, rows: [
            ".....ss",
            "....sss",
            "....Sss",
            "....Ss.",
            "...Ss..",
            "...Ss..",
            "..tLs..",
            "tLLt...",
            "Ttt....",
            ".TT....",
        ]),
        "aim90": (pivot: (2, 9), points: { "hand": (1, 1) }, rows: [
            ".ss",
            "sss",
            "Sss",
            ".Ss",
            ".Ss",
            ".Ss",
            ".Ss",
            ".Ss",
            "tLt",
            "tLt",
            "Ttt",
        ]),
        // Legs from the hip: standing, a six-step run, in the air.
        "legs": (points: { "foot_near": (8, 10), "foot_far": (2, 10) }, rows: [
            ".pppppppp..",
            ".qqqp.ppp..",
            ".qqq..ppp..",
            ".qqq..ppp..",
            ".qqq..ppp..",
            ".qqq..ppp..",
            ".qqq..ppp..",
            ".CCC..UUU..",
            ".CCC..BBB..",
            ".CCC..BBBB.",
            ".oooo.ooooo",
        ]),
        "run1": (points: { "foot_near": (11, 10), "foot_far": (1, 9) }, rows: [
            "...pppppp.....",
            "..qqqqpppp....",
            "..qqq..ppp....",
            ".qqq....ppp...",
            ".qqq.....ppp..",
            "qqq.......ppp.",
            "qqq.......ppp.",
            "CCC.......UUU.",
            "CCo.......BBB.",
            "Co........BBBB",
            "o.........oooo",
        ]),
        "run2": (points: { "foot_near": (10, 10), "foot_far": (6, 6) }, rows: [
            "...pppppp.....",
            "...qqqppp.....",
            "...qqq.ppp....",
            "....qqq.ppp...",
            ".....qqq.ppp..",
            ".....CCC.ppp..",
            ".....ooo.ppp..",
            ".........UUU..",
            ".........BBB..",
            ".........BBBB.",
            ".........oooo.",
        ]),
        "run3": (points: { "foot_near": (8, 10), "foot_far": (3, 6) }, rows: [
            "...pppppp.....",
            "...qqqpppp....",
            "...qqq.ppp....",
            "....qq.ppp....",
            "....qq.ppp....",
            "...CCo.ppp....",
            "...oo..ppp....",
            ".......UUU....",
            ".......BBB....",
            ".......BBBB...",
            ".......oooo...",
        ]),
        "run4": (points: { "foot_near": (1, 9), "foot_far": (11, 10) }, rows: [
            "...pppppp.....",
            "..ppppqqqq....",
            "..ppp..qqq....",
            ".ppp....qqq...",
            ".ppp.....qqq..",
            "ppp.......qqq.",
            "ppp.......qqq.",
            "UUU.......CCC.",
            "BBo.......CCC.",
            "Bo........CCCC",
            "o.........oooo",
        ]),
        "tuck": (points: { "foot_near": (9, 8), "foot_far": (4, 8) }, rows: [
            "..pppppp....",
            "..ppppppppp.",
            "..qqqppppppp",
            "..qqq...ppp.",
            "..qqq...ppp.",
            "..qqqq..UUU.",
            "...CCC..BBB.",
            "...CCCC.BBBB",
            "...oooo.oooo",
        ]),
        // Knees drawn up high (a plunge, over the blade).
        "knees": (points: { "foot_near": (9, 6), "foot_far": (2, 6) }, rows: [
            "pppppppp....",
            "qqqppppppppp",
            "qqqq.ppppppp",
            "qqqq....UUU.",
            ".CCC....BBB.",
            ".CCCC...BBBB",
            ".oooo...oooo",
        ]),
        "dangle": (points: { "foot_near": (8, 9), "foot_far": (3, 8) }, rows: [
            "..pppppp...",
            "..qqqpppp..",
            "..qqq.ppp..",
            "..qqq.ppp..",
            "..qqq..ppp.",
            "..CCC..ppp.",
            "..CCC..UUU.",
            "..CCCC.BBB.",
            "..oooo.BBBB",
            ".......oooo",
        ]),
        // A kick: the near knee drawn up (the far leg planted), then the leg
        // out straight at the hip, the boot's sole leading.
        "kick_knee": (points: { "foot_near": (10, 8), "foot_far": (4, 10) }, rows: [
            "..pppppp......",
            "..qqqpppppp...",
            "..qqq.ppppppp.",
            "..qqq....pppp.",
            "..qqq.....ppp.",
            "..qqq.....UUU.",
            "..qqq.....BBB.",
            "..CCC....BBBB.",
            "..CCC....oooo.",
            "..CCCC........",
            "..ooooo.......",
        ]),
        "kick_leg": (points: { "foot_near": (17, 2), "foot_far": (4, 10) }, rows: [
            "..pppppp.......BBo",
            "..qqqppppppppUBBBo",
            "..qqqppppppppUBBBo",
            "..qqqppppppppUBBBo",
            "..qqq............o",
            "..qqq.............",
            "..qqq.............",
            "..CCC.............",
            "..CCC.............",
            "..CCCC............",
            "..ooooo...........",
        ]),
    },
    poses: {
        // Standing; breathing in (the chest and head a pixel up); a blink.
        "stand": [
            (part: "arm", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "legs", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        "breathe": [
            (part: "arm", at: (14, 17), shade: 0.72, tag: "back_arm"),
            (part: "legs", at: (12, 26)),
            (part: "torso", at: (12, 15)),
            (part: "head", at: (12, 5)),
            (part: "arm", at: (18, 17), outline: true, tag: "front_arm"),
        ],
        "blink": [
            (part: "arm", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "legs", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "blink", at: (12, 6)),
            (part: "arm", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        // Running: legs through the stride, arms swinging against them, a
        // bob on the passing steps.
        "run_a": [
            (part: "arm_fwd", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "run1", at: (11, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm_back", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        "run_b": [
            (part: "arm", at: (14, 17), shade: 0.72, tag: "back_arm"),
            (part: "run2", at: (11, 24)),
            (part: "torso", at: (12, 15)),
            (part: "head", at: (12, 5)),
            (part: "arm", at: (18, 17), outline: true, tag: "front_arm"),
        ],
        "run_c": [
            (part: "arm_back", at: (15, 18), shade: 0.72, tag: "back_arm"),
            (part: "run4", at: (11, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm_fwd", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        "run_d": [
            (part: "arm", at: (14, 17), shade: 0.72, tag: "back_arm"),
            (part: "run3", at: (11, 24)),
            (part: "torso", at: (12, 15)),
            (part: "head", at: (12, 5)),
            (part: "arm", at: (18, 17), outline: true, tag: "front_arm"),
        ],
        // Rising: knees up, an arm thrown up. Falling: legs down, arms out.
        "rise": [
            (part: "arm", at: (14, 17), shade: 0.72, tag: "back_arm"),
            (part: "tuck", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm_lift", at: (20, 21), outline: true, tag: "front_arm"),
        ],
        "drop": [
            (part: "arm_up", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "dangle", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm_fwd", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        // Striking down: tucked, the head down over the blade. Plunging:
        // knees up high, the back arm up for balance.
        "strike_down": [
            (part: "arm_back", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "tuck", at: (12, 24)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (14, 8)),
            (part: "arm", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        "plunge_pose": [
            (part: "arm_up", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "knees", at: (12, 24)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        // Kicking: the knee up, leaning back a little, the arms swung
        // against the leg for balance; then the leg out, leaning back more.
        "kick_wind": [
            (part: "arm_fwd", at: (12, 18), shade: 0.72, tag: "back_arm"),
            (part: "kick_knee", at: (12, 26)),
            (part: "torso", at: (11, 17)),
            (part: "head", at: (11, 6)),
            (part: "arm_back", at: (17, 18), outline: true, tag: "front_arm"),
        ],
        "kick_out": [
            (part: "arm_fwd", at: (11, 18), shade: 0.72, tag: "back_arm"),
            (part: "kick_leg", at: (12, 26)),
            (part: "torso", at: (11, 17)),
            (part: "head", at: (9, 8)),
            (part: "arm_back", at: (15, 18), outline: true, tag: "front_arm"),
        ],
        // Dashing: leaning in, arms back.
        "dash": [
            (part: "arm_back", at: (14, 20), shade: 0.72, tag: "back_arm"),
            (part: "run1", at: (9, 26)),
            (part: "torso", at: (14, 18)),
            (part: "head", at: (15, 9)),
            (part: "arm_back", at: (17, 20), outline: true, tag: "front_arm"),
        ],
        // Sliding down a wall (on the right): a hand on it.
        "wall": [
            (part: "arm", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "dangle", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm_reach", at: (20, 18), outline: true, tag: "front_arm"),
        ],
    },
    // The front arm at angles: shown instead of the pose's own front arm
    // (tagged `front_arm`) while aiming. (The back arm is tagged too: its
    // hand, `back_arm.hand`, holds a torch.)
    fans: {
        "front_arm": [
            (angle: -90, part: "aimm90"),
            (angle: -60, part: "aimm60"),
            (angle: -30, part: "aimm30"),
            (angle: 0, part: "aim0"),
            (angle: 30, part: "aim30"),
            (angle: 60, part: "aim60"),
            (angle: 90, part: "aim90"),
        ],
    },
    derived: {
        // Hit: knocked back a pixel.
        "hurt": (from: "drop", shift: (-1, 0)),
    },
    clips: {
        "idle": (frames: ["stand", "stand", "breathe", "breathe", "stand", "stand", "breathe", "breathe", "stand", "blink", "stand", "breathe", "breathe"], fps: 5),
        "run": (frames: ["run_a", "run_b", "run_c", "run_d"], fps: 11),
        "jump": (frames: ["rise"], fps: 5),
        "fall": (frames: ["drop"], fps: 5),
        "dash": (frames: ["dash"], fps: 5),
        "wall": (frames: ["wall"], fps: 5),
        "hurt": (frames: ["hurt"], fps: 5),
        "strike_down": (frames: ["strike_down"], fps: 5),
        "plunge": (frames: ["plunge_pose"], fps: 5),
        // Once through (kick.rs plays it): up, out, held, back.
        "kick": (frames: ["kick_wind", "kick_out", "kick_out", "kick_wind"], fps: 16, looping: false),
    },
)
