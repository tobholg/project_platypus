        'Q': (64, 42, 20),        // trousers, the far leg in shade
        'B': (100, 58, 24),       // boots
        'U': (160, 98, 42),       // boots, lit (the cuff, the toe)
        'C': (72, 42, 16),        // boots, the far foot
