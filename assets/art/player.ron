            (part: "arm", at: (14, 18), turn: 10, outline: true, tag: "front_arm"),
        ],
    },
    // The front arm at angles: shown instead of the pose's own front arm
    // (tagged `front_arm`) while aiming. (The back arm is tagged too: its
    // hand, `back_arm.hand`, holds a torch.)
    fans: {
        "front_arm": [
            (angle: -90, part: "aim", from: 0),
            (angle: -60, part: "aim", from: 0),
            (angle: -30, part: "aim", from: 0),
            (angle: 0, part: "aim", from: 0),
            (angle: 30, part: "aim", from: 0),
            (angle: 60, part: "aim", from: 0),
            (angle: 90, part: "aim", from: 0),
        ],
    },
    derived: {
        // Hit: knocked back a pixel.
        "hurt": (from: "drop", shift: (-1, 0)),
    },
    clips: {
        "idle": (frames: ["stand", "stand", "breathe", "breathe", "stand", "stand", "breathe", "breathe", "stand", "blink", "stand", "breathe", "breathe"], fps: 5),
        "run": (frames: ["run_1", "run_2", "run_3", "run_4", "run_5", "run_6", "run_7", "run_8"], fps: 20),
        "sprint": (frames: ["sprint_1", "sprint_2", "sprint_3", "sprint_4", "sprint_5", "sprint_6"], fps: 17),
        "jump": (frames: ["rise"], fps: 5),
        "fall": (frames: ["drop"], fps: 5),
        "dash": (frames: ["dash"], fps: 5),
        "wall": (frames: ["wall"], fps: 5),
        "hurt": (frames: ["hurt"], fps: 5),
        "strike_down": (frames: ["strike_down"], fps: 5),
        "plunge": (frames: ["plunge_pose"], fps: 5),
        "crouch": (frames: ["crouch_pose"], fps: 5),
        "crouch_walk": (frames: ["crouch_a", "crouch_b", "crouch_c", "crouch_b"], fps: 6),
        // Once through (kick.rs plays it): up, out, held, back.
        "kick": (frames: ["kick_wind", "kick_out", "kick_out", "kick_wind"], fps: 16, looping: false),
    },
)
