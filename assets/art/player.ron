            (part: "knees", at: (10, 24)),
            (part: "hero_torso", at: (10, 18)),
            (part: "hero_head", at: (9, 2)),
            (part: "arm", at: (12, 18), outline: true, tag: "front_arm"),
        ],
        // Kicking: the knee up, leaning back a little, the arms swung
        // against the leg for balance; then the leg out, leaning back more.
        "kick_wind": [
            (part: "arm", at: (20, 18), turn: 35, shade: 0.72, tag: "back_arm"),
            (part: "kick_knee", at: (10, 26)),
