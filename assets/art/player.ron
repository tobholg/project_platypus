        'p': (106, 74, 42),       // trousers
        'q': (88, 60, 32),        // trousers, the far leg
        'Q': (64, 42, 20),        // trousers, the far leg in shade
        'B': (100, 58, 24),       // boots
        'U': (160, 98, 42),       // boots, lit (the cuff, the toe)
        'C': (72, 42, 16),        // boots, the far foot
        'o': (34, 22, 10),        // soles
        'V': (167, 137, 102),     // pack: the bedroll, lit
        'v': (133, 99, 61),       // the bedroll
        'u': (96, 70, 40),        // the bedroll, its roll
        'N': (116, 74, 38),       // pack: the bag, lit
        'n': (86, 52, 22),        // the bag
        'G': (58, 34, 14),        // the bag, shade
    },
    parts: {
