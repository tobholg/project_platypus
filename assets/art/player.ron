            (part: "hero_head", at: (13, 3)),
            (part: "arm", at: (14, 19), turn: -18, outline: true, tag: "front_arm"),
        ],
        // Rising: knees up, an arm thrown up. Falling: legs down, arms out.
        "rise": [
            (part: "arm", at: (22, 17), turn: 110, shade: 0.72, tag: "back_arm"),
            (part: "tuck", at: (10, 26)),
