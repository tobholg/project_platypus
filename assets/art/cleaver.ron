// An orc cleaver: a broad, notched slab of iron on a short grip, pointing
// right, held at `grip`.
(
    size: (25, 11),
    feet: (13, 11),
    outline: (28, 24, 22),
    palette: {
        'D': (78, 80, 86),      // iron, dark
        'M': (122, 124, 130),   // iron
        'L': (176, 178, 180),   // the edge
        'r': (120, 70, 40),     // rust
        'y': (96, 70, 44),      // a lump of a guard
        'w': (70, 50, 36),      // the grip
    },
    frames: {
        "blade": [
            ".....y...DDDDDDDDDDD.....",
            ".....y..DMMMMMMMMMMMD....",
            ".....y.DMMMMMrMMMMMMMD...",
            ".....yDMMMMMMrrMMMMMMMD..",
            "wwwwwyMMMMMMMrMMMMMMMMMD.",
            "wwwwwyMMMMMMMMMMMMMMMMMMD",
            ".....yMMMMrMMMMMMMMMMMMMD",
            ".....yMMMMMMMMMMMMMMMMMMD",
            ".....yMMMMMMMMMMMMMMMMMMD",
            ".....yLLLLLLLLL.LLLLLLLLL",
            ".........................",
        ],
    },
    clips: { "held": (frames: ["blade"], fps: 1) },
    anchors: { "grip": { "blade": (2, 4) } },
)
