// A cave scorpion's sting, pointing right: a swollen bulb and a hooked
// barb. `grip` is where it joins its tail (the chain's last link).
(
    size: (11, 8),
    feet: (1, 7),
    outline: (22, 16, 12),
    palette: {
        'S': (110, 66, 38),   // bulb
        'L': (168, 110, 60),   // bulb, lit
        's': (36, 22, 14),   // barb
        'w': (84, 54, 34),   // joint
    },
    frames: {
        "body": [
            "...........",
            "....SSS....",
            "..SSLLSS...",
            ".wSLLLLSSs.",
            "..SSLLSs...",
            "....SSsss..",
            ".......ss..",
            "...........",
        ],
    },
    clips: {
        "idle": (frames: ["body"], fps: 1),
    },
    anchors: { "grip": { "body": (1, 3) } },
)
