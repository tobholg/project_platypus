// An axe held in the hand, the handle pointing right from the grip, the
// blade below its end (the edge leads the swing down). Drawn in its icon's
// colours.
(
    size: (25, 13),
    feet: (13, 13),
    outline: (24, 18, 16),
    palette: {
        'M': (236, 160, 90),   // head, lit (copper; each tier its icon's)
        'm': (205, 127, 50),   // head
        'd': (150, 86, 34),   // head, shaded
        'h': (150, 100, 56),   // handle
        'H': (104, 66, 36),   // handle, shaded
    },
    frames: {
        "axe": [
            "...................mMMMm.",
            "hhhhhHhhhhhhhHhhhhhdmmmmM",
            "HHHHHHHHHHHHHHHHHHHdmmmmd",
            "...................ddmmd.",
            "....................dmmd.",
            "....................dmd..",
            "....................dmd..",
            "...................dmmd..",
            ".................ddmmmd..",
            "...............MMmmmmmmd.",
            "..............MMmmmmmmmmd",
            ".............MMmmmmmmmmmd",
            "..............MMMMMMMMMd.",
        ],
    },
    clips: { "held": (frames: ["axe"], fps: 1) },
    anchors: { "grip": { "axe": (3, 2) } },
)
