        'H': (28, 24, 22),      // topknot, shade
        's': (112, 150, 72),    // skin
        'S': (82, 114, 52),     // skin, shade
        'K': (60, 84, 38),      // brow
        'k': (214, 50, 36),     // eye
        'w': (236, 226, 196),   // tusk
        'D': (40, 30, 26),      // mouth
        't': (126, 90, 58),     // leather
        'T': (96, 66, 42),      // leather, shade
        'b': (62, 46, 36),      // belt
        'y': (222, 212, 180),   // a bone on it
        'p': (80, 74, 62),      // breeches
        'q': (62, 58, 50),      // breeches, the far leg
        'B': (54, 42, 34),      // boots
        'C': (42, 32, 26),      // boots, the far foot
