            "..Sssllssss...",
            ".SSssssssssss.",
            ".SSsssKKKKKKs.",
            "SSSsssssKKKss.",
            "sSSsssssssslss",
            ".SSssssssssss.",
            ".SSSsssssDDDD.",
            "..SSsssssswsD.",
            "...SSssssww...",
