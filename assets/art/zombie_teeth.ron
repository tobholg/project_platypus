    size: (6, 4),
    feet: (3, 4),
    outline: (24, 20, 18),
    palette: {
        't': (208, 196, 160),   // teeth
    },
    frames: {
        "zombie_teeth": [
            "t.t.t.",
            "tttttt",
            "tttttt",
            ".t.t.t",
        ],
    },
    clips: { "held": (frames: ["zombie_teeth"], fps: 1) },
    anchors: { "grip": { "zombie_teeth": (0, 1) } },
)
