// The drowned: the dead the lakes kept, walking the beds of the flooded
// caverns. A zombie's rig (assets/art/zombie.ron), waterlogged: grey-green
// skin, weed in its hair and down its shirt, an eye that glows pale in the
// dark water. Facing right; the game mirrors it.
(
    size: (48, 48),
    feet: (21.5, 48),
    outline: (24, 18, 20),
    palette: {
        'g': (168, 190, 182),   // skin, lit: waterlogged, grey-green
        'G': (134, 158, 152),   // skin
        'D': (92, 116, 114),    // skin, shade
        'v': (70, 104, 88),     // veins, weed-dark
        'k': (18, 30, 30),      // sockets, mouth
        'e': (170, 240, 230),   // its eye: a pale glow
        'x': (52, 92, 60),      // slime and weed (round its mouth, down its shirt)
        'h': (30, 56, 40),      // hair: lank weed
        'c': (88, 110, 124),    // the shirt, faded and sodden
        'C': (62, 80, 96),      // the shirt, shade
        'b': (40, 44, 40),      // a belt
        'p': (44, 56, 62),      // trousers, at the hips
    },
    parts: {
        // Its mouth (where it bites from, its arms gone).
        "head": (points: { "mouth": (6, 11) }, rows: [
            "..h..hhhh...",
            ".hhhhhhhhhh.",
            "hhhhGggggghh",
            "hhhGgggvggg.",
            "hhGgggggggg.",
            "hGggggkkggg.",
            "GGgggkekggg.",
            "GGggggkgggg.",
            ".GGggggvggg.",
            "..GGggggggG.",
            "..GGgkkkkkG.",
            "..Gxkxkxkx..",
            "...GxGxGx...",
        ]),
        "blink": (points: { "mouth": (6, 11) }, rows: [
            "..h..hhhh...",
            ".hhhhhhhhhh.",
            "hhhhGggggghh",
            "hhhGgggvggg.",
            "hhGgggggggg.",
            "hGggggggggg.",
            "GGgggkkkggg.",
            "GGggggggggg.",
            ".GGggggvggg.",
            "..GGggggggG.",
            "..GGgkkkkkG.",
            "..Gxkxkxkx..",
            "...GxGxGx...",
        ]),
        // Hunched in a torn shirt, blood down its front, its skin showing
        // through the tears; a belt and its trousers' top (the legs hang
        // from its two lower corners).
        "torso": (rows: [
            "....GggG...",
            ".cccxggxcc.",
            "ccccxxxcCCC",
            "ccgccxccCCC",
            "cgvgccxcCCC",
            "ccgcccxcCCC",
            "ccgcccxcCCC",
            "ccccccxcCCC",
            ".cccccgccC.",
            ".cccccccCC.",
            ".ccccgDgCC.",
            ".cccccccCC.",
            ".cccccccCC.",
            ".bbbbbbbbb.",
            ".ppppppppp.",
            ".ppp...ppp.",
        ]),
        // Arms hang from the shoulder (pivot), long, grey-green and thin; the
        // hand is where a claw goes.
        "arm": (pivot: (0, 0), points: { "hand": (0, 15) }, rows: [
            "GgG",
            "Gg.",
            "Gg.",
            "Gg.",
            "Gg.",
            "Gg.",
            "GgG",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "GGG",
            "G.G",
        ]),
        "arm_fwd": (pivot: (0, 0), points: { "hand": (7, 11) }, rows: [
            "GgG......",
            ".Gg......",
            ".Gg......",
            "..Gg.....",
            "..Gg.....",
            "..GgG....",
            "...DG....",
            "....DG...",
            "....DG...",
            ".....DG..",
            ".....DG..",
            "......GGG",
            ".......GG",
        ]),
        "arm_back": (pivot: (8, 0), points: { "hand": (1, 11) }, rows: [
            "......GgG",
            "......Gg.",
            "......Gg.",
            ".....Gg..",
            ".....Gg..",
            "....GgG..",
            "....DG...",
            "...DG....",
            "...DG....",
            "..DG.....",
            ".DG......",
            "GGG......",
            "G.G......",
        ]),
        "arm_up": (pivot: (0, 17), points: { "hand": (6, 1) }, rows: [
            ".....G.G",
            ".....GGG",
            ".....DG.",
            ".....DG.",
            "....DG..",
            "....DG..",
            "....DG..",
            "....DG..",
            "...DG...",
            "...DG...",
            "...GgG..",
            "..Gg....",
            "..Gg....",
            ".Gg.....",
            ".Gg.....",
            "Gg......",
            "Gg......",
            "GgG.....",
        ]),
        // Reaching up and forward (a jump; a hand on a wall).
        "arm_reach": (pivot: (0, 12), points: { "hand": (11, 1) }, rows: [
            "..........G.G",
            "..........GGG",
            ".........DGG.",
            "........DG...",
            ".......DG....",
            "......DG.....",
            ".....DG......",
            "....GgG......",
            "...Gg........",
            "..Gg.........",
            "..Gg.........",
            ".Gg..........",
            "GgG..........",
        ]),
        // Thrown forward and up (a jump).
        "arm_lift": (pivot: (0, 7), points: { "hand": (12, 1) }, rows: [
            "...........G.G",
            "..........GGGG",
            ".........DG...",
            "........DG....",
            ".......DG.....",
            "......GgG.....",
            "...GgGg.......",
            "GgGg..........",
        ]),
        // The front arm pointing where it aims (swings, casting): at angles
        // from straight down to straight up (the fan below).
        "aimm90": (pivot: (2, 0), points: { "hand": (1, 15) }, rows: [
            "GgG",
            "Gg.",
            "Gg.",
            "Gg.",
            "Gg.",
            "Gg.",
            "GgG",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "GGG",
            "DG.",
            "G.G",
        ]),
        "aimm60": (pivot: (1, 0), points: { "hand": (5, 12) }, rows: [
            "Gg......",
            ".Gg.....",
            ".Gg.....",
            ".Gg.....",
            "..Gg....",
            "..GgG...",
            "..DG....",
            "...DG...",
            "...DG...",
            "...DG...",
            "....DG..",
            "....DGG.",
            "....GGG.",
            "....G.G.",
        ]),
        "aimm30": (pivot: (1, 0), points: { "hand": (14, 9) }, rows: [
            ".gg..............",
            "..Gg.............",
            "...Gg............",
            "....Gg...........",
            ".....Gg..........",
            ".....GgGG........",
            "......DDGG.......",
            "........DDGG.....",
            "..........DDGG...",
            "............DGGG.",
            ".............G.G.",
        ]),
        "aim0": (pivot: (0, 0), points: { "hand": (15, 1) }, rows: [
            "GggggggG......G.G",
            "GGGGGGGGGGGGGGGG.",
            "........DDDDDDGGG",
        ]),
        "aim30": (pivot: (0, 8), points: { "hand": (12, 1) }, rows: [
            "...........G.G",
            "..........GGG.",
            ".........GDD..",
            "........GD....",
            "......GGD.....",
            "....ggGG......",
            "..GgGG........",
            ".GgG..........",
            "GgG...........",
            "DD............",
        ]),
        "aim60": (pivot: (0, 14), points: { "hand": (7, 1) }, rows: [
            "......G.G",
            "......GGG",
            "......DG.",
            "......DG.",
            ".....DG..",
            ".....DG..",
            "....DG...",
            "....DG...",
            "...GgG...",
            "...Gg....",
            "..Gg.....",
            "..Gg.....",
            ".Gg......",
            ".Gg......",
            "Gg.......",
            "DG.......",
        ]),
        "aim90": (pivot: (2, 16), points: { "hand": (1, 0) }, rows: [
            "G.G",
            "GGG",
            ".DG",
            ".DG",
            ".DG",
            ".DG",
            ".DG",
            ".DG",
            ".DG",
            "GgG",
            ".Gg",
            ".Gg",
            ".Gg",
            ".Gg",
            ".Gg",
            ".Gg",
            "GgG",
        ]),
    },
    poses: {
        // Standing, both arms held out ahead (down a little); breathing in
        // (the chest and head a pixel up); a blink.
        "stand": [
            (part: "aimm30", at: (17, 19), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "head", at: (15, 5)),
            (part: "aimm30", at: (24, 19), outline: true, tag: "front_arm"),
        ],
        "breathe": [
            (part: "aimm30", at: (17, 18), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 16)),
            (part: "head", at: (15, 4)),
            (part: "aimm30", at: (24, 18), outline: true, tag: "front_arm"),
        ],
        "blink": [
            (part: "aimm30", at: (17, 19), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "blink", at: (15, 5)),
            (part: "aimm30", at: (24, 19), outline: true, tag: "front_arm"),
        ],
        // Shambling: the arms out ahead, one lifting as the other drops,
        // against the legs' stride (the legs are its creature file's); a
        // bob on the passing steps.
        "run_a": [
            (part: "aim0", at: (17, 19), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "head", at: (15, 5)),
            (part: "aimm30", at: (24, 19), outline: true, tag: "front_arm"),
        ],
        "run_b": [
            (part: "aimm30", at: (17, 18), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 16)),
            (part: "head", at: (15, 4)),
            (part: "aimm30", at: (24, 18), outline: true, tag: "front_arm"),
        ],
        "run_c": [
            (part: "aimm30", at: (17, 19), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "head", at: (15, 5)),
            (part: "aim0", at: (25, 19), outline: true, tag: "front_arm"),
        ],
        "run_d": [
            (part: "aimm30", at: (17, 18), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 16)),
            (part: "head", at: (15, 4)),
            (part: "aimm30", at: (24, 18), outline: true, tag: "front_arm"),
        ],
        // Reaching for you (the grab's tell): both arms up and out, its
        // head thrown back. Lunging: leaning in, arms straight out. Biting:
        // its head down and in, at what it holds.
        // Coming up out of the ground: both arms straight up over its
        // head, reaching (they break the surface first).
        "climb": [
            (part: "arm_up", at: (17, 21), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 19)),
            (part: "head", at: (15, 7)),
            (part: "arm_up", at: (23, 21), outline: true, tag: "front_arm"),
        ],
        "tell": [
            (part: "aim60", at: (17, 19), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "head", at: (14, 4)),
            (part: "aim60", at: (25, 19), outline: true, tag: "front_arm"),
        ],
        "lunge": [
            (part: "aim0", at: (20, 20), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (19, 18)),
            (part: "head", at: (19, 6)),
            (part: "aim0", at: (27, 20), outline: true, tag: "front_arm"),
        ],
        "bite": [
            (part: "aim0", at: (20, 20), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (19, 18)),
            (part: "head", at: (21, 8)),
            (part: "aim0", at: (27, 20), outline: true, tag: "front_arm"),
        ],
        // Rising: an arm thrown up. Falling: arms out.
        "rise": [
            (part: "arm", at: (17, 18), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "head", at: (15, 5)),
            (part: "arm_lift", at: (25, 19), outline: true, tag: "front_arm"),
        ],
        "drop": [
            (part: "arm_up", at: (17, 19), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "head", at: (15, 5)),
            (part: "arm_fwd", at: (25, 19), outline: true, tag: "front_arm"),
        ],
        // Dashing: leaning in, arms back.
        "dash": [
            (part: "arm_back", at: (19, 20), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (19, 18)),
            (part: "head", at: (19, 7)),
            (part: "arm_back", at: (27, 20), outline: true, tag: "front_arm"),
        ],
        // Sliding down a wall (on the right): a hand on it.
        "wall": [
            (part: "arm", at: (17, 19), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "head", at: (15, 5)),
            (part: "arm_reach", at: (25, 19), outline: true, tag: "front_arm"),
        ],
    },
    // The front arm at angles: shown instead of the pose's own front arm
    // (tagged `front_arm`) while aiming. (The back arm is tagged too: its
    // hand, `back_arm.hand`, holds a torch.)
    fans: {
        "front_arm": [
            (angle: -90, part: "aimm90"),
            (angle: -60, part: "aimm60"),
            (angle: -30, part: "aimm30"),
            (angle: 0, part: "aim0"),
            (angle: 30, part: "aim30"),
            (angle: 60, part: "aim60"),
            (angle: 90, part: "aim90"),
        ],
    },
    derived: {
        // Hit: knocked back a pixel.
        "hurt": (from: "drop", shift: (-1, 0)),
    },
    clips: {
        "idle": (frames: ["stand", "stand", "breathe", "breathe", "stand", "stand", "breathe", "breathe", "stand", "blink", "stand", "breathe", "breathe"], fps: 5),
        "run": (frames: ["run_a", "run_b", "run_c", "run_d"], fps: 6),
        "jump": (frames: ["rise"], fps: 5),
        "fall": (frames: ["drop"], fps: 5),
        "dash": (frames: ["dash"], fps: 5),
        "wall": (frames: ["wall"], fps: 5),
        "hurt": (frames: ["hurt"], fps: 5),
        "tell": (frames: ["tell"], fps: 5),
        "climb": (frames: ["climb"], fps: 5),
        "lunge": (frames: ["lunge"], fps: 5),
        "bite": (frames: ["lunge", "bite", "bite", "lunge"], fps: 6),
    },
)
