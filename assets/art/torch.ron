// A torch, held: a pitch-soaked head on a stick, sized to the hand (planted
// in the world it's torch_planted.ron, sized to the blocks). The game lights
// it: flames, a wisp of smoke and the odd ember rise from `flame`; it's
// gripped at `grip` (in the back hand, `back_arm.hand`).
(
    size: (6, 18),
    feet: (3, 18),
    outline: (24, 18, 14),
    palette: {
        'p': (52, 34, 26),      // pitch, charred
        'P': (88, 54, 32),      // the wrap
        'Q': (126, 82, 46),     // the wrap, lit
        'e': (240, 150, 60),    // embers in it
        'w': (132, 92, 54),     // the stick
        'W': (98, 66, 38),      // the stick, shaded
    },
    frames: {
        "torch": [
            "..ee..",
            ".peep.",
            "pppepp",
            "ppeppp",
            "pPPPQP",
            "pppppp",
            "pPPPQP",
            ".pPPQ.",
            "..Ww..",
            "..Ww..",
            "..Ww..",
            "..Ww..",
            "..WW..",
            "..Ww..",
            "..Ww..",
            "..Ww..",
            "..Ww..",
            "..WW..",
        ],
    },
    clips: { "lit": (frames: ["torch"], fps: 1) },
    anchors: { "flame": { "torch": (2, 0) }, "grip": { "torch": (2, 11) } },
)
