// A star wisp: a small white-blue star, its points flickering.
(
    size: (15, 15),
    feet: (7.5, 15),
    outline: (30, 34, 70),
    palette: {
        'c': (255, 255, 255),   // the heart
        'B': (216, 228, 255),   // the glow, near the heart
        'b': (176, 200, 255),   // the glow
        'd': (96, 120, 220),    // the points
    },
    frames: {
        "up": [
            "...............",
            ".......d.......",
            ".......d.......",
            "...d..bbb..d...",
            "....bbbbbbb....",
            "....bbBBBbb....",
            "...bbBBcBBbb...",
            ".ddbbBcccBbbdd.",
            "...bbBBcBBbb...",
            "....bbBBBbb....",
            "....bbbbbbb....",
            "...d..bbb..d...",
            ".......d.......",
            ".......d.......",
            "...............",
        ],
        "down": [
            "...............",
            "...............",
            "..d....b....d..",
            "...d.bbbbb.d...",
            "....bbbBbbb....",
            "...bbbBcBbbb...",
            "...bbBcccBbb...",
            "..bbBcccccBbb..",
            "...bbBcccBbb...",
            "...bbbBcBbbb...",
            "....bbbBbbb....",
            "...d.bbbbb.d...",
            "..d....b....d..",
            "...............",
            "...............",
        ],
    },
    clips: {
        "idle": (frames: ["up", "down"], fps: 8),
        "run": (frames: ["up", "down"], fps: 8),
        "jump": (frames: ["up", "down"], fps: 8),
        "fall": (frames: ["up", "down"], fps: 8),
    },
)
