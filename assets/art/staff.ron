            "............................mgwgGG.",
            "hhhHhhhhHhhhhHhhhhHhhhhHhhhhmggGGG.",
            "HHHHHHHHHHHHHHHHHHHHHHHHHHHHmgGGGG.",
            "............................mGGGGG.",
            ".............................mGGGm.",
            "..........................s...mmm..",
        ],
    },
    clips: { "held": (frames: ["staff"], fps: 1) },
