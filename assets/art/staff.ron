    outline: (24, 18, 16),
    palette: {
        'h': (150, 100, 56),   // handle
        'H': (104, 66, 36),   // handle, shaded
        'g': (200, 225, 255),   // gem, lit
        'G': (110, 150, 255),   // gem
        'w': (255, 255, 255),   // glint
        's': (200, 225, 255),   // sparkle
        'm': (160, 160, 170),   // the band
    },
    frames: {
        "staff": [
            "..........................s...mmm..",
