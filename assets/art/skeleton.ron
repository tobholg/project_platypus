// A skeleton, lanky: a skull on a long neck, a narrow ribcage on a long
// spine, long thin arms (every pose and aim drawn longer). Its legs aren't
// drawn here: they're its creature file's `legs` (legs.rs, `rig`: two
// long bone legs stepping on whatever's under them, from its pelvis, 18
// cells up: its upper body sits high in the frame for them). Facing
// right; the game mirrors it.
(
    size: (36, 44),
    feet: (17.5, 44),
    outline: (26, 20, 20),
    palette: {
        'j': (238, 234, 218),   // skull, lit
        'L': (232, 228, 212),   // bone, lit
        'U': (144, 138, 122),   // ankles
        'o': (86, 80, 72),      // the undersides of the feet
        'h': (218, 212, 194),   // skull
        'H': (172, 166, 150),   // skull, shade
        's': (214, 208, 190),   // bone
        'S': (168, 162, 146),   // bone, shade
        'k': (34, 26, 28),      // sockets, gaps
        't': (204, 198, 180),   // bone (the upper arm, ribs)
        'T': (156, 150, 136),   // ribs, shade
        'b': (62, 52, 50),      // the dark round the spine (under a belt)
        'y': (150, 144, 130),   // the pelvis
        'p': (194, 188, 172),   // leg bones
        'q': (150, 144, 130),   // leg bones, the far one
        'B': (124, 118, 104),   // feet
        'C': (100, 94, 84),     // feet, the far one
    },
    parts: {
        "head": (rows: [
            "...hhhhhh...",
            ".hhjjjjhhh..",
            "hhjjhhhhhhh.",
            "hhhhhhhhhhhh",
            "HHhhhhkkkhhh",
            "HHhhhkkkkhhh",
            "HHhhhkkkkhkh",
            ".HHhhhkkkhkh",
            "..HHhhhhhhh.",
            "...hkhkhkh..",
            "...HHhhhH...",
        ]),
        "blink": (rows: [
            "...hhhhhh...",
            ".hhjjjjhhh..",
            "hhjjhhhhhhh.",
            "hhhhhhhhhhhh",
            "HHhhhhkkkhhh",
            "HHhhhkkkkhhh",
            "HHhhhkkkkhkh",
            ".HHhhhkkkhkh",
            "..HHhhhhhhh.",
            "...hkhkhkh..",
            "...HHhhhH...",
        ]),
        // A narrow ribcage on a long spine, the pelvis at its foot (the
        // legs hang from its two lower corners).
        "torso": (rows: [
            "...tL....",
            "...tL....",
            ".tTtLLtt.",
            "Tk.tL.kkt",
            ".TTtLLtT.",
            "Tk.tL.kkt",
            ".TTtLLtT.",
            "..ktLk...",
            "...tL....",
            "...tL....",
            "..Tbbb...",
            ".yyyyyyy.",
            ".yy...yy.",
        ]),
        // Arms hang from the shoulder (pivot), long; the hand is where a weapon goes.
        "arm": (pivot: (0, 0), points: { "hand": (0, 12) }, rows: [
            "tLt",
            "tL.",
            "tL.",
            "tL.",
            "tL.",
            "tLt",
            "Ss.",
            "Ss.",
            "Ss.",
            "Ss.",
            "Ss.",
            "Ss.",
            "sss",
            "s.s",
        ]),
        "arm_fwd": (pivot: (0, 0), points: { "hand": (6, 9) }, rows: [
            "tLt.....",
            ".tL.....",
            ".tL.....",
            "..tL....",
            "..tLt...",
            "...Ss...",
            "....Ss..",
            "....Ss..",
            ".....Ss.",
            ".....sss",
            "......ss",
        ]),
        "arm_back": (pivot: (7, 0), points: { "hand": (1, 9) }, rows: [
            ".....tLt",
            ".....tL.",
            ".....tL.",
            "....tL..",
            "...tLt..",
            "...Ss...",
            "..Ss....",
            "..Ss....",
            ".Ss.....",
            "sss.....",
            "s.s.....",
        ]),
        "arm_up": (pivot: (0, 14), points: { "hand": (5, 1) }, rows: [
            "....s.s",
            "....sss",
            "....Ss.",
            "....Ss.",
            "...Ss..",
            "...Ss..",
            "...Ss..",
            "...Ss..",
            "..tLt..",
            "..tL...",
            ".tL....",
            ".tL....",
            "tL.....",
            "tL.....",
            "tLt....",
        ]),
        // Reaching up and forward (a jump; a hand on a wall).
        "arm_reach": (pivot: (0, 10), points: { "hand": (9, 1) }, rows: [
            "........s.s",
            "........sss",
            ".......Sss.",
            "......Ss...",
            ".....Ss....",
            "....Ss.....",
            "...tLt.....",
            "..tL.......",
            ".tL........",
            ".tL........",
            "tLt........",
        ]),
        // Thrown forward and up (a jump).
        "arm_lift": (pivot: (0, 6), points: { "hand": (10, 1) }, rows: [
            ".........s.s",
            "........ssss",
            ".......Ss...",
            "......Ss....",
            "....tLs.....",
            "..tLtL......",
            "tLtL........",
        ]),
        // The front arm pointing where it aims (swings, casting): at angles
        // from straight down to straight up (the fan below).
        "aimm90": (pivot: (2, 0), points: { "hand": (1, 12) }, rows: [
            "tLt",
            "tL.",
            "tL.",
            "tL.",
            "tL.",
            "tLt",
            "Ss.",
            "Ss.",
            "Ss.",
            "Ss.",
            "Ss.",
            "sss",
            "Ss.",
            "s.s",
        ]),
        "aimm60": (pivot: (1, 0), points: { "hand": (5, 10) }, rows: [
            "tL.....",
            ".tL....",
            ".tL....",
            ".tL....",
            "..tLt..",
            "..Ss...",
            "...Ss..",
            "...Ss..",
            "...Ss..",
            "....Sss",
            "....sss",
            "....s.s",
        ]),
        "aimm30": (pivot: (1, 0), points: { "hand": (11, 7) }, rows: [
            ".LL...........",
            "..tL..........",
            "...tL.........",
            "....tL........",
            "....tLts......",
            ".....SSss.....",
            ".......SSss...",
            ".........Ssss.",
            "..........s.s.",
        ]),
        "aim0": (pivot: (0, 0), points: { "hand": (12, 1) }, rows: [
            "tLLLLLt....s.s",
            "tttttttssssss.",
            ".......SSSSsss",
        ]),
        "aim30": (pivot: (0, 6), points: { "hand": (10, 1) }, rows: [
            ".........s.s",
            "........sss.",
            ".......sSS..",
            ".....ssS....",
            "...LLts.....",
            ".tLtt.......",
            "tLt.........",
            "TT..........",
        ]),
        "aim60": (pivot: (0, 11), points: { "hand": (6, 1) }, rows: [
            ".....s.s",
            ".....sss",
            ".....Ss.",
            ".....Ss.",
            "....Ss..",
            "....Ss..",
            "...Ss...",
            "...tLt..",
            "..tL....",
            "..tL....",
            ".tL.....",
            "tL......",
            "Tt......",
        ]),
        "aim90": (pivot: (2, 13), points: { "hand": (1, 0) }, rows: [
            "s.s",
            "sss",
            ".Ss",
            ".Ss",
            ".Ss",
            ".Ss",
            ".Ss",
            ".Ss",
            "tLt",
            ".tL",
            ".tL",
            ".tL",
            ".tL",
            "tLt",
        ]),
    },
    poses: {
        // Standing; breathing in (the chest and head a pixel up); a blink.
        "stand": [
            (part: "arm", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (11, 3)),
            (part: "arm", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        "breathe": [
            (part: "arm", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 13)),
            (part: "head", at: (11, 2)),
            (part: "arm", at: (20, 15), outline: true, tag: "front_arm"),
        ],
        "blink": [
            (part: "arm", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "blink", at: (11, 3)),
            (part: "arm", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        // Running: arms swinging against the legs' stride (the legs are
        // its creature file's), a bob on the passing steps.
        "run_a": [
            (part: "arm_fwd", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (11, 3)),
            (part: "arm_back", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        "run_b": [
            (part: "arm", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 13)),
            (part: "head", at: (11, 2)),
            (part: "arm", at: (20, 15), outline: true, tag: "front_arm"),
        ],
        "run_c": [
            (part: "arm_back", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (11, 3)),
            (part: "arm_fwd", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        "run_d": [
            (part: "arm", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 13)),
            (part: "head", at: (11, 2)),
            (part: "arm", at: (20, 15), outline: true, tag: "front_arm"),
        ],
        // Rising: an arm thrown up. Falling: arms out.
        "rise": [
            (part: "arm", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (11, 3)),
            (part: "arm_lift", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        "drop": [
            (part: "arm_up", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (11, 3)),
            (part: "arm_fwd", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        // Dashing: leaning in, arms back.
        "dash": [
            (part: "arm_back", at: (16, 17), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (15, 15)),
            (part: "head", at: (14, 5)),
            (part: "arm_back", at: (22, 17), outline: true, tag: "front_arm"),
        ],
        // Sliding down a wall (on the right): a hand on it.
        "wall": [
            (part: "arm", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (11, 3)),
            (part: "arm_reach", at: (20, 16), outline: true, tag: "front_arm"),
        ],
    },
    // The front arm at angles: shown instead of the pose's own front arm
    // (tagged `front_arm`) while aiming. (The back arm is tagged too: its
    // hand, `back_arm.hand`, holds a torch.)
    fans: {
        "front_arm": [
            (angle: -90, part: "aimm90"),
            (angle: -60, part: "aimm60"),
            (angle: -30, part: "aimm30"),
            (angle: 0, part: "aim0"),
            (angle: 30, part: "aim30"),
            (angle: 60, part: "aim60"),
            (angle: 90, part: "aim90"),
        ],
    },
    derived: {
        // Hit: knocked back a pixel.
        "hurt": (from: "drop", shift: (-1, 0)),
    },
    clips: {
        "idle": (frames: ["stand", "stand", "breathe", "breathe", "stand", "stand", "breathe", "breathe", "stand", "blink", "stand", "breathe", "breathe"], fps: 5),
        "run": (frames: ["run_a", "run_b", "run_c", "run_d"], fps: 11),
        "jump": (frames: ["rise"], fps: 5),
        "fall": (frames: ["drop"], fps: 5),
        "dash": (frames: ["dash"], fps: 5),
        "wall": (frames: ["wall"], fps: 5),
        "hurt": (frames: ["hurt"], fps: 5),
    },
)
