        // Rising: knees up, an arm thrown up. Falling: legs down, arms out.
        "rise": [
            (part: "arm", at: (14, 17), shade: 0.72, tag: "back_arm"),
            (part: "tuck", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm_lift", at: (20, 21), outline: true, tag: "front_arm"),
        ],
        "drop": [
            (part: "arm_up", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "dangle", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm_fwd", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        // Dashing: leaning in, arms back.
        "dash": [
            (part: "arm_back", at: (14, 20), shade: 0.72, tag: "back_arm"),
            (part: "run1", at: (9, 26)),
            (part: "torso", at: (14, 18)),
            (part: "head", at: (15, 9)),
            (part: "arm_back", at: (17, 20), outline: true, tag: "front_arm"),
        ],
        // Sliding down a wall (on the right): a hand on it.
        "wall": [
