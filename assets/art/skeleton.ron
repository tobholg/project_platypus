        "run_d": [
            (part: "arm", at: (14, 17), shade: 0.72, tag: "back_arm"),
            (part: "run3", at: (11, 24)),
            (part: "torso", at: (12, 15)),
            (part: "head", at: (12, 5)),
            (part: "arm", at: (18, 17), outline: true, tag: "front_arm"),
