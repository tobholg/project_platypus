    poses: {
        // Standing; breathing in (the chest and head a pixel up); a blink.
        "stand": [
            (part: "arm", at: (17, 19), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 17)),
            (part: "head", at: (14, 4)),
            (part: "arm", at: (25, 19), outline: true, tag: "front_arm"),
