            "....qq..pp....",
            ".....qq..pp...",
            ".....qq.pppp..",
            "......qq.pp...",
            ".....CCC.pp...",
            ".....ooo.pp...",
            ".........UU...",
            ".........BB...",
            ".........BBB..",
            ".........oooo.",
        ]),
        "run3": (points: { "foot_near": (8, 10), "foot_far": (3, 6) }, rows: [
            "....qq.pp.....",
            "....qq..pp....",
            "....qq..pp....",
            "...qqq.pppp...",
            "....qq..pp....",
            "...CCo..pp....",
            "...oo...pp....",
            "........UU....",
            "........BB....",
            "........BBB...",
            ".......oooo...",
        ]),
        "run4": (points: { "foot_near": (0, 10), "foot_far": (11, 10) }, rows: [
            "...pp..qq.....",
            "...pp...qq....",
            "..pp.....qq...",
            ".pppp....qqq..",
            ".pp.......qq..",
            "pp........qq..",
            "pp........qq..",
            "UU........CC..",
            "BB........CC..",
            "Bo........CCC.",
            "o.........oooo",
        ]),
        "tuck": (points: { "foot_near": (9, 8), "foot_far": (4, 8) }, rows: [
