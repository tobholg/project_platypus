        "run_a": [
            (part: "arm_fwd", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "run1", at: (11, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm_back", at: (18, 18), outline: true, tag: "front_arm"),
