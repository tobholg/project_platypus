        "breathe": [
            (part: "arm", at: (17, 18), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (16, 16)),
            (part: "head", at: (14, 3)),
            (part: "arm", at: (25, 18), outline: true, tag: "front_arm"),
