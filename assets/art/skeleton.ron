    poses: {
        // Standing; breathing in (the chest and head a pixel up); a blink.
        "stand": [
            (part: "arm", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "legs", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "head", at: (12, 6)),
            (part: "arm", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        "breathe": [
            (part: "arm", at: (14, 17), shade: 0.72, tag: "back_arm"),
            (part: "legs", at: (12, 26)),
            (part: "torso", at: (12, 15)),
            (part: "head", at: (12, 5)),
            (part: "arm", at: (18, 17), outline: true, tag: "front_arm"),
        ],
        "blink": [
            (part: "arm", at: (14, 18), shade: 0.72, tag: "back_arm"),
            (part: "legs", at: (12, 26)),
            (part: "torso", at: (12, 17)),
            (part: "blink", at: (12, 6)),
            (part: "arm", at: (18, 18), outline: true, tag: "front_arm"),
        ],
        // Running: legs through the stride, arms swinging against them, a
