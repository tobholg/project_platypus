        "aimm30": (pivot: (1, 0), points: { "hand": (8, 5) }, rows: [
            ".LL.......",
            "..tL......",
            "...tL.....",
            "...tLts...",
            "....SSss..",
            "......Ssss",
            ".......s.s",
