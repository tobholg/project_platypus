// A skeleton, drawn on the humanoid rig (the player's parts and poses,
// crates/art): bone, dark eye sockets, a grin, a ribcage.
// Facing right; the game mirrors it.
(
    size: (36, 38),
    feet: (17.5, 38),
    outline: (26, 20, 20),
    palette: {
        'j': (238, 234, 218),   // skull, lit
        'L': (232, 228, 212),   // bone, lit
        'U': (144, 138, 122),   // ankles
        'o': (86, 80, 72),      // the undersides of the feet
        'h': (218, 212, 194),   // skull
        'H': (172, 166, 150),   // skull, shade
        's': (214, 208, 190),   // bone
        'S': (168, 162, 146),   // bone, shade
        'k': (34, 26, 28),      // sockets, gaps
        't': (204, 198, 180),   // bone (the upper arm, ribs)
        'T': (156, 150, 136),   // ribs, shade
        'b': (62, 52, 50),      // the dark round the spine (under a belt)
        'y': (150, 144, 130),   // the pelvis
        'p': (194, 188, 172),   // leg bones
        'q': (150, 144, 130),   // leg bones, the far one
        'B': (124, 118, 104),   // feet
        'C': (100, 94, 84),     // feet, the far one
    },
    parts: {
        "head": (rows: [
            "...hhhhhh...",
            ".hhjjjjhhh..",
            "hhjjhhhhhhh.",
            "hhhhhhhhhhhh",
            "HHhhhhkkkhhh",
            "HHhhhkkkkhhh",
            "HHhhhkkkkhkh",
            ".HHhhhkkkhkh",
            "..HHhhhhhhh.",
            "...hkhkhkh..",
            "...HHhhhH...",
        ]),
        "blink": (rows: [
            "...hhhhhh...",
            ".hhjjjjhhh..",
            "hhjjhhhhhhh.",
            "hhhhhhhhhhhh",
            "HHhhhhkkkhhh",
            "HHhhhkkkkhhh",
            "HHhhhkkkkhkh",
            ".HHhhhkkkhkh",
            "..HHhhhhhhh.",
            "...hkhkhkh..",
            "...HHhhhH...",
        ]),
        "torso": (rows: [
            "..TTttLt...",
            ".TTtLLLLt..",
            "TTkkkkkkkt.",
            "TTttLLLLt..",
            "TTkkkkkkt..",
            ".TTtLLLt...",
            "..Tbbbbb...",
            ".yyyyyyyy..",
            ".yyy..yyy..",
        ]),
        // Arms hang from the shoulder (pivot); the hand is where a weapon goes.
        "arm": (pivot: (0, 0), points: { "hand": (0, 8) }, rows: [
            "tLt",
            "tL.",
            "tL.",
            "tL.",
            "tLt",
            "Ss.",
            "Ss.",
            "sss",
            "s.s",
        ]),
        "arm_fwd": (pivot: (0, 0), points: { "hand": (5, 6) }, rows: [
            "tLt...",
            ".tL...",
            "..tL..",
            "..tLt.",
            "...Ss.",
            "...Ss.",
            "...sss",
            "....ss",
        ]),
        "arm_back": (pivot: (3, 0), points: { "hand": (0, 6) }, rows: [
            "...tLt",
            "...tL.",
            "..tL..",
            ".tLt..",
            ".Ss...",
            "Ss....",
            "sss...",
            "s.s...",
        ]),
        "arm_up": (pivot: (0, 12), points: { "hand": (4, 1) }, rows: [
            "....s.",
            "...s.s",
            "...sss",
            "...Ss.",
            "...Ss.",
            "..Ss..",
            "..Ss..",
            "..tLt.",
            ".tL...",
            ".tL...",
            "tL....",
            "tL....",
            "tLt...",
        ]),
        // Reaching up and forward (a jump; a hand on a wall).
        "arm_reach": (pivot: (0, 8), points: { "hand": (7, 1) }, rows: [
            "......s.s",
            "......sss",
            ".....Sss.",
            ".....Ss..",
            "....Ss...",
            "...tLt...",
            "..tL.....",
            ".tL......",
            "tLt......",
        ]),
        // Thrown forward and up (a jump).
        "arm_lift": (pivot: (0, 5), points: { "hand": (7, 1) }, rows: [
            "......s.s",
            ".....ssss",
            ".....Ss..",
            "...tLs...",
            "tLtL.....",
            "tLt......",
        ]),
        // The front arm pointing where it aims (casting, later weapons): at
        // angles from straight down to straight up (the fan below).
        "aimm90": (pivot: (2, 0), points: { "hand": (1, 9) }, rows: [
            "tLt",
            "tL.",
            "tL.",
            "tLt",
            "Ss.",
            "Ss.",
            "Ss.",
            "Ss.",
            "sss",
            "Ss.",
            "s.s",
