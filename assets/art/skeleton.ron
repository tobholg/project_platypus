// A skeleton, lanky: a skull on a long neck, a narrow ribcage on a long
// spine, long thin arms (every pose and aim drawn longer). Its legs aren't
// drawn here: they're its creature file's `legs` (legs.rs, `rig`: two
// long bone legs stepping on whatever's under them, from its pelvis, 21
// cells up: its upper body sits high in the frame for them). Facing
// right; the game mirrors it.
(
    size: (44, 53),
    feet: (21.5, 53),
    outline: (26, 20, 20),
    palette: {
        'j': (238, 234, 218),   // skull, lit
        'L': (232, 228, 212),   // bone, lit
        'h': (218, 212, 194),   // skull
        'H': (172, 166, 150),   // skull, shade
        's': (214, 208, 190),   // bone
        'S': (168, 162, 146),   // bone, shade
        'k': (34, 26, 28),      // sockets, gaps
        't': (204, 198, 180),   // bone (the upper arm, ribs)
        'T': (156, 150, 136),   // ribs, shade
        'b': (62, 52, 50),      // the dark round the spine (under a belt)
        'y': (150, 144, 130),   // the pelvis
    },
    parts: {
