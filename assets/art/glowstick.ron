// A glow stick held in the hand. Drawn in its icon's colours.
(
    size: (6, 11),
    feet: (3, 11),
    outline: (24, 18, 16),
    palette: {
        'g': (150, 255, 170),   // glow
        'G': (60, 220, 110),   // glow, deep
        'd': (70, 80, 80),   // cap
        'w': (230, 255, 235),   // bright
    },
    frames: {
        "stick": [
            "..dd..",
            ".dddd.",
            ".gwgg.",
            ".gwgg.",
            ".gwgG.",
            ".gwgG.",
            ".gwGG.",
            ".ggGG.",
            ".gGGG.",
            ".GGGG.",
            ".dddd.",
        ],
    },
    clips: { "held": (frames: ["stick"], fps: 1) },
    anchors: { "grip": { "stick": (2, 7) } },
)
