// A pickaxe held in the hand, the handle pointing right from the grip, the
// head across its end. Every pickaxe is drawn from this in its icon's
// colours (icons.ron: the same letters).
(
    size: (21, 18),
    feet: (11, 18),
    outline: (24, 18, 16),
    palette: {
        'M': (236, 160, 90),   // head, lit (copper; each tier its icon's)
        'm': (205, 127, 50),   // head
        'd': (150, 86, 34),   // head, shaded
        'h': (150, 100, 56),   // handle
        'H': (104, 66, 36),   // handle, shaded
    },
    frames: {
        "pick": [
            "..............MM.....",
            "..............dMMM...",
            "...............ddmMM.",
            ".................dmM.",
            ".................dmM.",
            ".................dmM.",
            ".................dmMM",
            "................ddmmM",
            "hhhhHhhhhhhHhhhhdmmmM",
            "HHHHHHHHHHHHHHHHdmmmd",
            "................ddmmd",
            ".................dmmd",
            ".................dmd.",
            ".................dmd.",
            ".................dmd.",
            "...............ddmd..",
            "..............Mmmd...",
            "..............dd.....",
        ],
    },
    clips: { "held": (frames: ["pick"], fps: 1) },
    anchors: { "grip": { "pick": (2, 8) } },
)
