        'G': (90, 170, 50),     // venom, darker
        'w': (120, 30, 40),     // silk wrap, blood-dark
        'b': (190, 180, 160),   // a bone pommel
    },
    frames: {
        "fang": [
            "..........gg",
            ".....ggggGc.",
            "bwwwccccccc.",
            "....CCCCCC..",
            "............",
        ],
