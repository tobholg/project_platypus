// A cave spider: a fat abdomen with a red mark, red eyes, fangs; eight
// legs (four you see) in a scuttle. It climbs walls and ceilings (the game
// turns it to the surface) and leaps.
(
    size: (16, 9),
    feet: (8, 9),
    outline: (20, 14, 16),
    palette: {
        'b': (44, 34, 40),   // abdomen
        'B': (76, 60, 68),   // abdomen, lit
        'x': (196, 44, 40),   // its mark
        'c': (58, 46, 52),   // head
        'k': (250, 70, 40),   // eyes
        'f': (214, 200, 170),   // fangs
        'l': (34, 26, 30),   // legs
    },
    frames: {
        "walk_a": [
            "................",
            "..bbbb..........",
            ".bBBBBb.........",
            "bBBxxBBbccc.....",
            "bBBBBBBbccckf...",
            ".bBBBBb.cccc....",
            "..l.l.l..l.l.l..",
            ".l.l...l..l...l.",
            "l...l...l.....l.",
        ],
        "walk_b": [
            "................",
            "..bbbb..........",
            ".bBBBBb.........",
            "bBBxxBBbccc.....",
            "bBBBBBBbccckf...",
            ".bBBBBb.cccc....",
            "...l.l.l.l.l.l..",
            "..l..l..l..l..l.",
            ".l...l...l...l..",
        ],
        "leap": [
