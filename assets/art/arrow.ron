// An arrow in flight, pointing right; turned to where it flies. `tip` is
// what strikes, `grip` (its middle) where it turns about. `stuck`: one in
// a body, its head in it out of sight (the shaft ends at `entry`, where
// it went in).
(
    size: (17, 5),
    feet: (8, 5),
    outline: (30, 22, 16),
    palette: {
        'a': (176, 136, 84),    // shaft
        'h': (150, 154, 164),   // head
        'H': (206, 210, 216),   // head, the point
        'f': (204, 62, 50),     // feathers
        'F': (150, 40, 34),     // feathers, shaded
    },
    frames: {
        "arrow": [
            "fff..............",
            ".fFf.........HH..",
            "aaaaaaaaaaaaahhHH",
            ".fFf.........hh..",
            "fff..............",
        ],
        "stuck": [
            "fff..............",
            ".fFf.............",
            "aaaaaaaaaaaa.....",
            ".fFf.............",
            "fff..............",
        ],
    },
    clips: { "flying": (frames: ["arrow"], fps: 1) },
    anchors: { "grip": { "arrow": (8, 2), "stuck": (8, 2) }, "tip": { "arrow": (16, 2) }, "entry": { "stuck": (12, 2) } },
)
