// An arrow in flight, pointing right; turned to where it flies. `tip` is
// what strikes, `grip` (its middle) where it turns about. `stuck`: one in
// a body, its head in it out of sight (the shaft ends at `entry`, where
// it went in).
(
    size: (20, 5),
    feet: (10, 5),
    outline: (30, 22, 16),
    palette: {
        'a': (176, 136, 84),    // shaft
        'h': (150, 154, 164),   // head
        'H': (206, 210, 216),   // head, the point
        'f': (204, 62, 50),     // feathers
        'F': (150, 40, 34),     // feathers, shaded
    },
    frames: {
        "arrow": [
            "ffff................",
            ".fFFf...........HH..",
            "aaaaaaaaaaaaaaaahhHH",
            ".fFFf...........hh..",
            "ffff................",
        ],
        "stuck": [
            "ffff................",
            ".fFFf...............",
            "aaaaaaaaaaaaaa......",
            ".fFFf...............",
            "ffff................",
        ],
    },
    clips: { "flying": (frames: ["arrow"], fps: 1), "stuck": (frames: ["stuck"], fps: 1) },
    anchors: { "grip": { "arrow": (10, 2), "stuck": (10, 2) }, "tip": { "arrow": (19, 2) }, "entry": { "stuck": (14, 2) } },
)
