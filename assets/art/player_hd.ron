            "hhhhhhhhhhhh",
            "HHhhhhhsssss",
            "HHhhSssHHss.",
            "HHhSssssssss",
            "HHhSSsssSSss",
            ".HhSsssssssS",
            "..HSSsssrr..",
            "...SSSss....",
