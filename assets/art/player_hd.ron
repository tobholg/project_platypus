        "kick_wind": [
            (part: "arm_fwd", at: (12, 18), shade: 0.72, tag: "back_arm"),
            (part: "kick_knee", at: (12, 26)),
            (part: "torso", at: (11, 17)),
            (part: "head", at: (11, 6)),
            (part: "arm_back", at: (17, 18), outline: true, tag: "front_arm"),
        ],
        "kick_out": [
