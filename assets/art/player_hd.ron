// HD spike (PLATYPUS_HD=1): drawn at 1.5x (head, torso, arms, legs and
// the run by hand; the rest upscaled, placeholders).
// The player: an adventurer in a green tunic, drawn on the humanoid rig
// (parts put together into poses; crates/art). Facing right; the game
// mirrors it. ~20 px tall on a 6×15 body (the head may overhang it).
(
    size: (36, 38),
    feet: (17.5, 38),
    outline: (26, 20, 20),
    palette: {
        'j': (126, 86, 56),     // hair, lit
        'L': (104, 182, 124),   // tunic, lit
        'o': (40, 28, 24),      // soles
        'w': (238, 236, 240),   // eye white
        'r': (176, 104, 96),    // mouth
        'U': (98, 70, 52),      // boot cuff
        'h': (96, 62, 40),      // hair
        'H': (70, 44, 30),      // hair, shade
        's': (232, 184, 150),   // skin
        'S': (196, 140, 110),   // skin, shade
        'k': (34, 26, 30),      // eye
        't': (72, 150, 96),     // tunic
        'T': (52, 112, 72),     // tunic, shade
        'b': (104, 70, 44),     // belt
        'y': (220, 186, 90),    // buckle
        'p': (88, 84, 110),     // trousers
        'q': (66, 62, 84),      // trousers, the far leg
        'B': (72, 50, 38),      // boots
        'C': (54, 38, 30),      // boots, the far foot
    },
    parts: {
        "head": (rows: [
            "...hhhhhh...",
            ".hhjjjhhhh..",
            "hhjjhhhhhhh.",
            "hhhhhhhhhhhh",
            "HHhhhhhsssss",
