        "torso": (rows: [
            "..TTtsstt..",
            ".TTTtsttLt.",
            "TTTTtttLLt.",
            "TTTttttLtt.",
            "TTTtttttLt.",
            "TTTttttttt.",
            "bbbbbbbyyb.",
            "TTTtttttLt.",
            "TTTTTttttT.",
        ]),
        // Arms hang from the shoulder (pivot); the hand is where a weapon goes.
        "arm": (pivot: (0, 0), points: { "hand": (0, 8) }, rows: [
            "tLt",
            "tLt",
            "Ttt",
            "ss.",
            "ss.",
            "Ss.",
            "Ss.",
            "sss",
            "sS.",
