// A zombie: the shambling dead, in the clothes it died in. Dead-pale skin
// with a bruised purple in its shadows and veins showing, a milky eye, its
// jaw hanging, blood round its mouth and down its torn shirt. Its arms reach out ahead of
// it as it goes (standing and walking: both held forward). Its legs aren't
// drawn here: they're its creature file's `legs` (legs.rs, `rig`: two legs
// in dark trousers from its hips, 14 cells up, stepping on whatever's
// under them). Its rig is the skeleton's (the same places and arms'
// shapes), in a shorter frame: a man's height, not the skeleton's.
// Facing right; the game mirrors it.
(
    size: (36, 40),
    feet: (17.5, 40),
    outline: (24, 18, 20),
    palette: {
        'g': (204, 188, 168),   // skin, lit: dead pale, sallow
        'G': (172, 156, 140),   // skin
        'D': (128, 110, 110),   // skin, shade (a bruised purple in it)
        'v': (132, 106, 126),   // veins
        'k': (34, 24, 26),      // sockets, mouth
        'e': (222, 224, 212),   // its eye, milky
        'x': (118, 22, 24),     // blood (round its mouth, down its shirt)
        'h': (44, 36, 32),      // hair, lank
        'c': (104, 110, 118),   // the shirt, grubby
        'C': (76, 80, 90),      // the shirt, shade
        'b': (52, 40, 32),      // a belt
        'p': (58, 56, 62),      // trousers, at the hips
    },
    parts: {
        // Its mouth (where it bites from, its arms gone).
        "head": (points: { "mouth": (6, 9) }, rows: [
            "..h.hhh...",
            ".hhhhhhhh.",
            "hhhGgggghh",
            "hhGggvggg.",
            "hGgggkkgg.",
            "GGggkekgg.",
            "GGgggkggg.",
            ".GGgggvgg.",
            "..GgkkkkG.",
            "..Gxkxkx..",
            "...GxGx...",
        ]),
        "blink": (points: { "mouth": (6, 9) }, rows: [
            "..h.hhh...",
            ".hhhhhhhh.",
            "hhhGgggghh",
            "hhGggvggg.",
            "hGgggggggg",
            "GGggkkkgg.",
            "GGgggggggg",
            ".GGgggvgg.",
            "..GgkkkkG.",
            "..Gxkxkx..",
            "...GxGx...",
        ]),
        // Hunched in a torn shirt, blood down its front, its skin showing
        // through the tears; a belt and its trousers' top (the legs hang
        // from its two lower corners).
        "torso": (rows: [
            "...GgG...",
            ".ccxgxcc.",
            "cccxxccCC",
            "ccgcxcCCC",
            "cgvgcxcCC",
            "ccgccxcCC",
            "cccccxcCC",
            ".cccgccC.",
            ".ccgDgCC.",
            ".cccccCC.",
            ".bbbbbbb.",
            ".ppppppp.",
            ".pp...pp.",
        ]),
        // Arms hang from the shoulder (pivot), long, grey-green and thin; the
        // hand is where a claw goes.
        "arm": (pivot: (0, 0), points: { "hand": (0, 12) }, rows: [
            "GgG",
            "Gg.",
            "Gg.",
            "Gg.",
            "Gg.",
            "GgG",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "GGG",
            "G.G",
        ]),
        "arm_fwd": (pivot: (0, 0), points: { "hand": (6, 9) }, rows: [
            "GgG.....",
            ".Gg.....",
            ".Gg.....",
            "..Gg....",
            "..GgG...",
            "...DG...",
            "....DG..",
            "....DG..",
            ".....DG.",
            ".....GGG",
            "......GG",
        ]),
        "arm_back": (pivot: (7, 0), points: { "hand": (1, 9) }, rows: [
            ".....GgG",
            ".....Gg.",
            ".....Gg.",
            "....Gg..",
            "...GgG..",
            "...DG...",
            "..DG....",
            "..DG....",
            ".DG.....",
            "GGG.....",
            "G.G.....",
        ]),
        "arm_up": (pivot: (0, 14), points: { "hand": (5, 1) }, rows: [
            "....G.G",
            "....GGG",
            "....DG.",
            "....DG.",
            "...DG..",
            "...DG..",
            "...DG..",
            "...DG..",
            "..GgG..",
            "..Gg...",
            ".Gg....",
            ".Gg....",
            "Gg.....",
            "Gg.....",
            "GgG....",
        ]),
        // Reaching up and forward (a jump; a hand on a wall).
        "arm_reach": (pivot: (0, 10), points: { "hand": (9, 1) }, rows: [
            "........G.G",
            "........GGG",
            ".......DGG.",
            "......DG...",
            ".....DG....",
            "....DG.....",
            "...GgG.....",
            "..Gg.......",
            ".Gg........",
            ".Gg........",
            "GgG........",
        ]),
        // Thrown forward and up (a jump).
        "arm_lift": (pivot: (0, 6), points: { "hand": (10, 1) }, rows: [
            ".........G.G",
            "........GGGG",
            ".......DG...",
            "......DG....",
            "....GgG.....",
            "..GgGg......",
            "GgGg........",
        ]),
        // The front arm pointing where it aims (swings, casting): at angles
        // from straight down to straight up (the fan below).
        "aimm90": (pivot: (2, 0), points: { "hand": (1, 12) }, rows: [
            "GgG",
            "Gg.",
            "Gg.",
            "Gg.",
            "Gg.",
            "GgG",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "DG.",
            "GGG",
            "DG.",
            "G.G",
        ]),
        "aimm60": (pivot: (1, 0), points: { "hand": (5, 10) }, rows: [
            "Gg.....",
            ".Gg....",
            ".Gg....",
            ".Gg....",
            "..GgG..",
            "..DG...",
            "...DG..",
            "...DG..",
            "...DG..",
            "....DGG",
            "....GGG",
            "....G.G",
        ]),
        "aimm30": (pivot: (1, 0), points: { "hand": (11, 7) }, rows: [
            ".gg...........",
            "..Gg..........",
            "...Gg.........",
            "....Gg........",
            "....GgGG......",
            ".....DDGG.....",
            ".......DDGG...",
            ".........DGGG.",
            "..........G.G.",
        ]),
        "aim0": (pivot: (0, 0), points: { "hand": (12, 1) }, rows: [
            "GgggggG....G.G",
            "GGGGGGGGGGGGG.",
            ".......DDDDGGG",
        ]),
        "aim30": (pivot: (0, 6), points: { "hand": (10, 1) }, rows: [
            ".........G.G",
            "........GGG.",
            ".......GDD..",
            ".....GGD....",
            "...ggGG.....",
            ".GgGG.......",
            "GgG.........",
            "DD..........",
        ]),
        "aim60": (pivot: (0, 11), points: { "hand": (6, 1) }, rows: [
            ".....G.G",
            ".....GGG",
            ".....DG.",
            ".....DG.",
            "....DG..",
            "....DG..",
            "...DG...",
            "...GgG..",
            "..Gg....",
            "..Gg....",
            ".Gg.....",
            "Gg......",
            "DG......",
        ]),
        "aim90": (pivot: (2, 13), points: { "hand": (1, 0) }, rows: [
            "G.G",
            "GGG",
            ".DG",
            ".DG",
            ".DG",
            ".DG",
            ".DG",
            ".DG",
            "GgG",
            ".Gg",
            ".Gg",
            ".Gg",
            ".Gg",
            "GgG",
        ]),
    },
    poses: {
        // Standing, both arms held out ahead (down a little); breathing in
        // (the chest and head a pixel up); a blink.
        "stand": [
            (part: "aimm30", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (12, 4)),
            (part: "aimm30", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        "breathe": [
            (part: "aimm30", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 13)),
            (part: "head", at: (12, 3)),
            (part: "aimm30", at: (20, 15), outline: true, tag: "front_arm"),
        ],
        "blink": [
            (part: "aimm30", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "blink", at: (12, 4)),
            (part: "aimm30", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        // Shambling: the arms out ahead, one lifting as the other drops,
        // against the legs' stride (the legs are its creature file's); a
        // bob on the passing steps.
        "run_a": [
            (part: "aim0", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (12, 4)),
            (part: "aimm30", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        "run_b": [
            (part: "aimm30", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 13)),
            (part: "head", at: (12, 3)),
            (part: "aimm30", at: (20, 15), outline: true, tag: "front_arm"),
        ],
        "run_c": [
            (part: "aimm30", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (12, 4)),
            (part: "aim0", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        "run_d": [
            (part: "aimm30", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 13)),
            (part: "head", at: (12, 3)),
            (part: "aimm30", at: (20, 15), outline: true, tag: "front_arm"),
        ],
        // Reaching for you (the grab's tell): both arms up and out, its
        // head thrown back. Lunging: leaning in, arms straight out. Biting:
        // its head down and in, at what it holds.
        // Coming up out of the ground: both arms straight up over its
        // head, reaching (they break the surface first).
        "climb": [
            (part: "arm_up", at: (14, 17), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 16)),
            (part: "head", at: (12, 6)),
            (part: "arm_up", at: (19, 17), outline: true, tag: "front_arm"),
        ],
        "tell": [
            (part: "aim60", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (11, 3)),
            (part: "aim60", at: (20, 15), outline: true, tag: "front_arm"),
        ],
        "lunge": [
            (part: "aim0", at: (16, 17), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (15, 15)),
            (part: "head", at: (15, 5)),
            (part: "aim0", at: (22, 17), outline: true, tag: "front_arm"),
        ],
        "bite": [
            (part: "aim0", at: (16, 17), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (15, 15)),
            (part: "head", at: (17, 7)),
            (part: "aim0", at: (22, 17), outline: true, tag: "front_arm"),
        ],
        // Rising: an arm thrown up. Falling: arms out.
        "rise": [
            (part: "arm", at: (14, 15), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (12, 4)),
            (part: "arm_lift", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        "drop": [
            (part: "arm_up", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (12, 4)),
            (part: "arm_fwd", at: (20, 16), outline: true, tag: "front_arm"),
        ],
        // Dashing: leaning in, arms back.
        "dash": [
            (part: "arm_back", at: (16, 17), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (15, 15)),
            (part: "head", at: (15, 6)),
            (part: "arm_back", at: (22, 17), outline: true, tag: "front_arm"),
        ],
        // Sliding down a wall (on the right): a hand on it.
        "wall": [
            (part: "arm", at: (14, 16), shade: 0.72, tag: "back_arm"),
            (part: "torso", at: (13, 14)),
            (part: "head", at: (12, 4)),
            (part: "arm_reach", at: (20, 16), outline: true, tag: "front_arm"),
        ],
    },
    // The front arm at angles: shown instead of the pose's own front arm
    // (tagged `front_arm`) while aiming. (The back arm is tagged too: its
    // hand, `back_arm.hand`, holds a torch.)
    fans: {
        "front_arm": [
            (angle: -90, part: "aimm90"),
            (angle: -60, part: "aimm60"),
            (angle: -30, part: "aimm30"),
            (angle: 0, part: "aim0"),
            (angle: 30, part: "aim30"),
            (angle: 60, part: "aim60"),
            (angle: 90, part: "aim90"),
        ],
    },
    derived: {
        // Hit: knocked back a pixel.
        "hurt": (from: "drop", shift: (-1, 0)),
    },
    clips: {
        "idle": (frames: ["stand", "stand", "breathe", "breathe", "stand", "stand", "breathe", "breathe", "stand", "blink", "stand", "breathe", "breathe"], fps: 5),
        "run": (frames: ["run_a", "run_b", "run_c", "run_d"], fps: 6),
        "jump": (frames: ["rise"], fps: 5),
        "fall": (frames: ["drop"], fps: 5),
        "dash": (frames: ["dash"], fps: 5),
        "wall": (frames: ["wall"], fps: 5),
        "hurt": (frames: ["hurt"], fps: 5),
        "tell": (frames: ["tell"], fps: 5),
        "climb": (frames: ["climb"], fps: 5),
        "lunge": (frames: ["lunge"], fps: 5),
        "bite": (frames: ["lunge", "bite", "bite", "lunge"], fps: 6),
    },
)
