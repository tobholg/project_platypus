// A cave scorpion's pincer, pointing right: a palm and two fingers. `grip`
// is its wrist, where its arm ends.
(
    size: (13, 8),
    feet: (1, 7),
    outline: (22, 16, 12),
    palette: {
        'c': (52, 34, 24),   // claw, shade
        'C': (100, 64, 38),   // claw
        'L': (150, 100, 56),   // claw, lit
        'w': (80, 52, 32),   // wrist
    },
    frames: {
        "body": [
            ".............",
            ".....cCCCc...",
            "...cCCLLLCCc.",
            ".wcCLLLLCc...",
            "...cCLLc.....",
            "....cCCCCc...",
            ".....ccc.....",
            ".............",
        ],
    },
    clips: {
        "idle": (frames: ["body"], fps: 1),
    },
    anchors: { "grip": { "body": (1, 3) } },
)
