// A lantern, held in the off hand (light/torch.rs): the user's figure's,
// small, an iron cap and foot, a glass body, a flame inside. Hangs upright
// from `grip`, the hand that holds it (its bail in the fist, the cap's knob
// just under it); its light comes from `flame`. (A clear cell round it:
// its outline's drawn there.)
(
    size: (5, 10),
    feet: (2.5, 10),
    outline: (18, 18, 22),
    palette: {
        'i': (70, 66, 64),      // iron
        'I': (118, 112, 108),   // iron, lit
        'k': (40, 38, 38),      // iron, the band under the cap
        'r': (232, 110, 24),    // glass, the flame's red at its edge
        'g': (250, 182, 40),    // glass, lit from inside
        'G': (255, 222, 110),   // glass, brightest
        'f': (255, 250, 220),   // the flame
    },
    frames: {
        "lantern": [
            ".....",
            ".....",
            "..I..",
            ".iIi.",
            ".kkk.",
            ".rGr.",
            ".gfg.",
            ".iIi.",
            ".iIi.",
            ".....",
        ],
    },
    clips: { "on": (frames: ["lantern"], fps: 1) },
    anchors: { "grip": { "lantern": (2, 0) }, "flame": { "lantern": (2, 6) } },
)
