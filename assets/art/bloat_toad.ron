        'w': (148, 136, 76),    // warts
        'W': (176, 162, 96),    // warts, lit
        'y': (204, 196, 134),   // belly
        'Y': (172, 164, 108),   // belly, in shade
        't': (226, 206, 150),   // the throat sac
        'T': (244, 230, 182),   // the throat sac, stretched and lit
        'v': (120, 220, 110),   // gas at its vents
        'e': (230, 184, 40),    // its eye
        'E': (255, 240, 170),   // its eye, catching the light
        'k': (20, 16, 12),      // its pupil
        'm': (120, 36, 40),     // its mouth
        'M': (84, 22, 28),      // its mouth, deep
        'p': (220, 110, 130),   // its tongue
