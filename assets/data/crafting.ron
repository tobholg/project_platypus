    recipes: [
        // ---- by hand ----
        (makes: "block:planks", count: 2, needs: [("block:wood", 1)]),
        (makes: "torch", count: 3, needs: [("block:planks", 1), ("block:coal", 1)]),
        (makes: "workbench", needs: [("block:planks", 6)]),

        // ---- at the workbench ----
        (makes: "chest", needs: [("block:planks", 8)], at: "workbench"),
        (makes: "block:platform", count: 4, needs: [("block:planks", 1)], at: "workbench"),
        (makes: "block:wood_wall", count: 4, needs: [("block:planks", 1)], at: "workbench"),
        // Building blocks (the blocks arc): cut stone, beams, walls.
        (makes: "hammer", needs: [("block:planks", 4), ("block:stone", 3)], at: "workbench"),
        // Furniture.
        (makes: "door", needs: [("block:planks", 6)], at: "workbench"),
        (makes: "table", needs: [("block:planks", 8)], at: "workbench"),
        (makes: "chair", needs: [("block:planks", 4)], at: "workbench"),
        (makes: "bookcase", needs: [("block:planks", 12)], at: "sawmill"),
        (makes: "bed", needs: [("block:planks", 12)], at: "sawmill"),
        (makes: "barrel", needs: [("block:planks", 6), ("copper_bar", 1)], at: "sawmill"),
        (makes: "crate", needs: [("block:planks", 5)], at: "workbench"),
        (makes: "potted_plant", needs: [("block:dirt", 2), ("block:grass", 1)], at: "workbench"),
        (makes: "painting", needs: [("block:planks", 2), ("gold_bar", 1)], at: "sawmill"),
        (makes: "wall_shelf", needs: [("block:planks", 4), ("block:glass", 1)], at: "sawmill"),
        (makes: "banner_red", needs: [("block:planks", 2), ("block:ruby", 1)], at: "sawmill"),
        (makes: "banner_green", needs: [("block:planks", 2), ("block:emerald", 1)], at: "sawmill"),
        (makes: "campfire", needs: [("block:wood", 6), ("block:stone", 8), ("torch", 1)]),
        (makes: "hearth", needs: [("block:stone", 20), ("block:brick", 6), ("torch", 2)], at: "mason_bench"),
        (makes: "candelabra", needs: [("iron_bar", 2), ("torch", 3)], at: "anvil"),
        (makes: "hanging_lantern", needs: [("iron_bar", 1), ("block:glass", 1), ("torch", 1)], at: "anvil"),
        (makes: "chandelier", needs: [("iron_bar", 4), ("torch", 5)], at: "anvil"),
        (makes: "block:cobblestone", needs: [("block:stone", 1)], at: "mason_bench"),
        (makes: "block:stone_wall", count: 4, needs: [("block:stone", 1)], at: "mason_bench"),
        (makes: "block:timber", needs: [("block:wood", 1)], at: "sawmill"),
        (makes: "wooden_shield", needs: [("block:planks", 8), ("copper_bar", 1)], at: "workbench"),
        (makes: "furnace", needs: [("block:stone", 12), ("block:planks", 4), ("torch", 3)], at: "workbench"),
        (makes: "anvil", needs: [("copper_bar", 6), ("block:stone", 10)], at: "workbench"),
        (makes: "mason_bench", needs: [("block:stone", 20), ("block:planks", 6), ("copper_bar", 2)], at: "workbench"),
        (makes: "sawmill", needs: [("block:planks", 10), ("block:wood", 6), ("copper_bar", 2)], at: "workbench"),
        (makes: "bow", needs: [("block:planks", 6)], at: "workbench"),
        (makes: "arrow", count: 10, needs: [("block:planks", 1), ("block:stone", 1)], at: "workbench"),
        (makes: "oak_wand", needs: [("block:planks", 3), ("block:amethyst", 1)], at: "workbench"),

        // ---- at the furnace: smelting ----
        (makes: "copper_bar", needs: [("block:copper_ore", 3)], at: "furnace"),
        // A safety lamp: copper, a glass chimney, a flame behind gauze.
        (makes: "safety_lamp", needs: [("copper_bar", 3), ("block:glass", 1), ("torch", 1)], at: "furnace"),
        (makes: "iron_bar", needs: [("block:iron_ore", 3)], at: "furnace"),
        (makes: "silver_bar", needs: [("block:silver_ore", 4)], at: "furnace"),
        (makes: "gold_bar", needs: [("block:gold_ore", 4)], at: "furnace"),
        (makes: "mithril_bar", needs: [("block:mithril_ore", 5)], at: "furnace"),
        (makes: "aerolite_bar", needs: [("block:aerolite_ore", 5)], at: "furnace"),
        // Vessels: the ladle for molten metal, a bucket, a glass flask.
        (makes: "ladle", needs: [("iron_bar", 4)], at: "anvil"),
        // Lights to carry: a lantern, flashlights, a miner's helmet.
        (makes: "lantern", needs: [("iron_bar", 3), ("block:glass", 2), ("torch", 1)], at: "anvil"),
        (makes: "pocket_flashlight", needs: [("copper_bar", 4), ("block:glass", 1), ("torch", 1)], at: "anvil"),
        (makes: "flashlight", needs: [("iron_bar", 4), ("block:glass", 2), ("gold_bar", 1)], at: "anvil"),
        (makes: "mining_helmet", needs: [("copper_bar", 6), ("torch", 2)], at: "anvil"),
        (makes: "iron_shield", needs: [("iron_bar", 8)], at: "anvil"),
        (makes: "bucket", needs: [("iron_bar", 3)], at: "anvil"),
        (makes: "flask", needs: [("block:glass", 1)], at: "furnace"),
        // Heat-proof: a mould that holds molten iron.
        (makes: "block:firebrick", needs: [("block:brick", 1), ("block:sand", 1)], at: "furnace"),
        (makes: "block:glass", count: 2, needs: [("block:sand", 2)], at: "furnace"),
        (makes: "block:brick", needs: [("block:stone", 2)], at: "mason_bench"),
        (makes: "block:roof_tiles", count: 2, needs: [("block:dirt", 1), ("block:sand", 1)], at: "furnace"),
        (makes: "block:plaster", count: 4, needs: [("block:sand", 1), ("block:stone", 1)], at: "mason_bench"),
        (makes: "block:leaded_glass", count: 4, needs: [("block:glass", 2), ("copper_bar", 1)], at: "furnace"),
        (makes: "block:stained_glass", count: 4, needs: [("block:glass", 2), ("block:amethyst", 1)], at: "furnace"),
        (makes: "block:rose_glass", count: 4, needs: [("block:glass", 2), ("block:ruby", 1)], at: "furnace"),
        (makes: "glowstick", count: 3, needs: [("block:glass", 1), ("block:emerald", 1)], at: "furnace"),
        // Potions: healroot (a cave herb) brewed in glass.
        (makes: "small_health_potion", needs: [("block:glass", 1), ("healroot", 2)], at: "workbench"),
        (makes: "fire_ward_potion", needs: [("block:glass", 1), ("healroot", 1), ("block:obsidian", 1)], at: "workbench"),
        (makes: "regeneration_potion", needs: [("block:glass", 1), ("healroot", 3), ("block:mushroom_stem", 1)], at: "workbench"),
        (makes: "antidote", needs: [("block:glass", 1), ("healroot", 1), ("block:toxic_crust", 1)], at: "workbench"),

        // ---- at the anvil: tools, arms, armour, hooks ----
        (makes: "copper_pickaxe", needs: [("copper_bar", 6), ("block:planks", 2)], at: "anvil"),
        (makes: "iron_pickaxe", needs: [("iron_bar", 8), ("block:planks", 2)], at: "anvil"),
        (makes: "silver_pickaxe", needs: [("silver_bar", 9), ("block:planks", 2)], at: "anvil"),
        (makes: "gold_pickaxe", needs: [("gold_bar", 10), ("block:planks", 2)], at: "anvil"),
        (makes: "mithril_pickaxe", needs: [("mithril_bar", 12)], at: "anvil", locked: true),
        (makes: "copper_axe", needs: [("copper_bar", 5), ("block:planks", 2)], at: "anvil"),
        // Swords and armour, a set of each metal: copper first (the anvil's
        // copper), then iron, silver, gold, mithril, each a step up.
        (makes: "copper_shortsword", needs: [("copper_bar", 7), ("block:planks", 1)], at: "anvil"),
        (makes: "copper_longsword", needs: [("copper_bar", 10), ("block:planks", 2)], at: "anvil"),
        (makes: "copper_helm", needs: [("copper_bar", 8)], at: "anvil"),
        (makes: "diving_helmet", needs: [("copper_bar", 10), ("block:glass", 4)], at: "anvil"),
        (makes: "copper_mail", needs: [("copper_bar", 14)], at: "anvil"),
        (makes: "copper_gauntlets", needs: [("copper_bar", 5)], at: "anvil"),
        (makes: "copper_greaves", needs: [("copper_bar", 10)], at: "anvil"),
        (makes: "copper_boots", needs: [("copper_bar", 6)], at: "anvil"),
        (makes: "iron_shortsword", needs: [("iron_bar", 7), ("block:planks", 1)], at: "anvil"),
        (makes: "longsword", needs: [("iron_bar", 10), ("block:planks", 2)], at: "anvil"),
        (makes: "iron_helm", needs: [("iron_bar", 10)], at: "anvil"),
        (makes: "chainmail", needs: [("iron_bar", 16)], at: "anvil"),
        (makes: "iron_gauntlets", needs: [("iron_bar", 6)], at: "anvil"),
        (makes: "iron_greaves", needs: [("iron_bar", 12)], at: "anvil"),
        (makes: "iron_boots", needs: [("iron_bar", 8)], at: "anvil"),
