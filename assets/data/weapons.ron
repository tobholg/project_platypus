// Weapons held in the hand (SPEC 6.2). Each is drawn from its sprite
// (assets/art/<art>.ron: pointing right, its `grip` anchor where the hand
// holds it), turned to every angle it can point; those same pictures are
// what hits (pixel against the target's pixels).
//
// damage, knock (cells/s), stun (s): per hit, before a move's multipliers.
// harm: its kind of hurt (DESIGN §14.2): slash (the default), pierce, blunt;
//   a move may say its own (a thrust pierces).
// rest: how it's held when not swinging (degrees from level; + up).
// moves: the combo, in order (pressing again during one queues the next;
//   a pause of `combo_gap` s starts over). Each:
//   from, to: the swing, in degrees from where it's aimed (+ up, facing
//     right; mirrored facing left); it gets there in `windup` s, sweeps
//     in `active` s (what it touches then is hit, each thing once), holds
//     for `recovery` s.
//   thrust: cells the blade drives forward at the middle of the sweep.
//   stamina: its cost (none left: no swing). lunge: cells/s forward as
//     it starts (on the ground). damage, knock: multipliers.
// down: the down-strike, in the air with S held (or aimed well below you):
//   a move whose angles are from straight down. What it hits bounces you up
//   (`pogo`: that share of your own jump's height, at the game's tempo) and
//   gives back your air jumps and dash: a creature, a hostile spell (cut
//   out of the air), a hazard (lava, fire, acid, web). A slash bounces
//   once; with `dive` it's a plunge: point down, falling at least `dive`
//   cells/s, live till it lands, bounces off something, or has fallen 70
//   cells (then it's over), and a landing slams what's within `slam` cells.
//   Any other down-strike is quick, however long its move: a windup of
//   0.04 s at most, live 0.15 s (its whole sweep), back in 0.07 s, reaching
//   4 cells further down and striking what's within 2.5 cells of a body's
//   box; while it's live over what it strikes, and a moment after a bounce,
//   that can't hurt you by touch. A pogo's to be timed. Only a fresh click
//   strikes down: holding it doesn't.
//   None: the first move, turned down.
// dash: the dash attack: struck during a dash or just after it, once a dash
//   (it ends the dash slipping blows as its blade comes out). Its angles
//   are from where it's aimed, as the combo's. hop: cells/s up as it
//   sweeps; it lunges in the air too; launch: what it hits is thrown up
//   this much more; slam: where it comes down (from its hop) it slams
//   what's within this many cells. A rising slash (swords), a dash thrust
//   (a dagger), a leaping smash (heavy blades and clubs).
(
    combo_gap: 0.35,
    pogo: 1.0,
    // Sparks where a blade bites flesh, and where it rings off stone; the
    // smear the outer part of the blade leaves as it sweeps (`trail`: motes
    // for every fourth pixel of it, each turn of the sweep).
    hit: (count: 12, life: (0.08, 0.22), colors: [(255, 255, 240), (255, 230, 150), (200, 120, 60)], speed: 180, spread: 0.9, drag: 5),
    trail: (count: 1, life: (0.03, 0.08), colors: [(255, 255, 255), (220, 232, 255), (170, 190, 235)], speed: 5, drag: 8),
    clang: (count: 7, life: (0.06, 0.18), colors: [(255, 255, 255), (255, 220, 120)], speed: 210, spread: 1.2, drag: 5, gravity: 300, glow: true),
    weapons: [
        (
            id: "shortsword", art: "shortsword",
            damage: 12, knock: 225, stun: 0.18, rest: -35,
            moves: [
                (name: "slash", from: 105, to: -75, windup: 0.05, active: 0.09, recovery: 0.09, stamina: 8, lunge: 75),
                (name: "backslash", from: -75, to: 100, windup: 0.04, active: 0.09, recovery: 0.1, stamina: 8, lunge: 60),
                (name: "thrust", harm: pierce, from: 0, to: 0, thrust: 8, windup: 0.07, active: 0.08, recovery: 0.13, stamina: 11, lunge: 195, damage: 1.4, knock: 1.3),
            ],
            down: (name: "down slash", from: 55, to: -55, thrust: 6, windup: 0.02, active: 0.14, recovery: 0.08, stamina: 8),
            dash: (name: "rising slash", from: -95, to: 115, windup: 0.04, active: 0.12, recovery: 0.22, stamina: 14, lunge: 110, hop: 230, damage: 1.35, knock: 1.2, launch: 0.9),
        ),
        (
            id: "longsword", art: "longsword",
            damage: 24, knock: 375, stun: 0.3, rest: -30,
            moves: [
                (name: "cleave", from: 125, to: -95, windup: 0.13, active: 0.15, recovery: 0.18, stamina: 16, lunge: 60),
                (name: "sweep", from: -95, to: 115, windup: 0.09, active: 0.15, recovery: 0.2, stamina: 16, lunge: 45),
                (name: "drive", harm: pierce, from: 5, to: -5, thrust: 11, windup: 0.15, active: 0.1, recovery: 0.24, stamina: 22, lunge: 255, damage: 1.6, knock: 1.5),
            ],
            down: (name: "plunge", harm: pierce, from: 0, to: 0, thrust: 5, windup: 0.08, active: 4, recovery: 0.22, stamina: 14, dive: 780, slam: 21, damage: 1.2),
            dash: (name: "leaping smash", from: 130, to: -70, windup: 0.1, active: 0.2, recovery: 0.3, stamina: 24, lunge: 90, hop: 260, damage: 1.5, knock: 1.4, slam: 16),
        ),
        // Enemies' weapons: slower, with windups to read.
        (
            id: "cleaver", art: "cleaver",
            damage: 11, knock: 255, stun: 0.25, rest: -40,
            moves: [
                (name: "hack", from: 110, to: -70, windup: 0.26, active: 0.11, recovery: 0.2, stamina: 14, lunge: 90),
                (name: "backhack", from: -70, to: 95, windup: 0.18, active: 0.11, recovery: 0.3, stamina: 14, lunge: 60),
            ],
            dash: (name: "rising slash", from: -95, to: 115, windup: 0.04, active: 0.12, recovery: 0.22, stamina: 18, lunge: 110, hop: 230, damage: 1.35, knock: 1.2, launch: 0.9),
        ),
        (
            id: "rusty_sword", art: "rusty_sword",
            damage: 9, knock: 210, stun: 0.2, rest: -40,
            moves: [
                (name: "hack", from: 105, to: -70, windup: 0.24, active: 0.1, recovery: 0.2, stamina: 12, lunge: 75),
                (name: "backhack", from: -70, to: 95, windup: 0.18, active: 0.1, recovery: 0.3, stamina: 12, lunge: 45),
            ],
            dash: (name: "rising slash", from: -95, to: 115, windup: 0.04, active: 0.12, recovery: 0.22, stamina: 16, lunge: 110, hop: 230, damage: 1.35, knock: 1.2, launch: 0.9),
        ),
        // A dagger: quick stabs, little reach.
        (
            id: "fang", art: "fang", harm: pierce,
            damage: 8, knock: 105, stun: 0.12, rest: -30,
            moves: [
                (name: "stab", from: 10, to: -10, thrust: 6, windup: 0.03, active: 0.06, recovery: 0.06, stamina: 5, lunge: 105),
                (name: "slash", from: 80, to: -60, windup: 0.03, active: 0.07, recovery: 0.06, stamina: 5, lunge: 60),
                (name: "stab", from: -5, to: 5, thrust: 8, windup: 0.04, active: 0.06, recovery: 0.1, stamina: 7, lunge: 165, damage: 1.5),
            ],
            down: (name: "down slash", from: 50, to: -50, thrust: 6, windup: 0.02, active: 0.11, recovery: 0.06, stamina: 5),
            dash: (name: "dash thrust", from: 0, to: 0, thrust: 12, windup: 0.03, active: 0.12, recovery: 0.2, stamina: 12, lunge: 340, damage: 1.6, knock: 1.4),
        ),
        // Bare bony fists: quick, weak jabs (a skeleton without its sword).
        (
            id: "bony_fists", art: "bony_fist", harm: blunt,
            damage: 4, knock: 120, stun: 0.1, rest: -20,
            moves: [
                (name: "jab", from: 5, to: -5, thrust: 5, windup: 0.12, active: 0.07, recovery: 0.16, stamina: 6, lunge: 70),
                (name: "cross", from: -5, to: 5, thrust: 6, windup: 0.1, active: 0.07, recovery: 0.24, stamina: 6, lunge: 90),
            ],
        ),
        // A zombie's hands: dead nails, raking (it has no weapon).
        (
            id: "rotten_claws", art: "rotten_claw", harm: slash,
            damage: 10, knock: 90, stun: 0.15, rest: -10,
            moves: [
                (name: "rake", from: 60, to: -40, windup: 0.35, active: 0.12, recovery: 0.4, stamina: 8, lunge: 40),
                (name: "claw", from: -30, to: 40, windup: 0.3, active: 0.1, recovery: 0.45, stamina: 8, lunge: 30),
            ],
        ),
        // A crimson head's hands: quicker, harder, nails like hooks.
        (
            id: "crimson_claws", art: "crimson_claw", harm: slash,
            damage: 15, knock: 120, stun: 0.2, rest: -10,
            moves: [
                (name: "rake", from: 60, to: -40, windup: 0.22, active: 0.12, recovery: 0.3, stamina: 8, lunge: 60),
                (name: "claw", from: -30, to: 40, windup: 0.2, active: 0.1, recovery: 0.35, stamina: 8, lunge: 50),
            ],
        ),
        // A zombie with no arms left: its teeth (it lunges and bites).
        (
            id: "zombie_bite", art: "zombie_teeth", harm: pierce,
            damage: 9, knock: 60, stun: 0.2, rest: 0,
            moves: [
                (name: "bite", from: 15, to: -15, thrust: 9, windup: 0.4, active: 0.14, recovery: 0.6, stamina: 10, lunge: 80),
            ],
        ),
        (
            id: "club", art: "club", harm: blunt,
            damage: 30, knock: 450, stun: 0.5, rest: -60,
            moves: [
                (name: "smash", from: 120, to: -75, windup: 0.5, active: 0.16, recovery: 0.55, stamina: 40, lunge: 45),
                (name: "sweep", from: -75, to: 70, windup: 0.4, active: 0.2, recovery: 0.5, stamina: 40, lunge: 30),
            ],
            dash: (name: "leaping smash", from: 130, to: -70, windup: 0.1, active: 0.2, recovery: 0.3, stamina: 22, lunge: 90, hop: 260, damage: 1.5, knock: 1.4, slam: 16),
        ),
    ],    // Bows (archery.rs): hold to draw (fully in `draw` s), let go to loose;
    // the arrow's speed (cells/s), damage and knockback go from the first
    // to the second by how far it was drawn. (It shows only while drawn.)
    bows: [
        (id: "bow", art: "bow", draw: 0.65, speed: (255, 660), damage: (5, 20), knock: (60, 255), stun: 0.15, stamina: 6),
    ],
    // Arrows fly and fall (`gravity` cells/s²), stick where they strike
    // stone or earth for `stuck` s, come back to you within `pickup`
    // cells; through fire or lava they catch and burn for `burn` s,
    // setting alight what they strike (water puts them out).
    arrow: (art: "arrow", gravity: 540, stuck: 60, pickup: 18, burn: 6),
    // Everything else you hold, by its icon's shape (icons.ron): drawn from
    // the sprite of that name (assets/art/<shape>.ron: pointing right, a
    // `grip`), in the item's icon colours with `recolor` (one pickaxe
    // drawing, every tier), held at `rest` degrees and pointed where it's
    // used (a wand casting, a bomb thrown, a torch planted). With `swing`,
    // it's swung like a blade whenever it's used (a pickaxe mining, an axe
    // chopping: it can hit what's in the way too); `burns`: alight in the
    // hand (a flame and light, like a planted torch).
    held: {
        "pickaxe": (rest: -35, recolor: true, swing: (harm: pierce, damage: 5, knock: 120, stun: 0.1, moves: [
            (name: "pick", from: 105, to: -50, windup: 0.04, active: 0.07, recovery: 0.03, stamina: 0),
        ])),
        "axe": (rest: -35, recolor: true, swing: (damage: 8, knock: 165, stun: 0.12, moves: [
            (name: "chop", from: 110, to: -45, windup: 0.05, active: 0.08, recovery: 0.05, stamina: 0),
        ])),
        "wand": (rest: -35, recolor: true),
        "staff": (rest: 75, recolor: true),
        "torch": (rest: 75, burns: true),
        "bomb": (rest: 0, recolor: true),
        "glowstick": (rest: 70, recolor: true),
        "potion": (rest: 0, recolor: true),
    },
)
