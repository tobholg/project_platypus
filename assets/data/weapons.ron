// Weapons held in the hand (SPEC 6.2). Each is drawn from its sprite
// (assets/art/<art>.ron: pointing right, its `grip` anchor where the hand
// holds it), turned to every angle it can point; those same pictures are
// what hits (pixel against the target's pixels).
//
// damage, knock (cells/s), stun (s): per hit, before a move's multipliers.
// rest: how it's held when not swinging (degrees from level; + up).
// moves: the combo, in order (pressing again during one queues the next;
//   a pause of `combo_gap` s starts over). Each:
//   from, to: the swing, in degrees from where it's aimed (+ up, facing
//     right; mirrored facing left); it gets there in `windup` s, sweeps
//     in `active` s (what it touches then is hit, each thing once), holds
//     for `recovery` s.
//   thrust: cells the blade drives forward at the middle of the sweep.
//   stamina: its cost (none left: no swing). lunge: cells/s forward as
//     it starts (on the ground). damage, knock: multipliers.
// Striking downward in the air, a hit bounces you up (a pogo).
(
    combo_gap: 0.35,
    pogo: 300,
    // Sparks where a blade bites flesh, and where it rings off stone; the
    // smear the outer part of the blade leaves as it sweeps (`trail`: motes
    // for every fourth pixel of it, each turn of the sweep).
    hit: (count: 12, life: (0.08, 0.22), colors: [(255, 255, 240), (255, 230, 150), (200, 120, 60)], speed: 120, spread: 0.9, drag: 5),
    trail: (count: 1, life: (0.03, 0.08), colors: [(255, 255, 255), (220, 232, 255), (170, 190, 235)], speed: 3, drag: 8),
    clang: (count: 7, life: (0.06, 0.18), colors: [(255, 255, 255), (255, 220, 120)], speed: 140, spread: 1.2, drag: 5, gravity: 200, glow: true),
    weapons: [
        (
            id: "shortsword", art: "shortsword",
            damage: 12, knock: 150, stun: 0.18, rest: -35,
            moves: [
                (name: "slash", from: 105, to: -75, windup: 0.05, active: 0.09, recovery: 0.09, stamina: 8, lunge: 50),
                (name: "backslash", from: -75, to: 100, windup: 0.04, active: 0.09, recovery: 0.1, stamina: 8, lunge: 40),
                (name: "thrust", from: 0, to: 0, thrust: 5, windup: 0.07, active: 0.08, recovery: 0.13, stamina: 11, lunge: 130, damage: 1.4, knock: 1.3),
            ],
        ),
        (
            id: "longsword", art: "longsword",
            damage: 24, knock: 250, stun: 0.3, rest: -30,
            moves: [
                (name: "cleave", from: 125, to: -95, windup: 0.13, active: 0.15, recovery: 0.18, stamina: 16, lunge: 40),
                (name: "sweep", from: -95, to: 115, windup: 0.09, active: 0.15, recovery: 0.2, stamina: 16, lunge: 30),
                (name: "drive", from: 5, to: -5, thrust: 7, windup: 0.15, active: 0.1, recovery: 0.24, stamina: 22, lunge: 170, damage: 1.6, knock: 1.5),
            ],
        ),
        // Enemies' weapons: slower, with windups to read.
        (
            id: "cleaver", art: "cleaver",
            damage: 11, knock: 170, stun: 0.25, rest: -40,
            moves: [
                (name: "hack", from: 110, to: -70, windup: 0.26, active: 0.11, recovery: 0.2, stamina: 14, lunge: 60),
                (name: "backhack", from: -70, to: 95, windup: 0.18, active: 0.11, recovery: 0.3, stamina: 14, lunge: 40),
            ],
        ),
        (
            id: "club", art: "club",
            damage: 30, knock: 300, stun: 0.5, rest: -60,
            moves: [
                (name: "smash", from: 120, to: -75, windup: 0.5, active: 0.16, recovery: 0.55, stamina: 40, lunge: 30),
                (name: "sweep", from: -75, to: 70, windup: 0.4, active: 0.2, recovery: 0.5, stamina: 40, lunge: 20),
            ],
        ),
    ],
)
