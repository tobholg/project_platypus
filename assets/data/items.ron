// Made things: tools, lights, throwables. Every solid or powder material has
// a block item too (id "block:<material>"), made from materials.ron.
//
// stack: most in one slot · color: icon colour until items have sprites
// use:
//   Mine(back, power, tier, speed, reach, area): a pickaxe (back: false) or an axe
//     (back: true, the background: trees, walls); power damage a hit, speed
//     hits a second, up to tier hardness, within reach blocks (6 cells each).
//     area (a pickaxe's, cells): C switches it to a round bite this radius
//     out of the rock nearest you toward the cursor (it can't reach through
//     rock), at 3/4 of its power, a little less towards the rim; big enough
//     to dig straight down and fall down the shaft as you go.
//     Hardness: dirt 20, wood 25, sandstone 35, copper ore 50, stone 60,
//     amethyst 60, iron ore 65, brick 70, silver ore 75, slate 80, emerald 80,
//     gold ore 85, basalt 95, ruby 100, mithril ore 110, obsidian 120.
//     Pickaxe tiers climb with them: copper 70, iron 100, gold 115, mithril 150.
//   Throw(Bomb | Glowstick) · Torch: plant one on a block face
//   Focus(tier, element, spells): a wand (tier 1, one spell) or staff (tier
//     2, two: left and right button) casting its spells (spells.ron) at the
//     cursor; the element it favours (optional). Found in the world, it
//     rolls its spells instead, from its element's up to its tier.
// aura: (light, strength, sparks: an emitter as in runes.ron `look`, `count`
//   a second; casting: times as many while it's used): what it gives off
//   at its tip while held
// about: a line for its tooltip
// category: what sort of thing it is (Tools, Weapons, Armour, Accessories,
//   Lights, Magic, Potions, Furniture, Building, Materials, Other), for the
//   crafting panel's tabs and quick sort; only where what it does doesn't
//   say (an arrow: Weapons)
//   Bow(bow): a bow (weapons.ron): hold the left button to draw, let go to
//     loose an arrow (one of your `arrow` items) at the cursor.
//   Melee(weapon): a weapon (weapons.ron): the left button swings it at the
//     cursor; hold it to swing through the combo. Its icon is its sprite.
//   Chest: place one (furniture, 18 × 15 cells, on the ground); right-click a chest to open it
//   Potion(heal, over, sickness): drink it (click, or H: the first healing
//     one carried): heal health back over `over` s (0: at once), then
//     `sickness` s when no healing potion works
//   Station(id): place a crafting station (crafting.ron); a pickaxe knocks it back
// gear: (slot: Held, stats: {..}): counts toward its holder's stats while
//   in the hand, and can be found rarer (gear.ron has the rest of the gear);
//   on_hit: a coating (coatings.ron) left on what it hits ("venom")
(
    items: [
        // The picks, each a big step up: copper three strikes to a stone block
        // (0.86 s), iron two (0.44 s), gold two (0.36 s), mithril one (0.14 s);
        // their area bites (C) wider each time.
        (id: "copper_pickaxe", name: "Copper pickaxe", color: (205, 127, 50), use: Mine(back: false, power: 25, tier: 70, speed: 3.5, reach: 6.0, area: 7.0)),
        (id: "iron_pickaxe",   name: "Iron pickaxe",   color: (176, 178, 190), use: Mine(back: false, power: 35, tier: 100, speed: 4.5, reach: 6.5, area: 9.0)),
        (id: "gold_pickaxe",   name: "Gold pickaxe",   color: (236, 196, 72), use: Mine(back: false, power: 50, tier: 115, speed: 5.5, reach: 7.0, area: 10.5)),
        (id: "mithril_pickaxe", name: "Mithril pickaxe", color: (110, 220, 228), use: Mine(back: false, power: 75, tier: 150, speed: 7.0, reach: 7.5, area: 13.5)),
        // A builder's hammer: shapes built blocks (half, slopes) for roofs
        // and arches.
        (id: "hammer",         name: "Hammer",         color: (150, 140, 130), use: Hammer(reach: 6.0)),
        (id: "copper_axe",     name: "Copper axe",     color: (190, 110, 45), use: Mine(back: true, power: 30, tier: 60, speed: 5.0, reach: 6.0)),
        // Lights: a torch is planted (from the hotbar) or held in the off
        // hand (the off-hand slot: worn, as gear is); the rest only held.
        (id: "torch",          name: "Torch",          stack: 99, color: (255, 190, 90), use: Torch, light: Torch),
        (id: "pocket_flashlight", name: "Pocket flashlight", color: (200, 200, 190), light: Pocket,
            about: "A small beam where you point it. Wear it in the off hand."),
        (id: "flashlight",     name: "Flashlight",     color: (214, 218, 226), light: Flashlight,
            about: "A long, bright beam where you point it. Wear it in the off hand."),
        (id: "lantern",        name: "Lantern",        color: (255, 214, 140), light: Lantern,
            about: "A steady glow all round you. Wear it in the off hand."),
        (id: "bomb",           name: "Bomb",           stack: 30, color: (40, 40, 46), use: Throw(Bomb)),
        (id: "glowstick",      name: "Glow stick",     stack: 30, color: (90, 255, 150), use: Throw(Glowstick)),
        // Potions: click to drink (or H, the first healing one carried).
        // Healing comes back 10 a second: over = heal / 10.
        (id: "small_health_potion", name: "Small health potion", stack: 30, color: (230, 60, 80), use: Potion(heal: 40, over: 4, sickness: 30),
            about: "A small red flask."),
        // Foci (magic::spells): each holds its spells (a wand one, a staff
        // two: left and right button), of its tier or less (a wand 1, a staff
        // 2); its element is the one it favours (its stats: that element's
        // power). One found in the world rolls its spells from its element's
        // (any, with none). Its aura: the glow and sparks at its tip.
        (id: "oak_wand",       name: "Oak wand",       color: (150, 110, 70), use: Focus(tier: 1, spells: ["spark_bolt"]),
            gear: (slot: Held, stats: { SpellPower: 5, CastSpeed: 5 }),
            aura: (light: (220, 200, 255), strength: 0.4, sparks: (count: 4, life: (0.5, 1.0), colors: [(255, 255, 255), (200, 170, 255)], speed: 8, drag: 1, glow: true))),
        (id: "storm_wand",     name: "Storm wand",     color: (200, 220, 255), use: Focus(tier: 1, element: Storm, spells: ["shock_bolt"]),
            gear: (slot: Held, stats: { StormPower: 40, CastSpeed: 5 }),
            aura: (light: (190, 200, 255), sparks: (count: 12, life: (0.05, 0.15), colors: [(255, 255, 255), (160, 180, 255)], speed: 45, jitter: 180, glow: true))),
        (id: "fire_wand",      name: "Fire wand",      color: (255, 120, 40), use: Focus(tier: 1, element: Fire, spells: ["fireball"]),
            gear: (slot: Held, stats: { FirePower: 40, CastSpeed: 5 }),
            aura: (light: (255, 140, 50), strength: 0.8, sparks: (count: 14, life: (0.3, 0.7), colors: [(255, 240, 180), (255, 160, 50), (200, 60, 20)], speed: 27, spread: 0.6, gravity: -60, drag: 2, glow: true))),
        (id: "acid_wand",      name: "Acid wand",      color: (120, 230, 60), use: Focus(tier: 1, element: Acid, spells: ["acid_arrow"]),
            gear: (slot: Held, stats: { AcidPower: 40, CastSpeed: 5 }),
            aura: (light: (130, 240, 70), strength: 0.5, sparks: (count: 5, life: (0.4, 0.8), colors: [(200, 255, 120), (90, 200, 40)], speed: 3, spread: 0.3, gravity: 240, glow: true))),
        (id: "frost_wand",     name: "Frost wand",     color: (170, 220, 255), use: Focus(tier: 1, element: Frost, spells: ["frost_bolt"]),
            gear: (slot: Held, stats: { FrostPower: 40, CastSpeed: 5 }),
            aura: (light: (140, 200, 255), sparks: (count: 10, life: (0.5, 1.0), colors: [(240, 250, 255), (170, 215, 255)], speed: 9, gravity: 30, drag: 3, glow: true))),
        (id: "gravity_wand",   name: "Gravity wand",   color: (150, 110, 255), use: Focus(tier: 1, element: Gravity, spells: ["gravity_well"]),
            gear: (slot: Held, stats: { GravityPower: 40 }),
            aura: (light: (160, 120, 255), sparks: (count: 10, life: (0.4, 0.8), colors: [(220, 200, 255), (120, 80, 230), (40, 20, 90)], speed: 21, drag: 1, glow: true))),
        (id: "force_wand",     name: "Force wand",     color: (140, 200, 255), use: Focus(tier: 1, element: Force, spells: ["force"]),
            gear: (slot: Held, stats: { ForcePower: 40 }),
            aura: (light: (150, 210, 255), sparks: (count: 8, life: (0.1, 0.3), colors: [(240, 250, 255), (140, 195, 255)], speed: 33, drag: 4, glow: true))),
        (id: "arcane_staff",   name: "Arcane staff",   color: (170, 120, 230), use: Focus(tier: 2, spells: ["frost_bolt", "acid_arrow"]),
            gear: (slot: Held, stats: { SpellPower: 25, Mana: 40, ManaRegen: 15 }),
            aura: (light: (220, 200, 255), strength: 0.4, sparks: (count: 4, life: (0.5, 1.0), colors: [(255, 255, 255), (200, 170, 255)], speed: 8, drag: 1, glow: true))),
        (id: "fire_staff",     name: "Fire staff",     color: (255, 150, 50), use: Focus(tier: 2, element: Fire, spells: ["flame_jet", "meteor"]),
            gear: (slot: Held, stats: { FirePower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (255, 140, 50), strength: 0.8, sparks: (count: 14, life: (0.3, 0.7), colors: [(255, 240, 180), (255, 160, 50), (200, 60, 20)], speed: 27, spread: 0.6, gravity: -60, drag: 2, glow: true))),
        (id: "storm_staff",    name: "Storm staff",    color: (200, 220, 255), use: Focus(tier: 2, element: Storm, spells: ["lightning", "call_lightning"]),
            gear: (slot: Held, stats: { StormPower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (190, 200, 255), sparks: (count: 12, life: (0.05, 0.15), colors: [(255, 255, 255), (160, 180, 255)], speed: 45, jitter: 180, glow: true))),
        (id: "gravity_staff",  name: "Gravity staff",  color: (150, 110, 255), use: Focus(tier: 2, element: Gravity, spells: ["great_well", "force"]),
            gear: (slot: Held, stats: { GravityPower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (160, 120, 255), sparks: (count: 10, life: (0.4, 0.8), colors: [(220, 200, 255), (120, 80, 230), (40, 20, 90)], speed: 21, drag: 1, glow: true))),
        (id: "force_staff",    name: "Force staff",    color: (140, 200, 255), use: Focus(tier: 2, element: Force, spells: ["great_force", "force"]),
            gear: (slot: Held, stats: { ForcePower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (150, 210, 255), sparks: (count: 8, life: (0.1, 0.3), colors: [(240, 250, 255), (140, 195, 255)], speed: 33, drag: 4, glow: true))),
        (id: "radiant_wand",   name: "Radiant wand",   color: (255, 236, 160), use: Focus(tier: 1, element: Radiant, spells: ["spark_bolt"]),
            gear: (slot: Held, stats: { RadiantPower: 40, CastSpeed: 5 }),
            aura: (light: (255, 240, 190), strength: 0.7, sparks: (count: 10, life: (0.3, 0.8), colors: [(255, 255, 255), (255, 235, 150), (255, 190, 80)], speed: 12, drag: 2, glow: true))),
        (id: "radiant_staff",  name: "Radiant staff",  color: (255, 236, 160), use: Focus(tier: 2, element: Radiant, spells: ["vaporiser", "star_bomb"]),
            gear: (slot: Held, stats: { RadiantPower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (255, 240, 190), strength: 0.8, sparks: (count: 12, life: (0.3, 0.8), colors: [(255, 255, 255), (255, 235, 150), (255, 190, 80)], speed: 12, drag: 2, glow: true))),
        (id: "frost_staff",    name: "Frost staff",    color: (170, 220, 255), use: Focus(tier: 2, element: Frost, spells: ["frost_ray", "ice_wall"]),
            gear: (slot: Held, stats: { FrostPower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (140, 200, 255), sparks: (count: 10, life: (0.5, 1.0), colors: [(240, 250, 255), (170, 215, 255)], speed: 9, gravity: 30, drag: 3, glow: true))),
        // A frost wraith's breath, caught in a staff (one in a few of them
        // leave one): hold for a cone of ice, fierce up close.
        (id: "rimebreath_staff", name: "Rimebreath staff", color: (200, 235, 255), use: Focus(tier: 2, element: Frost, spells: ["frost_breath", "ice_wall"]),
            gear: (slot: Held, stats: { FrostPower: 35, SpellPower: 10, Mana: 30 }),
            aura: (light: (160, 215, 255), sparks: (count: 14, life: (0.5, 1.2), colors: [(255, 255, 255), (200, 235, 255), (150, 200, 245)], speed: 12, gravity: -10, drag: 3, glow: true))),
        (id: "blaze_staff",    name: "Blaze staff",    color: (255, 110, 40), use: Focus(tier: 2, element: Fire, spells: ["fire_ray", "fire_wall"]),
            gear: (slot: Held, stats: { FirePower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (255, 140, 50), strength: 0.8, sparks: (count: 16, life: (0.3, 0.7), colors: [(255, 240, 180), (255, 160, 50), (200, 60, 20)], speed: 27, spread: 0.6, gravity: -60, drag: 2, glow: true))),
        (id: "acid_staff",     name: "Acid staff",     color: (120, 230, 60), use: Focus(tier: 2, element: Acid, spells: ["acid_jet", "toxic_cloud"]),
            gear: (slot: Held, stats: { AcidPower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (130, 240, 70), strength: 0.6, sparks: (count: 6, life: (0.4, 0.9), colors: [(200, 255, 120), (140, 110, 160), (90, 200, 40)], speed: 5, spread: 0.4, gravity: 180, glow: true))),
        (id: "void_wand",      name: "Void wand",      color: (150, 110, 240), use: Focus(tier: 1, element: Void, spells: ["blink_bolt"]),
            gear: (slot: Held, stats: { VoidPower: 40, CastSpeed: 5 }),
            aura: (light: (160, 120, 255), strength: 0.5, sparks: (count: 8, life: (0.3, 0.8), colors: [(230, 210, 255), (140, 90, 240), (40, 20, 90)], speed: 9, drag: 2, glow: true))),
        (id: "void_staff",     name: "Void staff",     color: (150, 110, 240), use: Focus(tier: 2, element: Void, spells: ["portal", "stasis"]),
            gear: (slot: Held, stats: { VoidPower: 50, SpellPower: 10, Mana: 20 }),
            aura: (light: (160, 120, 255), strength: 0.6, sparks: (count: 10, life: (0.3, 0.9), colors: [(230, 210, 255), (140, 90, 240), (40, 20, 90)], speed: 9, drag: 2, glow: true))),
        (id: "shortsword",     name: "Shortsword",     color: (200, 206, 216), use: Melee("shortsword"), gear: (slot: Held),
            about: "Quick: slash, backslash, thrust. Strike down in the air to bounce off what you hit."),
        (id: "longsword",      name: "Longsword",      color: (180, 188, 204), use: Melee("longsword"), gear: (slot: Held),
            about: "Slow and heavy: cleave, sweep, drive. Strike down in the air to bounce off what you hit."),
        // What enemies fight with (found on their bodies).
        (id: "cleaver",        name: "Cleaver",        color: (170, 170, 176), use: Melee("cleaver"), gear: (slot: Held),
            about: "An orc's: heavy hacks with a windup to read."),
        (id: "rusty_sword",    name: "Rusty sword",    color: (140, 110, 90), use: Melee("rusty_sword"), gear: (slot: Held, stats: { Damage: -10 }),
            about: "A skeleton's, pitted with rust."),
        (id: "club",           name: "Club",           color: (120, 90, 60), use: Melee("club"), gear: (slot: Held),
            about: "A troll's: slow, and it sends things flying."),
        // Uniques: legendary, and the same every time.
        (id: "trolls_club",    name: "The Troll's Club", color: (150, 110, 70), use: Melee("club"),
            gear: (slot: Held, unique: true, stats: { Damage: 25, Knockback: 80, Poise: 15, AttackSpeed: 10 }),
            about: "Knotted, bloodied, older than the troll that swung it. What it hits flies."),
        (id: "broodmother_fang", name: "The Broodmother's Fang", color: (60, 50, 70), use: Melee("fang"),
            gear: (slot: Held, unique: true, stats: { Crit: 15, CritDamage: 40, AttackSpeed: 25 }, on_hit: "venom"),
            about: "Torn from the mother of a nest. Its venom still burns what it cuts."),
        (id: "bow",            name: "Bow",            color: (150, 104, 58), use: Bow("bow"), gear: (slot: Held),
            about: "Hold to draw, let go to loose an arrow: the longer drawn, the harder and further. Arrows stick where they land; walk near to pick them up. Loose one through fire and it burns."),
        (id: "arrow",          name: "Arrow",          stack: 99, color: (176, 136, 84), category: Weapons),
        (id: "chest",          name: "Chest",          stack: 20, color: (150, 104, 58), use: Chest),
        // Crafting (crafting.ron): stations to set down, and bars smelted
        // from ore.
        (id: "workbench",      name: "Workbench",      stack: 10, color: (176, 124, 70), use: Station("workbench"),
            about: "Set it down; more can be made near it."),
        (id: "door", name: "Door", stack: 20, color: (120, 80, 44), use: Door,
            about: "Set it in a gap on a floor, three blocks tall; right-click it to open or shut it."),
        // Furniture (crafting.ron: stations with no recipes of their own).
        (id: "table", name: "Table", stack: 20, color: (140, 96, 52), use: Station("table")),
        (id: "chair", name: "Chair", stack: 20, color: (140, 96, 52), use: Station("chair")),
        (id: "bookcase", name: "Bookcase", stack: 20, color: (104, 68, 38), use: Station("bookcase")),
        (id: "bed", name: "Bed", stack: 20, color: (150, 38, 44), use: Station("bed")),
        (id: "barrel", name: "Barrel", stack: 20, color: (140, 96, 52), use: Station("barrel")),
        (id: "crate", name: "Crate", stack: 20, color: (140, 96, 52), use: Station("crate")),
        (id: "potted_plant", name: "Potted plant", stack: 20, color: (80, 168, 70), use: Station("potted_plant")),
        (id: "candelabra", name: "Candelabra", stack: 20, color: (180, 180, 190), use: Station("candelabra")),
        (id: "hearth", name: "Hearth", stack: 20, color: (140, 138, 146), use: Station("hearth")),
        (id: "hanging_lantern", name: "Hanging lantern", stack: 20, color: (255, 210, 110), use: Station("hanging_lantern")),
        (id: "chandelier", name: "Chandelier", stack: 20, color: (255, 210, 110), use: Station("chandelier")),
        (id: "banner_red", name: "Red banner", stack: 20, color: (140, 30, 40), use: Station("banner_red")),
        (id: "banner_green", name: "Green banner", stack: 20, color: (36, 110, 56), use: Station("banner_green")),
        (id: "painting", name: "Painting", stack: 20, color: (200, 160, 60), use: Station("painting")),
        (id: "wall_shelf", name: "Wall shelf", stack: 20, color: (176, 124, 70), use: Station("wall_shelf")),
        (id: "furnace",        name: "Furnace",        stack: 10, color: (120, 118, 124), use: Station("furnace"),
            about: "Set it down; smelts ore into bars."),
        (id: "anvil",          name: "Anvil",          stack: 10, color: (170, 174, 186), use: Station("anvil"),
            about: "Set it down; bars become tools, arms, armour and hooks here."),
        (id: "arcane_altar",   name: "Arcane altar",   stack: 10, color: (170, 120, 240), use: Station("arcane_altar"),
            about: "Set it down; wands and staffs are made here."),
        // Vessels (casting, carrying): RMB fills (scoops at the cursor; at a
        // furnace, melts bars and ore from the pack into it), LMB pours.
        (id: "ladle",          name: "Ladle",          color: (120, 110, 110), use: Vessel(holds: 144, hot: true),
            about: "A crucible on a handle: carries molten metal from a furnace to your mould."),
        (id: "bucket",         name: "Bucket",         color: (150, 150, 160), use: Vessel(holds: 144),
            about: "Carries water, oil or the like."),
        (id: "flask",          name: "Flask",          color: (170, 220, 200), use: Vessel(holds: 36, acidproof: true),
            about: "Glass: carries a little of anything cool, acid too."),
        // A bar is its metal's block (materials.ron `item`): 36 cells of it.
        // What a chain wraith leaves: its chains, cold to the touch.
        (id: "wraith_chain",   name: "Wraith chain",   stack: 99, color: (120, 140, 176),
            about: "A length of a chain wraith's chain, cold, faintly there."),
        (id: "copper_bar",     name: "Copper bar",     stack: 99, color: (205, 127, 50)),
        (id: "iron_bar",       name: "Iron bar",       stack: 99, color: (176, 178, 190)),
        (id: "silver_bar",     name: "Silver bar",     stack: 99, color: (214, 218, 230)),
        (id: "gold_bar",       name: "Gold bar",       stack: 99, color: (236, 196, 72)),
        (id: "mithril_bar",    name: "Mithril bar",    stack: 99, color: (110, 220, 228)),
    ],
    // Kits: what a new player starts with (`play` in a new game, `dev` in
    // dev mode: `mode.rs`), and more for the dev menu to hand out. Carried
    // first-come into the hotbar (ten slots), then the pack; worn on the body.
    kits: [
        (name: "play", about: "A new game: a copper pick and axe, a short sword, a few torches, a rope hook",
            carry: [("copper_pickaxe", 1), ("copper_axe", 1), ("shortsword", 1), ("torch", 8), ("small_health_potion", 2)],
            wear: ["rope_hook"]),
        // Loadouts (dev): in place of all you have, a stage of the game as
        // it would be played (the first ten carried go in the hotbar).
        (name: "beginner", loadout: true, about: "First steps down: copper tools, a short sword, a rope hook, a little leather",
            carry: [("copper_pickaxe", 1), ("copper_axe", 1), ("shortsword", 1), ("torch", 20), ("bomb", 3), ("small_health_potion", 3), ("block:platform", 20)],
            wear: ["rope_hook", "leather_cap", "leather_jerkin"]),
        (name: "explorer", loadout: true, about: "Early to mid: an iron pick, swords and a bow, weak wands, feather boots, a grappling hook, leather",
            carry: [
                ("iron_pickaxe", 1), ("copper_axe", 1), ("shortsword", 1), ("longsword", 1), ("bow", 1), ("radiant_wand", 1), ("fire_wand", 1), ("torch", 40), ("bomb", 8), ("small_health_potion", 6),
                ("frost_wand", 1), ("arrow", 150), ("glowstick", 10), ("block:platform", 60), ("pocket_flashlight", 1),
            ],
            wear: ["feather_boots", "grappling_hook", "leather_cap", "leather_jerkin", "leather_gloves", "leather_trousers", "wooden_shield", "ring_of_vigour"]),
        (name: "delver", loadout: true, about: "Mid game: a gold pick, staffs, rocket boots, a chain hook, iron and a mining helmet",
            carry: [
                ("gold_pickaxe", 1), ("longsword", 1), ("cleaver", 1), ("bow", 1), ("fire_staff", 1), ("frost_staff", 1), ("storm_staff", 1), ("torch", 60), ("bomb", 20), ("small_health_potion", 12),
                ("acid_staff", 1), ("radiant_staff", 1), ("copper_axe", 1), ("arrow", 300), ("glowstick", 20), ("block:platform", 150),
            ],
            wear: ["rocket_boots", "chain_hook", "mining_helmet", "chainmail", "iron_gauntlets", "iron_greaves", "iron_shield", "travelers_cape", "ember_amulet", "ring_of_vigour"]),
        (name: "dev", loadout: true, about: "Everything worth trying (a flashlight in the off hand, a mining helmet in the pack)",
            carry: [
