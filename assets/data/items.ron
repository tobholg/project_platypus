            aura: (light: (255, 140, 50), strength: 0.8, sparks: (count: 14, life: (0.3, 0.7), colors: [(255, 240, 180), (255, 160, 50), (200, 60, 20)], speed: 18, spread: 0.6, gravity: -40, drag: 2, glow: true))),
        (id: "acid_wand",      name: "Acid wand",      color: (120, 230, 60), use: Focus(tier: 1, element: Acid, spells: ["acid_arrow"]),
