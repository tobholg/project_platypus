// Made things: tools, lights, throwables. Every solid or powder material has
// a block item too (id "block:<material>"), made from materials.ron.
//
// stack: most in one slot · color: icon colour until items have sprites
// use:
//   Mine(back, power, tier, speed, reach): a pickaxe (back: false) or an axe
//     (back: true, the background: trees, walls); power damage a hit, speed
//     hits a second, up to tier hardness, within reach blocks (4 cells each).
//     Hardness: dirt 20, wood 25, sandstone 35, copper ore 50, stone 60,
//     amethyst 60, iron ore 65, brick 70, silver ore 75, slate 80, emerald 80,
//     gold ore 85, basalt 95, ruby 100, mithril ore 110, obsidian 120.
//     Pickaxe tiers climb with them: copper 70, iron 100, gold 115, mithril 150.
//   Throw(Bomb | Glowstick) · Torch: plant one on a block face
//   Focus(tier, element): a wand (tier 1) or staff (tier 2): hold to cast
//     the spell ready (spells.ron; Q: the next) at the cursor, if its tier
//     is no more than the focus's; the element it favours (optional)
// about: a line for its tooltip
//   Bow(bow): a bow (weapons.ron): hold the left button to draw, let go to
//     loose an arrow (one of your `arrow` items) at the cursor.
//   Melee(weapon): a weapon (weapons.ron): the left button swings it at the
//     cursor; hold it to swing through the combo. Its icon is its sprite.
//   Chest: place one (furniture, 12 × 10 cells, on the ground); right-click a chest to open it
// gear: (slot: Held, stats: {..}): counts toward its holder's stats while
//   in the hand, and can be found rarer (gear.ron has the rest of the gear)
(
    items: [
        (id: "copper_pickaxe", name: "Copper pickaxe", color: (205, 127, 50), use: Mine(back: false, power: 35, tier: 70, speed: 6.0, reach: 6.0)),
        (id: "iron_pickaxe",   name: "Iron pickaxe",   color: (176, 178, 190), use: Mine(back: false, power: 60, tier: 100, speed: 7.0, reach: 6.5)),
        (id: "gold_pickaxe",   name: "Gold pickaxe",   color: (236, 196, 72), use: Mine(back: false, power: 75, tier: 115, speed: 7.5, reach: 7.0)),
        (id: "mithril_pickaxe", name: "Mithril pickaxe", color: (110, 220, 228), use: Mine(back: false, power: 100, tier: 150, speed: 9.0, reach: 7.5)),
        (id: "copper_axe",     name: "Copper axe",     color: (190, 110, 45), use: Mine(back: true, power: 30, tier: 60, speed: 5.0, reach: 6.0)),
        (id: "torch",          name: "Torch",          stack: 99, color: (255, 190, 90), use: Torch),
        (id: "bomb",           name: "Bomb",           stack: 30, color: (40, 40, 46), use: Throw(Bomb)),
        (id: "glowstick",      name: "Glow stick",     stack: 30, color: (90, 255, 150), use: Throw(Glowstick)),
        // Foci (magic::spells): a wand is tier 1, a staff tier 2; a spell
        // needs a focus of its tier or more in the hand. Its element is the
        // one it favours (its stats: that element's power); taking it up
        // readies the strongest spell of that element it can cast.
        (id: "oak_wand",       name: "Oak wand",       color: (150, 110, 70), use: Focus(tier: 1),
            gear: (slot: Held, stats: { SpellPower: 5, CastSpeed: 5 })),
        (id: "storm_wand",     name: "Storm wand",     color: (200, 220, 255), use: Focus(tier: 1, element: Storm),
            gear: (slot: Held, stats: { StormPower: 40, CastSpeed: 5 })),
        (id: "fire_wand",      name: "Fire wand",      color: (255, 120, 40), use: Focus(tier: 1, element: Fire),
            gear: (slot: Held, stats: { FirePower: 40, CastSpeed: 5 })),
        (id: "acid_wand",      name: "Acid wand",      color: (120, 230, 60), use: Focus(tier: 1, element: Acid),
            gear: (slot: Held, stats: { AcidPower: 40, CastSpeed: 5 })),
        (id: "frost_wand",     name: "Frost wand",     color: (170, 220, 255), use: Focus(tier: 1, element: Frost),
            gear: (slot: Held, stats: { FrostPower: 40, CastSpeed: 5 })),
        (id: "gravity_wand",   name: "Gravity wand",   color: (150, 110, 255), use: Focus(tier: 1, element: Gravity),
            gear: (slot: Held, stats: { GravityPower: 40 })),
        (id: "force_wand",     name: "Force wand",     color: (140, 200, 255), use: Focus(tier: 1, element: Force),
            gear: (slot: Held, stats: { ForcePower: 40 })),
        (id: "arcane_staff",   name: "Arcane staff",   color: (170, 120, 230), use: Focus(tier: 2),
            gear: (slot: Held, stats: { SpellPower: 25, Mana: 40, ManaRegen: 15 })),
        (id: "fire_staff",     name: "Fire staff",     color: (255, 150, 50), use: Focus(tier: 2, element: Fire),
            gear: (slot: Held, stats: { FirePower: 50, SpellPower: 10, Mana: 20 })),
        (id: "storm_staff",    name: "Storm staff",    color: (200, 220, 255), use: Focus(tier: 2, element: Storm),
            gear: (slot: Held, stats: { StormPower: 50, SpellPower: 10, Mana: 20 })),
        (id: "gravity_staff",  name: "Gravity staff",  color: (150, 110, 255), use: Focus(tier: 2, element: Gravity),
            gear: (slot: Held, stats: { GravityPower: 50, SpellPower: 10, Mana: 20 })),
        (id: "force_staff",    name: "Force staff",    color: (140, 200, 255), use: Focus(tier: 2, element: Force),
            gear: (slot: Held, stats: { ForcePower: 50, SpellPower: 10, Mana: 20 })),
        (id: "shortsword",     name: "Shortsword",     color: (200, 206, 216), use: Melee("shortsword"), gear: (slot: Held),
            about: "Quick: slash, backslash, thrust. Strike down in the air to bounce off what you hit."),
        (id: "longsword",      name: "Longsword",      color: (180, 188, 204), use: Melee("longsword"), gear: (slot: Held),
            about: "Slow and heavy: cleave, sweep, drive. Strike down in the air to bounce off what you hit."),
        (id: "bow",            name: "Bow",            color: (150, 104, 58), use: Bow("bow"), gear: (slot: Held),
            about: "Hold to draw, let go to loose an arrow: the longer drawn, the harder and further. Arrows stick where they land; walk near to pick them up. Loose one through fire and it burns."),
        (id: "arrow",          name: "Arrow",          stack: 99, color: (176, 136, 84)),
        (id: "chest",          name: "Chest",          stack: 20, color: (150, 104, 58), use: Chest),
    ],
    // (The first ten are the hotbar; the rest go in the pack.)
    start: [
        ("copper_pickaxe", 1), ("copper_axe", 1), ("torch", 12), ("bomb", 5), ("block:platform", 40),
        ("storm_wand", 1), ("fire_wand", 1), ("acid_wand", 1), ("fire_staff", 1), ("storm_staff", 1),
        ("glowstick", 6), ("gravity_wand", 1), ("force_wand", 1), ("gravity_staff", 1), ("force_staff", 1), ("frost_wand", 1),
        ("shortsword", 1), ("longsword", 1), ("bow", 1), ("arrow", 60),
        ("leather_cap", 1), ("chainmail", 1), ("apprentice_robe", 1), ("feather_boots", 1), ("ring_of_vigour", 1), ("ember_amulet", 1),
        ("oak_wand", 1), ("arcane_staff", 1),
    ],
)
