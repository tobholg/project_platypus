        (id: "ladle",          name: "Ladle",          color: (120, 110, 110), use: Vessel(holds: 64, hot: true),
            about: "A crucible on a handle: carries molten metal from a furnace to your mould."),
        (id: "bucket",         name: "Bucket",         color: (150, 150, 160), use: Vessel(holds: 64),
            about: "Carries water, oil or the like."),
        (id: "flask",          name: "Flask",          color: (170, 220, 200), use: Vessel(holds: 16, acidproof: true),
            about: "Glass: carries a little of anything cool, acid too."),
