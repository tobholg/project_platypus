        (id: "workbench",      name: "Workbench",      stack: 10, color: (176, 124, 70), use: Station("workbench"),
            about: "Set it down; more can be made near it."),
        (id: "furnace",        name: "Furnace",        stack: 10, color: (120, 118, 124), use: Station("furnace"),
            about: "Set it down; smelts ore into bars."),
        (id: "anvil",          name: "Anvil",          stack: 10, color: (170, 174, 186), use: Station("anvil"),
            about: "Set it down; bars become tools, arms, armour and hooks here."),
        (id: "arcane_altar",   name: "Arcane altar",   stack: 10, color: (170, 120, 240), use: Station("arcane_altar"),
            about: "Set it down; wands and staffs are made here."),
        // Vessels (casting, carrying): RMB fills (scoops at the cursor; at a
