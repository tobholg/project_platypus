// Made things: tools, lights, throwables. Every solid or powder material has
// a block item too (id "block:<material>"), made from materials.ron.
//
// stack: most in one slot · color: icon colour until items have sprites
// use:
//   Mine(back, power, tier, speed, reach): a pickaxe (back: false) or an axe
//     (back: true, the background: trees, walls); power damage a hit, speed
//     hits a second, up to tier hardness, within reach blocks (4 cells each).
//     Hardness: dirt 20, wood 25, sandstone 35, copper ore 50, stone 60,
//     amethyst 60, iron ore 65, brick 70, silver ore 75, slate 80, emerald 80,
//     gold ore 85, basalt 95, ruby 100, mithril ore 110, obsidian 120.
//     Pickaxe tiers climb with them: copper 70, iron 100, gold 115, mithril 150.
//   Throw(Bomb | Glowstick) · Torch: plant one on a block face
//   Cast(runes, delay, recharge): a wand; hold to cast its runes (runes.ron)
//     at the cursor, one cast each `delay` s and `recharge` s after the last
//     (a channelled one, a well or force, stays open while held)
// about: a line for its tooltip
//   Chest: place one (furniture, 12 × 10 cells, on the ground); right-click a chest to open it
(
    items: [
        (id: "copper_pickaxe", name: "Copper pickaxe", color: (205, 127, 50), use: Mine(back: false, power: 35, tier: 70, speed: 6.0, reach: 6.0)),
        (id: "iron_pickaxe",   name: "Iron pickaxe",   color: (176, 178, 190), use: Mine(back: false, power: 60, tier: 100, speed: 7.0, reach: 6.5)),
        (id: "gold_pickaxe",   name: "Gold pickaxe",   color: (236, 196, 72), use: Mine(back: false, power: 75, tier: 115, speed: 7.5, reach: 7.0)),
        (id: "mithril_pickaxe", name: "Mithril pickaxe", color: (110, 220, 228), use: Mine(back: false, power: 100, tier: 150, speed: 9.0, reach: 7.5)),
        (id: "copper_axe",     name: "Copper axe",     color: (190, 110, 45), use: Mine(back: true, power: 30, tier: 60, speed: 5.0, reach: 6.0)),
        (id: "torch",          name: "Torch",          stack: 99, color: (255, 190, 90), use: Torch),
        (id: "bomb",           name: "Bomb",           stack: 30, color: (40, 40, 46), use: Throw(Bomb)),
        (id: "glowstick",      name: "Glow stick",     stack: 30, color: (90, 255, 150), use: Throw(Glowstick)),
        (id: "spark_wand",     name: "Spark wand",     color: (170, 200, 255), use: Cast(runes: ["bolt", "spark", "knock", "shatter"], delay: 0.12, recharge: 0.12)),
        (id: "fire_wand",      name: "Fireball wand",  color: (255, 120, 40), use: Cast(runes: ["trail_fire", "fire_drops", "orb", "blast", "ignite"], delay: 0.6, recharge: 0.6)),
        (id: "acid_wand",      name: "Acid wand",      color: (120, 230, 60), use: Cast(runes: ["gravity", "arrow", "acid"], delay: 0.35, recharge: 0.35)),
        (id: "flame_wand",     name: "Flame wand",     color: (255, 170, 60), use: Cast(runes: ["flame_stream"], delay: 0.03, recharge: 0.03)),
        (id: "storm_wand",     name: "Storm wand",     color: (200, 220, 255), use: Cast(runes: ["lightning"], delay: 0.7, recharge: 0.7)),
        (id: "frost_wand",     name: "Frost wand",     color: (170, 220, 255), use: Cast(runes: ["bolt", "frost"], delay: 0.3, recharge: 0.3),
            about: "Chills what it hits; freezes water it lands on (an ice patch to stand on)."),
        (id: "gravity_wand",   name: "Gravity wand",   color: (150, 110, 255), use: Cast(runes: ["gravity_well"], delay: 0.2, recharge: 0.4),
            about: "Hold: a well at the cursor lifts what it can (an orc and some rock). Swing it; let go to drop it all."),
        (id: "gravity_staff",  name: "Gravity staff",  color: (150, 110, 255), use: Cast(runes: ["gravity_well_ii"], delay: 0.2, recharge: 0.4),
            about: "A bigger well: lifts a crowd, tears out harder rock."),
        (id: "force_wand",     name: "Force wand",     color: (140, 200, 255), use: Cast(runes: ["force"], delay: 0.1, recharge: 0.2),
            about: "Hold left: push everything away from the cursor. Hold right: pull it in."),
        (id: "force_staff",    name: "Force staff",    color: (140, 200, 255), use: Cast(runes: ["force_ii"], delay: 0.1, recharge: 0.2),
            about: "Stronger force: wider, harder, tears out rock."),
        (id: "chest",          name: "Chest",          stack: 20, color: (150, 104, 58), use: Chest),
    ],
    // (The first ten are the hotbar; the rest go in the pack.)
    start: [
        ("copper_pickaxe", 1), ("copper_axe", 1), ("torch", 12), ("bomb", 5), ("block:platform", 40),
        ("spark_wand", 1), ("fire_wand", 1), ("acid_wand", 1), ("flame_wand", 1), ("storm_wand", 1),
        ("glowstick", 6), ("gravity_wand", 1), ("force_wand", 1), ("gravity_staff", 1), ("force_staff", 1), ("frost_wand", 1),
    ],
)
