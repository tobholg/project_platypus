// An orc swordsman: comes at you with a cleaver, hacks twice and backs off a
// step; a couple of solid hits stagger it. Drawn as the archer is (the
// user's reference), bare: hunched, green, a bald skull, one amber eye, a
// tusk, an iron pauldron, its cleaver from weapons.ron (assets/art/orc.ron),
// on two bent legs that step (legs.rs, `rig`), its run in step with them.
// (Its legs aren't its art's: trousers and boots it wears aren't drawn on
// them, but it has them on it.)
(
    name: "Orc",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "orc",
    // What it may wear (and the chance of each), found as gear is where it stands.
    wears: [("leather_cap", 0.5), ("leather_jerkin", 0.4), ("leather_trousers", 0.3), ("leather_boots", 0.4), ("iron_helm", 0.1)],
    size: (12, 25),
    health: 70,
    eyes: (237, 166, 31),
    team: Enemy,
    faction: "orcs",
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "humanoid",
    // Dropped from a height or flung into rock, it hurts.
    fall_damage: (safe_height: 105, per_cell: 0.53),
    movement: (
        // (Its body grown 1.2 times, canon42: these are as they were, in
        // its own body heights: `scale`.)
        scale: 1.2,
        run_speed: 93,
        jump_height: 48,
        air_jumps: 0,
        step_height: 5,
        dash_speed: 0,
    ),
    art: "orc",
    // Its legs (box 25 high: hips 14 up, under its tabard): bent green
    // legs set wide, in brown boots, the far foot back.
    legs: (view: Side, rig: true, in_step: true, reach: 16.5, upper: 0.5, step: 0.24, lift: 2.2, stride: 7, run: (11.5, 3.5, 0.8),
           color: (101, 115, 37), joint: (76, 89, 28), shin: (92, 58, 30), outline: (17, 18, 9), width: [4.0, 3.4, 3.0], toes: 5,
           body: "orc",
           each: [
               (hip: (4, 1.5), lean: 3.5, gait: 0, knee: Forward),
               (hip: (-4, 1.5), lean: -3.5, gait: 1, knee: Forward, far: true),
           ]),
    weapon: "cleaver",
    stamina: 60,
    // Hits it shrugs off before one staggers it (damage), and how hard it
    // is to throw (knockback is divided by it).
    poise: 16,
    heft: 1.2,
    brain: (
        kind: "hunter",
        params: (aggro: 330, close: Walk(keep: 20.4, jump_to_reach: 27), attack: Swing(reach: 28.8, every: 1.1, combo: 2), wander: (speed: 0.4, every: 2.5), tactics: (flee: 0.2, call: 250)),
    ),
)
