// An acid slime (toxic grottos): the slime, but full of acid, which it
// bleeds when cut and bursts with when it dies; it glows a little.
(
    name: "Acid slime",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "slime",
    size: (10, 7),
    health: 36,
    team: Enemy,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "ooze",
    profile: {acid: -0.5},
    blood: "acid",
    art: "acid_slime",
    light: (color: (150, 220, 60), strength: 0.25),
    movement: (
        run_speed: 55,
        air_accel: 400,
        jump_height: 22,
        air_jumps: 0,
        step_height: 1,
        dash_speed: 0,
    ),
    touch: (harm: acid, damage: 10, knock: 120, stun: 0.15),
    brain: (
        kind: "hunter",
        params: (aggro: 140, close: Hop(every: 1.2)),
    ),
)
