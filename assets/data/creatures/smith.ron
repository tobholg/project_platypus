            ],
            sells: [("iron_pickaxe", 60), ("gold_pickaxe", 180), ("shortsword", 70), ("longsword", 160), ("iron_helm", 90), ("chainmail", 150), ("ladle", 40), ("bucket", 30), ("block:firebrick", 3)],
