// A crag crab: a broad rocky shell on eight legs, its two big claws held
// out in front of it, seen from the side; it comes at you over the rock,
// its body tipping as its feet find the ground. A first version (BE
// `limbs`): it walks, and its touch nips; its claws snapping come with
// moves that drive limbs (and its soft back with weak points).
(
    name: "Crag crab",
    // Its box takes in its legs.
    size: (28, 24),
    health: 80,
    team: Enemy,
    kind: "beast",
    blood: "ichor",
    art: "crab_body",
    // Eight armoured legs from the side (legs.rs), four a side, knees
    // arched high, tapering to points; the near four in front of its
    // shell, the far four behind. Every other leg steps at once (the near
    // first and third with the far second and fourth). Its claws are arms
    // held out ahead, the pincers (crab_claw) at their ends.
    legs: (view: Side, reach: 24, upper: 0.5, step: 0.09, lift: 5, ride: 14, stride: 8, tilt: 22,
           color: (112, 66, 48), joint: (150, 98, 70), far: (70, 42, 32), outline: (34, 20, 16), width: [4, 3.5, 1.2], body: "crab_body",
           each: [
               (hip: (8, -1), lean: 9, gait: 0),
               (hip: (3, -1), lean: 3, gait: 1),
               (hip: (-3, -1), lean: -3, gait: 0),
               (hip: (-8, -1), lean: -9, gait: 1),
               (hip: (10, 0), lean: 11, gait: 1, far: true),
               (hip: (5, 0), lean: 5, gait: 0, far: true),
               (hip: (-1, 0), lean: -2, gait: 1, far: true),
               (hip: (-6, 0), lean: -7, gait: 0, far: true),
           ],
           arms: [
               (shoulder: (12, 2), hand: (25, 3), bones: (7.5, 7), width: [4, 4, 3.5], elbow: Down, claw: Some("crab_claw"), sway: 0.6),
               (shoulder: (13, 3), hand: (27, 5), bones: (7.5, 7), width: [4, 4, 3.5], elbow: Down, claw: Some("crab_claw"), sway: 0.6, far: true),
           ]),
    movement: (
        run_speed: 62,
        ground_accel: 700,
        ground_decel: 900,
        jump_height: 26,
        air_jumps: 0,
        step_height: 9,
        dash_speed: 0,
    ),
    poise: 26,
    heft: 1.8,
    touch: (harm: pierce, damage: 7, knock: 200, stun: 0.15),
    brain: (
        kind: "hunter",
        params: (aggro: 300, close: Walk(keep: 8, jump_to_reach: 16), wander: (speed: 0.4, every: 2.5)),
    ),
)
