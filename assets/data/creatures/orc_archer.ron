// An orc archer: keeps its distance (backs off if you close in), draws, and
// looses where you'll be. Its arrows stick like yours, and you can take
// them. Drawn from the user's reference (assets/art/orc_archer.ron): lean,
// hunched, green, in a brown cowl, its long ears out of it, one amber eye,
// an iron pauldron, its longbow slung on its back until it shoots (then in
// its hand: weapons.ron); on two bent legs that step (legs.rs, `rig`), its
// run in step with them.
(
    name: "Orc archer",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "orc_archer",
    // (No cap: its cowl's up, `bare_head`. Its boots aren't drawn on its
    // legs, but it has them on it.)
    bare_head: true,
    wears: [("leather_gloves", 0.5), ("leather_boots", 0.4), ("leather_jerkin", 0.2)],
    size: (13, 29),
    health: 50,
    eyes: (237, 166, 31),
    team: Enemy,
    faction: "orcs",
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "humanoid",
    fall_damage: (safe_height: 105, per_cell: 0.53),
    movement: (
        // (Its body grown 1.2 times, canon42: these are as they were, in
        // its own body heights: `scale`.)
        scale: 1.2,
        run_speed: 87,
        jump_height: 36,
        air_jumps: 0,
        step_height: 5,
        dash_speed: 0,
    ),
    art: "orc_archer",
    // Its legs: the swordsman's (orc.ron).
    legs: (view: Side, rig: true, in_step: true, reach: 18, upper: 0.5, step: 0.24, lift: 2.5, stride: 8, run: (13, 4, 0.8),
           color: (101, 115, 37), joint: (76, 89, 28), shin: (92, 58, 30), outline: (17, 18, 9), width: [4.2, 3.6, 3.2], toes: 5,
           body: "orc_archer",
           each: [
               (hip: (4.5, 1.5), lean: 4, gait: 0, knee: Forward),
               (hip: (-4.5, 1.5), lean: -4, gait: 1, knee: Forward, far: true),
           ]),
    weapon: "bow",
    stamina: 60,
    poise: 8,
    heft: 1.1,
    brain: (
        kind: "hunter",
        // (It stands its ground with no one about.)
        params: (aggro: 390, close: Range(near: 75, far: 210), attack: Shoot(draw: 0.85, every: 1.8, wobble: 5), wander: (speed: 0), tactics: (flee: 0.35, call: 250)),
    ),
)
