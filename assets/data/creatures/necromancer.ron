// A necromancer: twice your height, gaunt, floating, a long hood over a grey
// skull-jawed face with its eyes alight, bare bony arms, a cape and rags of
// cloth trailing under it, charms swinging off its skull-crook. It keeps
// away and works from there: wailing skulls that steer for you (a blade
// bursts them); a ring of green under your feet, then rotting hands up out
// of the ground to hold you (struggle free); a tether that drains you and
// mends it while it can see you; zombies raised, bodies near first (they
// stay down when killed, and are gone when it is); come too close and it
// blinks away in grave-smoke. Found among crypts' guards and in the deep.
// (custom/necro.rs)
(
    name: "Necromancer",
    size: (12, 50),
    health: 140,
    heft: 2,
    poise: 25,
    team: Enemy,
    faction: "undead",
    kind: "undead",
    blood: "ash",
    art: "necromancer",
    eyes: (150, 255, 160),
    movement: (
        run_speed: 60,
        ground_accel: 600,
        ground_decel: 800,
        air_accel: 300,
        jump_height: 20,
        air_jumps: 0,
        step_height: 8,
        dash_speed: 0,
        fly_speed: 70,
        fly_accel: 260,
    ),
    brain: (kind: "hunter", params: (aggro: 360, close: Range(near: 130, far: 230))),
    custom: (name: "necro", params: ()),
    z: 11.2,
)
