// A cave rat that bends (a prototype beside `rat.ron`, the same rat
// otherwise): its box only its head's, its body after it along the way its
// head went (round corners, up walls, over bumps), its tail a chain
// swinging behind (`spine`; body/spine.rs).
//
// A cave rat, big as a dog (a skeever): the caves' scavengers. They come
// in packs, scurrying (a dart, a freeze, a twitch, never still for long),
// lying along the slopes they run on, up and down walls (not roofs: a
// spider's), and
// gather at bodies to gnaw them (a body gnawed through is gone,
// what it had left lying). Near you, one alone or a pack, they come at
// you, pounce and bite: two at a time (whatever pack they came in), the
// rest circling a little way off, swapping in. (custom/rat.rs)
(
    name: "Rat (lithe)",
    size: (14, 11),
    health: 16,
    // (Chunky: a blow shoves it back a step and staggers it, a pounce
    // parried, but it's no leaf.)
    heft: 1.4,
    team: Enemy,
    // (Mindless: walks into a painted wall of fire.)
    heedless: true,
    faction: "rats",
    kind: "beast",
    blood: "blood",
    bleeds: 0.8,
    art: "rat_lithe",
    // Its body: the art's columns 7 (its rump) to 24 (where its head
    // begins) cut in eight slices about row 9; its tail from the rump.
    spine: (from: 7, head: 24, slices: 8, row: 9,
            tail: (root: (8, 12), length: 22, links: 8, width: (2.2, 0.8), color: (178, 136, 128), shade: (146, 108, 104))),
    // A red glint of an eye in the dark.
    eyes: (230, 40, 40),
    // (It lies along the ground under it, tilted with its slopes.)
    hug: true,
    movement: (
        run_speed: 150,
        ground_accel: 1800,
        jump_height: 26,
        climb_walls: true,
        air_jumps: 0,
        step_height: 3,
        dash_speed: 0,
    ),
    touch: (damage: 6, knock: 140, every: 0.7),
    brain: (
        kind: "hunter",
        params: (aggro: 200, close: Crawl(pounce_range: 40, pounce_every: 1.3, dart: Some((0.5, 0.12))), wander: (speed: 0.5), senses: (dark: 1.0, smell: 120, hearing: 1.2), tactics: (call: 160, flank: true, skirmish: (back: 34, wait: 0.8, together: 2, shared: true))),
    ),
    custom: (name: "rat", params: ()),
)
