// A spiderling: small, fast, many (they hatch from egg sacs); a nip each.
(
    name: "Spiderling",
    size: (8, 6),
    health: 8,
    team: Enemy,
    faction: "spiders",
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "insect",
    profile: {acid: -0.25},
    // Acid in its veins, like its mother's; acid doesn't hurt it.
    blood: "acid",
    art: "spiderling_body",
    legs: (count: 8, reach: 14, upper: 0.5, step: 0.07, lift: 3, hips: 0, spread: 3,
           color: (30, 22, 26), body: "spiderling_body", eyes: (255, 52, 38)),
    light: (color: (255, 40, 30), strength: 0.025),
    movement: (
        run_speed: 132,
        ground_accel: 1800,
        jump_height: 18,
        air_jumps: 0,
        step_height: 2,
        cling: true,
        dash_speed: 0,
    ),
    web_walker: true,
    touch: (damage: 3, knock: 75, every: 0.5),
    brain: (
        kind: "hunter",
        params: (aggro: 210, close: Crawl(pounce_range: 30, pounce_every: 1.0), wander: (speed: 0.6), senses: (dark: 1.0, smell: 90), tactics: (flee: 0.3)),
    ),
)
