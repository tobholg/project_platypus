// A cave eel: a moray of the flooded caverns (a gnasher's kin,
// custom/gnasher.rs `den`, `aquatic`). It waits in a nook of the wall, its
// head out, still, its body behind it; swim past near it and it shoots out
// (its jaw gaping: the tell, short), snaps, and hunts you a while before it
// goes back in. It swims stroke by stroke (swim.rs), its body waving after
// its head. Its hurt is all teeth.
(
    name: "Cave eel",
    size: (16, 9),
    health: 70,
    heft: 1.4,
    poise: 14,
    team: Enemy,
    touchless: true,
    kind: "beast",
    blood: "blood",
    art: "cave_eel",
    eyes: (232, 222, 140),
    light: (color: (232, 222, 140), strength: 0.03),
    swim: (stroke: 80, every: (0.2, 0.6), drag: 2.0, turn: (2.0, 4.5), carve: 3.5,
           body: (count: 16, spacing: 5, size: (9, 7), swell: 0.15, taper: 0.35,
                  color: (54, 62, 36), lit: (96, 106, 56), belly: (140, 132, 86), outline: (12, 14, 6),
                  wave: (9.0, 3.5, 0.15, 0.3),
                  fins: [(kind: Back, at: 0.35, size: (10, 3), color: (70, 80, 44)), (kind: Back, at: 0.6, size: (10, 3), color: (70, 80, 44)),
                         (kind: Belly, at: 0.7, size: (8, 2), color: (70, 80, 44)), (kind: Tail, at: 1.0, size: (7, 4), color: (70, 80, 44))])),
    movement: (
        run_speed: 80,
        ground_accel: 600,
        ground_decel: 800,
        air_accel: 320,
        jump_height: 20,
        air_jumps: 0,
        step_height: 6,
        dash_speed: 0,
        fly_speed: 110,
        fly_accel: 420,
    ),
    brain: (kind: "hunter", params: (aggro: 200, close: Range(near: 40, far: 120))),
    custom: (name: "gnasher", params: (lunges: 1, lure: 0, bite: 0.5, glow: (232, 222, 140), aquatic: true, den: true, trail: [2, 3, 2])),
)
