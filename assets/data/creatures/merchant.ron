// The village's merchant: sells what travellers need and buys what they
// carry back, for gold. A villager (actors/villager.rs, talk.rs).
(
    name: "Merchant",
    size: (11, 24),
    // (Tough and quick: a raid is a fight you can come to, not over in a moment.)
    health: 140,
    team: Villager,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "humanoid",
    movement: (run_speed: 102, jump_height: 33, air_jumps: 0, step_height: 5, dash_speed: 0),
    stamina: 60,
    poise: 10,
    heft: 1.0,
    art: "merchant",
    brain: (
        kind: "villager",
        params: (
            role: "merchant",
            wander: 60,
            lines: [
                "Buying and selling! Everything has its price.",
                "Torches, rope, bombs. What'll it be?",
                "Found something shiny down there? I'll take it off your hands.",
                "Gold dust is gold. I weigh it fair.",
            ],
            sells: [("torch", 2), ("glowstick", 4), ("bomb", 12), ("arrow", 1), ("chest", 20), ("block:planks", 1), ("block:platform", 1), ("flask", 20)],
            buys: true,
        ),
    ),
)
