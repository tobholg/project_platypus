// A vampire bat: flits high in caves; dives at you, bites, flies back up.
(
    name: "Vampire bat",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "vampire_bat",
    size: (9, 6),
    health: 16,
    team: Enemy,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "beast",
    profile: {radiant: 1.5},
    blood: "blood",
    art: "vampire_bat",
    // A red eye, crisp in the dark (drawn over it, blinking now and then),
    // the faintest red on what's right beside it: no glow.
    eyes: (255, 64, 44),
    light: (color: (255, 30, 20), strength: 0.04),
    movement: (
        run_speed: 30,
        fly_speed: 173,
        fly_accel: 1350,
        air_jumps: 0,
        step_height: 0,
        dash_speed: 0,
    ),
    touch: (damage: 6, knock: 120, stun: 0.1, every: 0.8),
    brain: (
        kind: "hunter",
        params: (aggro: 240, close: Swoop(hover: (27, 68), dive_time: 1.2, dive_every: 2.2), senses: (dark: 1.0, hearing: 1.5), tactics: (shun_light: 90)),
    ),
)
