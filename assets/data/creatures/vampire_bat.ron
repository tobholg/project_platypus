// A vampire bat: hovers round you, bobbing and jinking; draws back (the
// tell), dashes at you along a line, bites, and swings back up round.
(
    name: "Vampire bat",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "vampire_bat",
    size: (9, 6),
    health: 16,
    // (Light as a leaf: a blow swats it away, a dive parried.)
    heft: 0.35,
    team: Enemy,
    faction: "bats",
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "beast",
    profile: {radiant: 1.5},
    blood: "blood",
    art: "vampire_bat",
    // A red eye, crisp in the dark (drawn over it, blinking now and then),
    // the faintest red on what's right beside it: no glow.
    eyes: (255, 64, 44),
    light: (color: (255, 30, 20), strength: 0.04),
    movement: (
        run_speed: 30,
        fly_speed: 230,
        fly_accel: 1350,
        air_jumps: 0,
        step_height: 0,
        dash_speed: 0,
    ),
    touch: (damage: 10, knock: 140, stun: 0.12, every: 0.8),
    brain: (
        kind: "hunter",
        params: (aggro: 240, close: Swoop(hover: (27, 68), dive_time: 0.55, dive_every: 1.4), senses: (dark: 1.0, hearing: 1.5), tactics: (shun_light: 90)),
    ),
)
