// A stilt stalker: a small pale body slung high between four long legs,
// stepping over what's in its way; it stalks you across rough ground, its
// body riding its feet (up a slope nose first, down one nose down). A
// first version (BE `limbs`): it walks, and what it touches it hurts; its
// stab with a leg comes with moves that drive limbs.
(
    name: "Stilt stalker",
    // Its box takes in its legs: narrow and tall.
    size: (18, 58),
    health: 90,
    team: Enemy,
    kind: "insect",
    // It bleeds pale ichor.
    blood: "ichor",
    art: "stalker_body",
    // Four legs seen from the side (legs.rs): the near ones in front of
    // its body, the far ones behind it, darker; front and back legs of
    // opposite sides step together. Its body rides 46 cells over its feet.
    legs: (view: Side, reach: 64, upper: 0.5, step: 0.16, lift: 9, ride: 46, stride: 22, tilt: 28,
           color: (156, 146, 126), joint: (100, 92, 78), outline: (40, 36, 32), width: (3, 2, 1.2), body: "stalker_body", eyes: (240, 206, 92),
           each: [
               (hip: (6, 0), lean: 18, gait: 0),
               (hip: (-6, 0), lean: -16, gait: 1),
               (hip: (8, 1), lean: 22, gait: 1, far: true),
               (hip: (-4, 1), lean: -12, gait: 0, far: true),
           ]),
    light: (color: (240, 206, 92), strength: 0.03),
    movement: (
        run_speed: 72,
        ground_accel: 500,
        ground_decel: 700,
        jump_height: 34,
        air_jumps: 0,
        // (Long legs: it steps over a bump as high as a person's knee.)
        step_height: 14,
        dash_speed: 0,
    ),
    poise: 30,
    heft: 2,
    touch: (harm: pierce, damage: 9, knock: 220, stun: 0.2),
    brain: (
        kind: "hunter",
        params: (aggro: 400, close: Walk(keep: 6, jump_to_reach: 30), wander: (speed: 0.35, every: 3.0)),
    ),
)
