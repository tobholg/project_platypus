// A zombie: the dead, gone feral: grey-blue, hunched almost onto all fours,
// one red eye, its jaw hanging, its spine through a torn shirt. The humanoid
// rig (assets/art/zombie.ron) on two bent legs that step (legs.rs, `rig`),
// its body in step with them: it lurches low and uneven, a hand planted
// ahead of it at each step, raking with its dead nails.
// Dead flesh: cut, it bleeds dark rot; its limbs come off. Legless, it
// drags itself on; armless, it bites (`armless`); its head off, it's dead
// for good (`headless: Dies`). Killed otherwise, its body lies a while,
// then may get up again, whatever it lost still lost: half the time, and
// of those killed again half get up as a crimson head (zombie_crimson).
// Burn the body and it never does.
(
    name: "Zombie",
    loot: "zombie",
    // Nothing on its head: its bare skull is its face (no hood or helmet
    // rolled for it, none put on it getting up again; the upright
    // zombie_classic wore them).
    bare_head: true,
    size: (9, 20),
    health: 100,
    team: Enemy,
    // (Mindless: walks into a painted wall of fire.)
    heedless: true,
    faction: "undead",
    kind: "rotting",
    // Killed, its body lies a while and, half the time, gets up again; if
    // it's killed again, half of those get up a last time as a crimson
    // head (`last`). Only fire destroys the body (burn it: a torch to it,
    // oil and a spark, fire); its head off, it's done.
    rises: Some((after: 7.0, health: 0.6, chance: 0.5, breaks: [fire], remains: Body, times: Some(2), last: Some("zombie_crimson"), glow: (170, 120, 110))),
    headless: Dies,
    // (Its neck takes 55 % of its health in blows before its head can come
    // off, and even then a blow to it takes it off only one time in four:
    // never a sure thing.)
    neck: 0.55,
    behead: 0.25,
    // The dead burn in the sun (its body too, lying there).
    sunburns: true,
    // Near you (160 cells), it breaks into a sprint at you, faster than
    // you run: a snarl, then suddenly fast, again and again, and it lunges
    // when it's on you. Further off it jogs, and can be outpaced.
    spurt: Some((speed: 2.6, secs: 1.8, every: (0.15, 0.4), range: (12.0, 160.0))),
    blood: "rot",
    eyes: (255, 54, 40),
    // A low groan now and then.
    voice: Some(("groan", (3.0, 9.0))),
    fall_damage: (safe_height: 120, per_cell: 0.5),
    movement: (
        run_speed: 65,
        jump_height: 28,
        air_jumps: 0,
        step_height: 5,
        dash_speed: 0,
    ),
    // (The hunched design; the upright one, kept: "zombie_classic", on
    // its old legs: hips (2, 4), reach 14.5, no `lean`, no `shin`.)
    art: "zombie",
    // Its legs (at the canon, for a box 24 high: hips 14 and 13 up, under
    // the reference's seat): two bent legs, wide, in purple-black trousers
    // torn off at the knee (bare grey shins and feet); a lurching step, the
    // feet barely lifting, the far leg the bad one, trailing well behind
    // (`lean`). Its body keeps in step with them (`in_step`): it rises on
    // its good leg and drops on its bad one, a hand planted as the other
    // foot is.
    legs: (view: Side, rig: true, in_step: true, reach: 17, upper: 0.5, step: 0.26, lift: 2, stride: 7.5,
           color: (65, 60, 72), joint: (82, 76, 90), shin: (104, 112, 110), outline: (16, 13, 14), width: [3.6, 3.1, 2.4], toes: 4,
           body: "zombie",
           each: [
               (hip: (2.5, 2), lean: 1, gait: 0, knee: Forward),
               (hip: (-2.5, 1), lean: -9, gait: 1, knee: Forward, far: true),
           ]),
    // Close in, it grabs and bites (dash through its reach, or shake it
    // off).
    moves: ["zombie_grab"],
    unarmed: "rotten_claws",
    armless: "zombie_bite",
    stamina: 60,
    // Hard to stop: most blows don't stagger it (a blow to its head
    // does, sooner: `zones`), and it barely gives ground.
    poise: 40,
    heft: 4,
    // Its head's the place to hit (twice over); its body takes a blow as
    // it comes.
    zones: (head: 2.0, body: 1.0, arms: 0.8),
    // Each its own pace: a pack closes in unevenly.
    pace: 0.3,
    brain: (
        kind: "hunter",
        params: (aggro: 260, close: Walk(keep: 12, jump_to_reach: 22), attack: Swing(reach: 20, every: 0.9, combo: 1), wander: (speed: 0.25, every: 4.0), senses: (dark: 1.0, hearing: 1.4, smell: 160, memory: 10, behind: 0.6)),
    ),
)
