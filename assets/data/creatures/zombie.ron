// A zombie: the shambling dead, dead-pale, bloodied, in the clothes it died in.
// The humanoid rig (assets/art/zombie.ron) on two legs that step (legs.rs,
// `rig`): it goes slow, arms out ahead, raking with its dead nails.
// Dead flesh: cut, it bleeds dark rot; its limbs come off. Legless, it
// drags itself on; armless, it bites (`armless`); its head off, it's dead
// for good (`headless: Dies`). Killed otherwise, its body lies a while,
// then gets up again: once (`rises`, `times: 1`), with whatever it lost
// still lost. Break the body before it does (anything hurts it).
(
    name: "Zombie",
    loot: "zombie",
    // What it had on when it died: now and then a hood or a helmet.
    wears: [("cloth_hood", 0.15), ("iron_helm", 0.08)],
    size: (9, 20),
    health: 85,
    team: Enemy,
    faction: "undead",
    kind: "rotting",
    rises: Some((after: 7.0, health: 0.6, remains: Body, times: Some(1), glow: (170, 120, 110))),
    headless: Dies,
    blood: "rot",
    eyes: (200, 204, 192),
    fall_damage: (safe_height: 120, per_cell: 0.5),
    movement: (
        run_speed: 36,
        jump_height: 28,
        air_jumps: 0,
        step_height: 5,
        dash_speed: 0,
    ),
    art: "zombie",
    // Its legs: two legs in dark trousers from its hips, 14 cells up (a
    // man's height, not the skeleton's), a shambling step (slow, short, the
    // feet barely lifting).
    legs: (view: Side, rig: true, reach: 14.5, upper: 0.5, step: 0.24, lift: 1.5, stride: 6,
           color: (58, 56, 62), joint: (70, 68, 74), outline: (24, 18, 20), width: [3.2, 2.8, 2.2], toes: 3,
           body: "zombie",
           each: [
               (hip: (2, 4), gait: 0, knee: Forward),
               (hip: (-1, 4), gait: 1, knee: Forward, far: true),
           ]),
    unarmed: "rotten_claws",
    armless: "zombie_bite",
    stamina: 50,
    poise: 22,
    brain: (
        kind: "hunter",
        params: (aggro: 260, close: Walk(keep: 12, jump_to_reach: 22), attack: Swing(reach: 20, every: 1.5, combo: 1), wander: (speed: 0.25, every: 4.0), senses: (dark: 0.8)),
    ),
)
