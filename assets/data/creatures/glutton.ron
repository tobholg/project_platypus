// The glutton: a pale slime that drinks what it's struck with and takes
// it on (body/goo/glutton.rs): fire, frost, lightning, acid, poison, light
// and the void, from a spell landing on it, a blow, a bolt, or what it's
// in (flames, lava, acid, miasma). What it drinks doesn't hurt it; it
// feeds on it. Charged, it attacks with it (glowing, holding still a
// moment first): lightning struck at you, ice shards, a lava eruption,
// acid globs lobbed, a belch of miasma, a ray of light swept across you,
// or it blinks beside you and springs. Each spends a third; spent (or
// left unused a while) it's itself again. Opposites go off: fire and
// frost explode, light and the void implode, fire burns poison off.
// Water douses its fire, dilutes its acid, carries its lightning, freezes
// under its frost; oil coats it, and fire on it then flares up.
// A core (a dark nucleus with eyes) holding a body of real
// goo, cells of the world round it (`goo`: body/goo.rs). It hops at you,
// each hop its own height (`lift`); hurt, it lets go of goo it can no
// longer hold; left alone it heals, drawing its spilled goo back in.
(
    name: "Glutton",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "slime",
    size: (21, 15),
    health: 90,
    team: Enemy,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "ooze",
    // (What it drinks doesn't hurt it: it takes it on, and feeds on it.)
    profile: {fire: 0.0, frost: 0.0, storm: 0.0, acid: 0.0, poison: 0.0, radiant: 0.0, void: 0.0},
    cant: [poison, burn],
    // (Its goo is its blood: hurt, it flings goo off; dead, it spills.)
    blood: "",
    art: "glutton",
    // Each its own size: most about this big, some much bigger.
    sizes: Some((1.0, 2.5)),
    goo: Some((material: "prism_goo", cells: 650,
        // Near you, its face toward you shivers, then a fan of goo spikes
        // stabs out at you, pulsing in a wave, jittering.
        spikes: Some((range: 36, tell: 0.55, secs: 2.2, every: 3.5, count: 7, cone: 38, reach: 28, pulse: 0.36, damage: 12)))),
    // Left alone a few seconds, it heals: its spilled goo drawn back in
    // (then new grown).
    regen: (per_sec: 6, pause: 3, rests: true),
    // It takes on what it's struck with (body/goo.rs, Glutton).
    glutton: true,
    movement: (
        run_speed: 83,
        air_accel: 600,
        jump_height: 64,
        air_jumps: 0,
        step_height: 2,
        dash_speed: 0,
    ),
    touch: (harm: blunt, damage: 7, knock: 180, stun: 0.15),
    brain: (
        kind: "hunter",
        params: (aggro: 230, close: Hop(every: 1.3, lift: 0.35)),
    ),
)
