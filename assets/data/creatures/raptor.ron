// A ridge raptor: a lean striped hunter on two long legs; it runs at you
// nose down, its tail out level, bobbing with each stride. A first version
// (BE `limbs`): it runs, and its touch cuts; its bite and kick come with
// moves that drive limbs.
(
    name: "Ridge raptor",
    size: (16, 30),
    health: 60,
    team: Enemy,
    kind: "beast",
    fall_damage: (safe_height: 120, per_cell: 0.5),
    art: "raptor_body",
    // Two legs from the side (legs.rs), each three bones as a bird's: a
    // thick thigh forward to the knee, a slender shank back to the ankle,
    // a long foot bone forward to its clawed toes (held 62° up from the
    // ground). The near leg in front of its body, the far one behind; one
    // steps, then the other. Its hip a quarter of its length up (a real
    // raptor's): its body rides 14 cells over its feet, about a person's
    // waist; it rises 2 with each stride and leans 10° nose down at 100
    // cells/s. Little arms held under its chest.
    legs: (view: Side, reach: 15, upper: 0.45, ankle: 7, heel: 62, step: 0.1, lift: 5, ride: 14, stride: 12, tilt: 25, bob: 2, pitch: 10,
           color: (90, 104, 64), joint: (60, 68, 44), outline: (26, 30, 20), width: [7, 3, 2.2, 2], toes: 5,
           body: "raptor_body", eyes: (250, 210, 60),
           each: [
               (hip: (0, 0), gait: 0, knee: Forward),
               (hip: (2, 1), gait: 1, knee: Forward, far: true),
           ],
           arms: [
               (shoulder: (10, 3), hand: (15, -2), bones: (4.5, 5), width: [2.5, 2, 1.5], elbow: Back, sway: 0.6),
               (shoulder: (11, 4), hand: (17, -1), bones: (4.5, 5), width: [2.5, 2, 1.5], elbow: Back, sway: 0.6, far: true),
           ],
           // Its tail (chains.rs): held out stiff behind, level, swinging
           // after its body as it runs and turns.
           chains: [
               (anchor: (-11, 3), links: 6, length: 4.2, rest: 182, stiff: 0.7, sag: 1, width: [5, 3, 1], color: Some((98, 114, 72)), behind: true),
           ]),
    movement: (
        run_speed: 150,
        ground_accel: 900,
        ground_decel: 1100,
        jump_height: 42,
        air_jumps: 0,
        step_height: 7,
        dash_speed: 0,
    ),
    poise: 14,
    heft: 1.0,
    touch: (harm: slash, damage: 8, knock: 260, stun: 0.2),
    moves: ["raptor_bite"],
    brain: (
        kind: "hunter",
        params: (aggro: 450, close: Walk(keep: 8, jump_to_reach: 34), wander: (speed: 0.5, every: 2.0), senses: (dark: 0.5, smell: 220, memory: 6), tactics: (flank: true, flee: 0.25)),
    ),
)
