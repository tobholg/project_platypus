// A troll: slow, huge, a club that sends you flying. It winds up long
// enough to see it coming (dodge through it: Shift), and hits too light to
// matter don't stop it: it staggers only after a lot.
(
    name: "Troll",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "troll",
    size: (23, 51),
    health: 420,
    team: Enemy,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "beast",
    // A troll's wounds close (10 a second) unless fire or acid hurt it in
    // the last 5 s, and while they close it can't die: steel brings it
    // down to its last breath and it heals; burnt, any blow finishes it.
    regen: (per_sec: 10, stopped_by: [fire, acid], pause: 5, undying: true),
    fall_damage: (safe_height: 135, per_cell: 1.0),
    movement: (
        run_speed: 57,
        ground_accel: 750,
        ground_decel: 1350,
        jump_height: 24,
        air_jumps: 0,
        step_height: 8,
        dash_speed: 0,
    ),
    art: "troll",
    weapon: "club",
    stamina: 120,
    poise: 80,
    heft: 4,
    blood: "blood",
    brain: (
        kind: "hunter",
        params: (aggro: 390, close: Walk(keep: 27, jump_to_reach: 45), attack: Swing(reach: 45, every: 2.2, combo: 1), wander: (speed: 0.3, every: 3.5)),
    ),
    z: 9,
)
