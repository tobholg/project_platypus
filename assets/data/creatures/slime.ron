// A cave slime: hops at you, one hop at a time; soft, but it sticks to you
// when it lands (touch). Full of slime.
(
    name: "Slime",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "slime",
    size: (15, 11),
    health: 30,
    team: Enemy,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "ooze",
    blood: "slime",
    art: "slime",
    movement: (
        run_speed: 83,
        air_accel: 600,
        jump_height: 33,
        air_jumps: 0,
        step_height: 2,
        dash_speed: 0,
    ),
    touch: (harm: blunt, damage: 7, knock: 180, stun: 0.15),
    brain: (
        kind: "hunter",
        params: (aggro: 210, close: Hop(every: 1.3)),
    ),
)
