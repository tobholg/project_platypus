// A skeleton: the dead of crypts and deep caves, with a rusty sword; bones,
// so it crumbles to dust. The humanoid rig (assets/art/skeleton.ron).
// Killed, its bones fall in a heap that pulls itself back together and
// stands again (`rises`), unless something breaks it: a hammer, holy light.
// Bones: no flesh to burn, nothing in them a fall can burst.
(
    name: "Skeleton",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "skeleton",
    // The armour it died in, rusted on.
    wears: [("iron_helm", 0.3), ("chainmail", 0.25), ("iron_greaves", 0.2), ("cloth_hood", 0.15)],
    size: (9, 23),
    health: 70,
    team: Enemy,
    faction: "undead",
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "undead",
    // (Bones don't burn: the undead's weakness to fire is dead flesh's.)
    profile: {fire: 0.75},
    cant: [burn],
    rises: Some((after: 5.0, health: 0.5, by: [blunt, radiant])),
    blood: "ash",
    fall_damage: (safe_height: 180, per_cell: 0.3),
    movement: (
        run_speed: 87,
        jump_height: 48,
        air_jumps: 0,
        step_height: 5,
        dash_speed: 0,
    ),
    art: "skeleton",
    weapon: "rusty_sword",
    stamina: 60,
    poise: 12,
    brain: (
        kind: "hunter",
        params: (aggro: 300, close: Walk(keep: 15, jump_to_reach: 27), attack: Swing(reach: 23, every: 1.3, combo: 2), wander: (speed: 0.3, every: 3.0), senses: (dark: 0.7)),
    ),
)
