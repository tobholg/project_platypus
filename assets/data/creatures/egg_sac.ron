// An egg sac, stuck in a spider nest: come near (or hit it) and it bursts
// into spiderlings.
(
    name: "Egg sac",
    // Leaves no body: what it had spills out.
    corpse: false,
    size: (11, 14),
    health: 20,
    team: Enemy,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "insect",
    profile: {fire: 2.0},
    blood: "ichor",
    art: "egg_sac",
    movement: (run_speed: 0, jump_height: 0, air_jumps: 0, step_height: 0, dash_speed: 0),
    custom: (
        name: "hatchery",
        params: (brood: "spiderling", count: 4, range: 51),
    ),
)
