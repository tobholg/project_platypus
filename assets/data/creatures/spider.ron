// A cave spider: big, eight red eyes glowing in the dark, eight long legs
// that reach out and grip the rock (actors/legs.rs). It runs at you over
// floors, walls and ceilings, drops on you from above. Up close it crouches
// low and draws back, trembling, then leaps at you to bite (it throws you),
// or rears up on its back legs, its front pair raised high, and stamps them
// down on you; from further off it rears and spits acid, a lot of it. Dead,
// its legs curl up over it. Lives in nests (lairs.ron) and deep caves.
(
    name: "Cave spider",
    // What it may have on it when it dies (loot.ron), besides what it wears.
    loot: "spider",
    size: (24, 18),
    health: 130,
    team: Enemy,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "insect",
    profile: {acid: -0.25},
    // It bleeds acid (mind where you hit it), and acid doesn't hurt it.
    blood: "acid",
    art: "spider_side",
    // Seen from the side on the ground, walls and ceilings: its legs from
    // under its head, the knees up high over its back, the feet spread
    // far ahead and behind (four near, four far), stepping in two sets of
    // four. On the wall behind, from above (`back`): its legs splayed all
    // round it.
    legs: (view: Side, reach: 62, upper: 0.5, step: 0.1, lift: 8, ride: 13, stride: 16, tilt: 25,
           color: (52, 40, 46), joint: (96, 50, 54), far: (22, 16, 20), thick: 4, body: "spider_side", eyes: (255, 52, 38),
           strikers: [0, 4],
           each: [
               (hip: (9, 0), lean: 36, gait: 0, knee: Up),
               (hip: (7.5, 0), lean: 15, gait: 1, knee: Up),
               (hip: (6, 0), lean: -22, gait: 0, knee: Up),
               (hip: (4.5, 0), lean: -42, gait: 1, knee: Up),
               (hip: (10, 1), lean: 29, gait: 1, knee: Up, far: true),
               (hip: (8.5, 1), lean: 9, gait: 0, knee: Up, far: true),
               (hip: (7, 1), lean: -15, gait: 1, knee: Up, far: true),
               (hip: (5.5, 1), lean: -35, gait: 0, knee: Up, far: true),
           ],
           back: Some((count: 8, reach: 72, upper: 0.48, step: 0.1, lift: 12, hips: 6, spread: 11,
               color: (24, 18, 22), joint: (74, 36, 40), thick: 5, body: "spider_body", eyes: (255, 52, 38)))),
    // (Its eyes are drawn over the dark: `legs`' `eyes`. The faintest red on
    // what's right beside it: no glow.)
    light: (color: (255, 40, 30), strength: 0.04),
    movement: (
        run_speed: 123,
        ground_accel: 1350,
        ground_decel: 1800,
        air_accel: 750,
        jump_height: 33,
        air_jumps: 0,
        step_height: 3,
        cling: true,
        dash_speed: 0,
    ),
    web_walker: true,
    // Heavy and planted on eight legs: it shrugs off most blows (poise:
    // 5 shortsword slashes, 3 longsword ones, 2 of its drive, in a row
    // before one staggers it) and barely moves when hit (knockback / heft:
    // a longsword slash sends it 24 cells/s, was 250).
    poise: 60,
    heft: 4,
    brain: (
        kind: "hunter",
        params: (aggro: 255, close: Crawl(pounce_range: 0, pounce_every: 1.5, keep: 34), wander: (speed: 0.4), senses: (dark: 1.0, smell: 160), tactics: (shun_light: 75)),
    ),
    // Its own moves (moves.ron), tried in this order.
    moves: ["spider_stamp", "spider_bite", "spider_spit"],
    // It digs its way to you: claws through dirt and sand (hardness to 25,
    // 30 cells a second of dirt), acid through what they can't take (stone,
    // not obsidian or glass: 40 cells a second of dirt, stone a third of
    // that), spitting a little at the face every 1.6 s.
    dig: (claws: (25, 30), acid: (hardness: 90, rate: 40, every: 1.6)),
)
