// floors, walls and ceilings, leaps at you when near, drops on you from
// above; its bite knocks you back. Lives in nests (lairs.ron) and deep caves.
(
    name: "Cave spider",
    size: (16, 12),
    health: 70,
    team: Enemy,
    blood: "ichor",
    art: "spider_body",
    legs: (count: 8, reach: 48, upper: 0.48, step: 0.1, lift: 8, hips: 4, spread: 7,
           color: (24, 18, 22), joint: (74, 36, 40), thick: 3, body: "spider_body", eyes: (255, 52, 38)),
    light: (color: (255, 40, 30), strength: 0.14, haze: true),
    movement: (
        run_speed: 82,
        ground_accel: 900,
        ground_decel: 1200,
        air_accel: 500,
        jump_height: 22,
        air_jumps: 0,
        step_height: 2,
        cling: true,
        dash_speed: 0,
    ),
    web_walker: true,
    touch: (damage: 12, knock: 170, stun: 0.25, every: 0.7),
