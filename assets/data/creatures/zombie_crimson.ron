// A crimson head: a zombie left to get up a second time, worse. Its skin
// flushed dark red, its nails grown long; it doesn't shamble, it runs at
// you, and grabs sooner. The last of it: killed, it stays dead (no
// `rises`), and so does a head-off.
// The hunched zombie's rig (assets/art/zombie_crimson.ron, its colours
// flushed), on legs that run, its body in step with them: a loping
// gallop, a hand slapping down at each stride. Its limbs come off as a zombie's do: legless it drags
// itself, armless it bites.
(
    name: "Crimson head",
    loot: "zombie",
    // Nothing on its head: its bare skull is its face (no hood or helmet
    // rolled for it, none put on it getting up again; the upright
    // zombie_classic wore them).
    bare_head: true,
    size: (11, 24),
    health: 160,
    team: Enemy,
    // (Mindless: walks into a painted wall of fire.)
    heedless: true,
    faction: "undead",
    kind: "rotting",
    headless: Dies,
    // (As a zombie's: its head never sure to come off.)
    neck: 0.45,
    behead: 0.25,
    sunburns: true,
    // Hunting you, now and then it breaks into a run at you: a snarl, then
    // suddenly fast for a couple of seconds.
    spurt: Some((speed: 1.8, secs: 2.2, every: (3.0, 6.0), range: (40.0, 200.0))),
    blood: "rot",
    eyes: (255, 214, 168),
    // A snarl, often.
    voice: Some(("snarl", (2.0, 5.0))),
    fall_damage: (safe_height: 120, per_cell: 0.5),
    movement: (
        run_speed: 78,
        jump_height: 28,
        air_jumps: 0,
        step_height: 5,
        dash_speed: 0,
    ),
    // (The hunched design; the upright one, kept:
    // "zombie_crimson_classic", on its old legs: hips (2, 4), reach 14.5.)
    art: "zombie_crimson",
    // Its legs: a zombie's, running: long quick strides, the bad leg
    // still trailing; shins bare and flushed under its torn trousers.
    // (At the canon: hips 14 and 13 up, for a box 24 high.)
    // (Running, it lopes as the zombie does: `run`, long strides.)
    legs: (view: Side, rig: true, in_step: true, reach: 17, upper: 0.5, step: 0.13, lift: 4, stride: 11, run: (17, 5, 0.2),
           color: (58, 50, 66), joint: (76, 68, 84), shin: (160, 80, 68), outline: (16, 13, 14), width: [3.6, 3.1, 2.4], toes: 4,
           body: "zombie",
           each: [
               (hip: (2.5, 2), lean: 1, gait: 0, knee: Forward),
               (hip: (-2.5, 1), lean: -8, gait: 1, knee: Forward, far: true),
           ]),
    // Close in, it grabs sooner and harder.
    moves: ["crimson_grab", "crimson_vomit"],
    unarmed: "crimson_claws",
    armless: "zombie_bite",
    stamina: 60,
    // Harder to stop than a zombie.
    poise: 55,
    heft: 4,
    // Its head's the place to hit (twice over); its body takes a blow as
    // it comes.
    zones: (head: 2.0, body: 1.0, arms: 0.8),
    // Each its own pace.
    pace: 0.15,
    brain: (
        kind: "hunter",
        params: (aggro: 340, close: Walk(keep: 14.4, jump_to_reach: 22), attack: Swing(reach: 24.0, every: 0.9, combo: 2), wander: (speed: 0.25, every: 4.0), senses: (dark: 1.0, hearing: 1.4, smell: 160, memory: 10, behind: 0.6)),
    ),
)
