// The player. A creature like any other; its brain is the keyboard.
// Units: cells (1 cell = 1 art pixel) and seconds. Edit while the game runs.
(
    name: "Player",
    // 1.5 blocks wide, just under 4 tall: fits a 2-wide shaft, a 4-tall tunnel.
    size: (9, 23),
    health: 100,
    team: Player,
    // Its kind (kinds.ron): how it takes each kind of hurt.
    kind: "humanoid",
    // (Safe past a triple jump's height: ~158 cells in cloud boots.)
    fall_damage: (safe_height: 180, per_cell: 0.4),
    // Its wounds close slowly once it's out of danger: nothing at all for
    // 8 s after any hurt, then a little at a time (empty to full in ~70 s).
    regen: (per_sec: 1.4, pause: 8, rests: true),
    movement: (
        // (It turns the moment you do: the creatures' hold, against their
        // flipping round in tight places, isn't for you.)
        turn_hold: 0,
        run_speed: 143,
        ground_accel: 2100,
        ground_decel: 2700,
        air_accel: 1350,
        gravity: 1650,
        fall_gravity: 1.6,
        max_fall: 630,
        // (75: a quarter higher than it was; double jumps, a share of it,
        // likewise.)
        jump_height: 75,
        jump_cut: 0.45,
        coyote_time: 0.09,
        jump_buffer: 0.12,
        // None of its own: boots give them (cloud boots: a triple jump).
        air_jumps: 0,
        dash_speed: 390,
        dash_time: 0.14,
        dash_cooldown: 0.45,
        wall_jump: true,
        wall_slide_speed: 90,
        wall_jump_push: 180,
        // Terraria steps up a whole tile unasked: a block and a half here.
        step_height: 9,
    ),
    // Drawn on the humanoid rig (assets/art/player.ron).
    art: "player",
    // Swings and dodges spend it (combat.rs).
    stamina: 100,
    // A moment nothing hurts you after a hit, so a crowd can't juggle you.
    after_hit: 1.0,
    brain: (kind: "keyboard"),
    z: 11,
)
