// The game's tempo (tempo.rs): presets of how fast and heavy movement is,
// to try side by side: F10 anywhere for the next (the pick is remembered
// in saves/tempo.txt), the arena panel's Tempo row, or PLATYPUS_TEMPO=<name>.
// Hot-reloaded. `default`: the tempo a first run (and every scenario) has.
//
// Each preset: `player`, any of the player's movement fields (over its
// creature file's; run_speed and jump_height stay scaled by what it wears):
//   run_speed, ground_accel (to run speed), ground_decel (to a stop),
//   turn_accel (a skid, steering against the run), air_accel, gravity,
//   fall_gravity (× gravity coming down), max_fall, jump_height (a full
//   jump's apex), jump_hold (s of steady rise while jump is held: Terraria's
//   jump), jump_cut (rise kept on letting go early), dash_speed, dash_time,
//   dash_cooldown, air_dash_recharge (the air dash back this long after,
//   even in the air; 0: once an airtime), wall_slide_speed, wall_jump_push;
//   rocket_power, rocket_across (shares of the rocket boots' thrust and
//   rising speed, and of their speed sideways).
// `pace`: every other creature's (speeds × pace, accelerations × pace²);
// `jump`, `gravity`: theirs × these (higher jumps, a lighter fall).
//
// In body heights (the player is 23 cells): Hollow Knight runs 6.3 a
// second, jumps 2.7 high, 0.48 s in the air; Terraria 4.3, 2.5, 0.85 s.
(
    default: "Experimental",
    presets: [
        // What the player's file says: snappy, heavy, fast.
        (name: "Hollow Knight", pace: 1.0),
        // Experimental: a run and stop between Hollow Knight's and Middle's
        // (a little run-up and slide), higher jumps (everyone's), lighter,
        // a longer, quicker dash that comes back in the air too.
        (name: "Experimental", pace: 1.0, jump: 1.2, gravity: 0.82, player: {
            "run_speed": 128, "ground_accel": 950, "ground_decel": 1500, "turn_accel": 1500,
            "air_accel": 950, "gravity": 1300, "fall_gravity": 1.45, "max_fall": 560,
            // (Jumps raised twice, a quarter and a fifth: 110, was 72; the
            // dash harder: 530 for 0.18 s, was 440 for 0.17.)
            "jump_height": 110,
            "dash_speed": 530, "dash_time": 0.18, "dash_cooldown": 0.45, "air_dash_recharge": 0.8,
            "rocket_power": 0.88, "rocket_across": 0.88,
        }),
        // Between: some run-up and skid, a short held rise, ~0.65 s in the
        // air, a softer fall.
        (name: "Middle", pace: 0.8, player: {
            "run_speed": 113, "ground_accel": 390, "ground_decel": 780, "turn_accel": 1050,
            "air_accel": 630, "gravity": 1200, "fall_gravity": 1.25, "max_fall": 450,
            // (Jumps raised twice, a quarter and a fifth: 96, was 63.)
            "jump_height": 96, "jump_hold": 0.12, "jump_cut": 0.6,
        }),
        // Terraria's own numbers, scaled to our size (its player is 42 px
        // tall, ours 23 cells: 0.548 cells a pixel; 60 ticks a second):
        // run 3 px/tick; accelerate 0.08, slow 0.2 (a turn: both, 0.28);
        // gravity 0.4, the same up and down; fall at most 10; jump 5.01
        // px/tick held for 15 ticks. Air control as slow as the ground's.
        (name: "Terraria", pace: 0.68, player: {
            "run_speed": 96, "ground_accel": 155, "ground_decel": 386, "turn_accel": 540,
            "air_accel": 155, "gravity": 771, "fall_gravity": 1.0, "max_fall": 321,
            "jump_height": 57, "jump_hold": 0.25, "jump_cut": 1.0,
        }),
    ],
)
