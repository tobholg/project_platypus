// The surface's backdrops (crates/backdrop: peaks.rs, terrain.rs): the
// looks, and which biome shows which. Read as the game starts (and by
// `platypus-backdrop lit <dir>`, which renders every look at dawn, noon,
// dusk and night).
//
// A look: its sky (overhead and at the horizon, at noon: the hour shades
// it), its clouds, its layers of land far to near.
//   clouds: how many, how big, their lit and shaded colours, how far above
//     the ground their bottoms sit (cells).
//   A layer is terrain, a band of land seen from the front:
//     every: about how far apart its summits; size: its heights where it
//       sinks and where it rises highest (shares of its strip); slope: how
//       broad (wider, gentler); rough: 0 smooth rolling hills .. 1 sharp
//       eroded ridges; base: its feet (a share of its strip from the top);
//     ground: what most of it is (rock, grass); growth: scrub or forest (low
//       down, and where `trees` says); snow: snow's colour, from
//       `snow_line` of its height down (0: none);
//     water: below this share of its height, a lake (showing the sky);
//     trees: how much of it is forest (0..1);
//     crowns: a wood: tree crowns about this big (cells; 0 none), as many
//       as `trees` says, each a dome with bunches of leaves on top, the
//       wood's floor under them its `ground`;
//     decor: flowers and small mushrooms over its grass (0 none .. 1);
//     haze: how much the sky's haze fades it; mist: mist at its feet.
(
    // Which biome shows which look (any other: `default`).
    biomes: {"plains": "meadow", "mountains": "alpine", "tundra": "alpine"},
    default: "noita",
    looks: [
        // As the Noita screenshot: pale snowy ranges, a deep blue-violet one in front.
        (name: "noita", sky: ((70, 118, 206), (150, 188, 232)), clouds: (many: 1, big: 1, lit: (246, 248, 255), shade: (150, 172, 214), foot: 18),
         layers: [
            (every: 90, size: (0.07, 0.15), slope: (0.9, 1.6), rough: 1, base: 0.5,
             ground: (167, 180, 201), growth: (115, 135, 180), snow: (204, 209, 219), snow_line: 0.35, water: 0, trees: 0, haze: 0.45, mist: 0.6),
            (every: 130, size: (0.095, 0.22), slope: (0.8, 1.5), rough: 1, base: 0.5,
             ground: (175, 187, 206), growth: (94, 113, 171), snow: (204, 209, 219), snow_line: 0.3, water: 0, trees: 0, haze: 0.12, mist: 0.5),
            (every: 220, size: (0.085, 0.235), slope: (0.9, 1.7), rough: 1, base: 0.5,
             ground: (99, 109, 167), growth: (52, 59, 122), snow: (204, 209, 219), snow_line: 0, water: 0, trees: 0, haze: 0, mist: 0.25),
        ]),
        // Whiter, snowier, a paler sky.
        (name: "alpine", sky: ((84, 140, 220), (178, 208, 240)), clouds: (many: 0.8, big: 1.1, lit: (250, 252, 255), shade: (166, 186, 222), foot: 18),
         layers: [
            (every: 80, size: (0.085, 0.165), slope: (0.8, 1.4), rough: 1, base: 0.5,
             ground: (182, 192, 207), growth: (131, 149, 189), snow: (204, 209, 219), snow_line: 0.55, water: 0, trees: 0, haze: 0.45, mist: 0.6),
            (every: 120, size: (0.11, 0.235), slope: (0.7, 1.3), rough: 1, base: 0.5,
             ground: (192, 199, 211), growth: (108, 128, 178), snow: (204, 209, 219), snow_line: 0.5, water: 0, trees: 0, haze: 0.12, mist: 0.5),
            (every: 200, size: (0.07, 0.165), slope: (1, 1.8), rough: 1, base: 0.5,
             ground: (95, 116, 144), growth: (58, 74, 106), snow: (204, 209, 219), snow_line: 0.25, water: 0, trees: 0, haze: 0, mist: 0.3),
        ]),
        // Layer on layer fading into mist: four ranges, low contrast.
        (name: "misty", sky: ((92, 128, 196), (176, 196, 226)), clouds: (many: 1.2, big: 0.9, lit: (236, 240, 250), shade: (162, 178, 212), foot: 18),
         layers: [
            (every: 70, size: (0.07, 0.14), slope: (0.9, 1.5), rough: 1, base: 0.5,
             ground: (151, 167, 192), growth: (131, 148, 187), snow: (204, 209, 219), snow_line: 0.25, water: 0, trees: 0, haze: 0.55, mist: 0.9),
            (every: 90, size: (0.07, 0.15), slope: (0.9, 1.5), rough: 1, base: 0.5,
             ground: (136, 153, 187), growth: (110, 128, 176), snow: (204, 209, 219), snow_line: 0.2, water: 0, trees: 0, haze: 0.4, mist: 0.9),
            (every: 120, size: (0.085, 0.18), slope: (0.8, 1.5), rough: 1, base: 0.5,
             ground: (119, 136, 180), growth: (88, 104, 162), snow: (204, 209, 219), snow_line: 0.15, water: 0, trees: 0, haze: 0.22, mist: 0.9),
            (every: 170, size: (0.085, 0.195), slope: (0.9, 1.6), rough: 1, base: 0.5,
             ground: (92, 105, 158), growth: (63, 74, 131), snow: (204, 209, 219), snow_line: 0, water: 0, trees: 0, haze: 0.05, mist: 0.8),
        ]),
        // Warmer: violet and rose ranges (a stranger place).
        (name: "violet", sky: ((86, 104, 196), (196, 176, 222)), clouds: (many: 1, big: 1, lit: (252, 240, 248), shade: (180, 150, 200), foot: 18),
         layers: [
            (every: 90, size: (0.07, 0.15), slope: (0.9, 1.6), rough: 1, base: 0.5,
             ground: (189, 167, 192), growth: (144, 119, 176), snow: (204, 209, 219), snow_line: 0.3, water: 0, trees: 0, haze: 0.45, mist: 0.6),
            (every: 130, size: (0.095, 0.22), slope: (0.8, 1.5), rough: 1, base: 0.5,
             ground: (192, 173, 197), growth: (115, 92, 158), snow: (204, 209, 219), snow_line: 0.25, water: 0, trees: 0, haze: 0.12, mist: 0.5),
            (every: 220, size: (0.085, 0.235), slope: (0.9, 1.7), rough: 1, base: 0.5,
             ground: (119, 87, 150), growth: (68, 47, 108), snow: (204, 209, 219), snow_line: 0, water: 0, trees: 0, haze: 0, mist: 0.25),
        ]),
        // Needles: narrow, steep, crowded.
        (name: "needles", sky: ((70, 118, 206), (150, 188, 232)), clouds: (many: 1, big: 1, lit: (246, 248, 255), shade: (150, 172, 214), foot: 18),
         layers: [
            (every: 45, size: (0.085, 0.165), slope: (0.35, 0.7), rough: 1, base: 0.5,
             ground: (167, 180, 201), growth: (115, 135, 180), snow: (204, 209, 219), snow_line: 0.3, water: 0, trees: 0, haze: 0.45, mist: 0.6),
            (every: 70, size: (0.11, 0.235), slope: (0.3, 0.65), rough: 1, base: 0.5,
             ground: (175, 187, 206), growth: (94, 113, 171), snow: (204, 209, 219), snow_line: 0.25, water: 0, trees: 0, haze: 0.12, mist: 0.5),
            (every: 120, size: (0.095, 0.25), slope: (0.35, 0.8), rough: 1, base: 0.5,
             ground: (99, 109, 167), growth: (52, 59, 122), snow: (204, 209, 219), snow_line: 0, water: 0, trees: 0, haze: 0, mist: 0.25),
        ]),
        // Low and broad: old worn ranges, big skies, more cloud.
        (name: "broad", sky: ((64, 112, 204), (150, 190, 236)), clouds: (many: 1.4, big: 1.2, lit: (246, 248, 255), shade: (150, 172, 214), foot: 18),
         layers: [
            (every: 120, size: (0.04, 0.095), slope: (1.6, 2.8), rough: 1, base: 0.5,
             ground: (160, 175, 199), growth: (117, 137, 184), snow: (204, 209, 219), snow_line: 0.3, water: 0, trees: 0, haze: 0.45, mist: 0.6),
            (every: 170, size: (0.055, 0.125), slope: (1.4, 2.6), rough: 1, base: 0.5,
             ground: (150, 167, 197), growth: (90, 110, 167), snow: (204, 209, 219), snow_line: 0.2, water: 0, trees: 0, haze: 0.15, mist: 0.5),
            (every: 260, size: (0.04, 0.11), slope: (1.8, 3), rough: 1, base: 0.5,
             ground: (82, 100, 144), growth: (50, 63, 112), snow: (204, 209, 219), snow_line: 0, water: 0, trees: 0, haze: 0, mist: 0.3),
        ]),
        // The plains' (the start valley's): low mountains far off in the
        // haze, a little snow on their tops; a wood, a bushy band of big
        // crowns, its floor dark under them; before it a meadow of rolling
        // grass, lighter and darker bands, flowers and small mushrooms
        // scattered over it (the world's own grass in front). No clouds.
        (name: "meadow", sky: ((86, 150, 210), (196, 222, 236)), clouds: (many: 0, big: 1, lit: (255, 255, 255), shade: (206, 218, 236), foot: 130),
         layers: [
            (every: 120, size: (0.09, 0.19), slope: (0.9, 1.5), rough: 1, base: 0.5,
             ground: (150, 162, 196), growth: (112, 124, 166), snow: (214, 220, 232), snow_line: 0.14, water: 0, trees: 0, haze: 0.5, mist: 0.6),
            (every: 90, size: (0.012, 0.03), slope: (1.5, 2.5), rough: 0, base: 0.5, crowns: 14,
             ground: (52, 132, 118), growth: (92, 164, 74), snow: (204, 209, 219), snow_line: 0, water: 0, trees: 1, haze: 0.06, mist: 0.1),
            (every: 100, size: (0.05, 0.11), slope: (1.6, 2.6), rough: 0, base: 0.5, decor: 1,
             ground: (148, 206, 78), growth: (110, 168, 68), snow: (204, 209, 219), snow_line: 0, water: 0, trees: 0.45, haze: 0, mist: 0),
        ]),
    ],
)
