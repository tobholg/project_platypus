        (id: "blast", name: "Blast", mana: 16, color: (255, 150, 60), kind: Payload(Blast(radius: 24, power: 110)),
            look: (burst: (count: 70, life: (0.2, 0.7), colors: [(255, 255, 230), (255, 210, 90), (255, 120, 30), (150, 50, 20), (60, 50, 50)], speed: 255, drag: 3.5, gravity: 45, size: 1.5, glow: true))),
        (id: "ignite", name: "Ignite", mana: 3, color: (255, 120, 40), kind: Payload(Ignite(radius: 9)),
            look: (burst: (count: 30, life: (0.8, 1.8), colors: [(120, 100, 90), (70, 66, 64), (40, 40, 40)], speed: 45, gravity: -33, drag: 1.5, size: 2))),
        (id: "heat", name: "Heat", mana: 6, color: (255, 90, 30), kind: Payload(Heat(radius: 9, amount: 500)),
            look: (burst: (count: 24, life: (0.3, 0.8), colors: [(255, 200, 120), (255, 90, 30), (120, 30, 10)], speed: 60, gravity: -45, drag: 2, glow: true))),
        (id: "frost", name: "Frost", mana: 6, color: (160, 220, 255), kind: Payload(Heat(radius: 11, amount: -120)),
