        // A net of web, flung: it sticks where it lands (and on whoever's
        // there), and a spider can climb it.
        (id: "web_glob", name: "Web net", mana: 4, color: (220, 215, 240), kind: Payload(Matter(material: "cobweb", cells: 110)),
