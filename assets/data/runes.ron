                   burst: (count: 18, life: (0.25, 0.6), colors: [(220, 255, 150), (110, 200, 40), (50, 110, 20)], speed: 105, spread: 1.4, gravity: 240, drag: 1))),
        // A glutton's ice: a shard that stabs (and the cold of it).
        (id: "ice_shard", name: "Ice shard", mana: 2, color: (200, 235, 255), kind: Payload(Damage(11)),
            look: (trail: (count: 0.9, life: (0.15, 0.4), colors: [(255, 255, 255), (200, 235, 255), (120, 180, 235)], speed: 10, gravity: 60, glow: true),
                   burst: (count: 22, life: (0.25, 0.7), colors: [(255, 255, 255), (190, 230, 255), (110, 170, 230)], speed: 130, spread: 1.5, gravity: 260, drag: 1))),
        // Jan Willy's finger: a little flame that burns.
        (id: "finger_burn", name: "Finger burn", mana: 2, color: (255, 150, 60), kind: Payload(Damage(10)),
            look: (burst: (count: 20, life: (0.15, 0.45), colors: [(255, 250, 200), (255, 170, 60), (200, 70, 20)], speed: 120, spread: 1.4, drag: 3, glow: true))),
        (id: "acid_drops", name: "Acid drops", mana: 2, color: (120, 240, 60), kind: Payload(Matter(material: "acid", cells: 32))),
        // A spider's: a lot of acid, splashing over what it hits.
        // A watcher's spit: purple, splashing blight where it lands.
        (id: "blight_bite", name: "Blight", mana: 2, color: (170, 70, 220), kind: Payload(Damage(7)),
            look: (trail: (count: 0.9, life: (0.2, 0.5), colors: [(230, 170, 255), (150, 50, 200), (70, 20, 100)], speed: 8, gravity: 180, glow: true),
                   burst: (count: 22, life: (0.25, 0.6), colors: [(230, 180, 255), (150, 50, 200), (60, 20, 90)], speed: 110, spread: 1.4, gravity: 240, drag: 1, glow: true))),
        // A frost wraith's spray: a shard of ice that bites.
        // A breath of frost, shard by shard (`frost_breath`: a wraith's,
        // and the rimebreath staff's): each a mote of ice that bites and
        // chills, slow and short-lived, mist smearing off it.
        (id: "frost_bite", name: "Frost bite", mana: 1, color: (190, 230, 255), kind: Payload(Damage(3)),
            look: (burst: (count: 5, life: (0.2, 0.5), colors: [(240, 250, 255), (190, 225, 255)], speed: 40, spread: 1.6, drag: 3, glow: true))),
        (id: "rime_shard", name: "Rime shard", mana: 1, color: (200, 235, 255), kind: Carrier(Bolt(speed: 400, life: 0.6)),
            look: (trail: (count: 0.9, life: (0.3, 0.9), colors: [(255, 255, 255), (215, 238, 255), (165, 210, 245), (120, 175, 230)], speed: 38, spread: 1.2, drag: 3.5, gravity: -14, size: 2.0, glow: true))),
        // Its cold, a little at a time: enough, shard on shard, to freeze
        // the water it lands in.
        (id: "rime", name: "Rime", mana: 0.3, color: (170, 220, 255), kind: Payload(Heat(radius: 5, amount: -70))),
        // Out as a spray: a fistful at once, flung wide, each at its own
        // pace (it leaves tight and flares).
        (id: "breath", name: "Breath", mana: 1.5, kind: Modifier(Spray(count: 5, spread: 15, pace: (0.55, 1.15)))),
        // Slowing in the air: it billows out and dies.
        (id: "billow", name: "Billow", mana: 0.2, kind: Modifier(Drag(2.4))),
        // A crimson head's vomit: a gob of plague blood, splashing.
