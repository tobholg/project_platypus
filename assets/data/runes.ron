// Runes (DESIGN §7b): what wands are made of. A wand (items.ron) holds rune
// ids in order; a cast reads them left to right: modifiers until a carrier,
// the payloads after it, and with a `Trigger` the rest of the wand is cast
// where it lands.
//
// mana: cost a cast · color: its glow (the projectile and its light; a cast
// takes its last payload's)
// Carrier(Bolt(speed, life) | Orb(speed, life, bounces)
//         | Stream(material, rate, speed, spread, burning, life: flames' seconds; reach = speed × life)
//         | Lightning(range, targets)
//         | Well(radius, strength, lift, pull, grip, drain): a well held open at the
//           cursor while the wand is: pulls in the loose, tears out solids up to
//           `strength` hardness (`pull` tries a tick), holds what it can `lift` (a
//           cell weighs its density against water's, a body its size: an orc 168)
//           in a spinning ball with `grip` cells/s², costs `drain` mana a second
//         | Force(radius, power, strength, pull, drain): from the caster's hand, a
//           cone toward the cursor out to `radius`: the left button flings
//           everything in it away (up to `power` cells/s nearest), the right
//           drags it in
//         | Wall(material, width, height, range, hold): a wall of the material raised
//           on the ground below where it's aimed (open cells only, not where a
//           body is if it's solid); `hold` s: kept filled that long (fire)
//         | Brush(solid, loose, radius, range, per_cell, set, stream, through,
//           lasts, sound): held, it paints where it's aimed: `solid` where it's
//           held up (ground, or what it painted that is), else `loose`, falling;
//           `per_cell` mana a cell; `set`/`stream`: sparks as cells set, and
//           along it (magic/brush.rs)
//         | Field(kind, radius, range, lasts, most, through, sound): bent space
//           opened where it's aimed, `lasts` s: Repulse or Slow (a bubble), Lift
//           (a column up to the rock above); `most` of a kind kept (magic/field.rs)
//         | Cloud(material, radius, range): a disc of a gas conjured where it's aimed
//         | Call(range, height, speed, sky, lightning): down from above onto where it's
//           aimed: its payloads ride something falling from `height` up at `speed`
//           (a meteor), or with `lightning` the sky's lightning out of a storm
//           forced over the spot; `sky`: only under open sky
//         | Beam(range, width): held, an instant line from the hand to the first
//           thing in its way (not air, gas or flame), `width` cells across; its
//           payloads go off at its tip every tick (so its mana is a tick's, and
//           its payloads are small: a tick's worth))
// A channelled spell's mana doesn't come back while it's held.
// Payload(Damage(hp) | Blast(radius, power) | Heat(radius, amount °C)
//         | Ignite(radius) | Matter(material, cells) | Knock(cells/s)
//         | Shatter(radius, hardness): breaks what it lands on, no harder, into flying bits
//         | Vaporise(radius, power, hardness): eats what it lands on, no harder: each
//           cell takes `power` (less at the rim) until that reaches its hardness,
//           and goes up in smoke (dirt at once, stone in a moment, bedrock never)
//         | Nova(radius, power): a burst that hurts and throws what's near, as a
//           blast of that power, leaving the cells be
//         | Arc: a spark of lightning where it lands, into water and what's wet
//         | Blink: the caster is where it lands (beside what it hit), moving as they were
//         | Portal: a portal where it lands, facing out of what it hit: the caster's
//           first, then second, of a pair; what goes into one comes out of the other
//         | Stasis(radius, secs): a bubble where it lands: what's in it is held, and
//           goes on as it was when it bursts)
// Modifier(Gravity(k) | Trail(material, burning) | Shed(material, cells, burning)
//          | Speed(k) | Trigger)
//
// look (optional, visual only): trail = sparks it leaves as it flies (count a
// cell; a stream's come out of the wand with it), burst = sparks where it
// lands (count at once, off the surface it hit). A cast shows every rune's.
//   (count, life: (s, s), colors: [first .. last], speed: cells/s,
//    spread: radians either side (3.14 all round), gravity: cells/s² (− rises),
//    drag: share of speed lost a second, size: cells, jitter: crackle, glow)
(
    runes: [
        // ---- carriers ----
        (id: "bolt", name: "Bolt", mana: 4, color: (190, 210, 255), kind: Carrier(Bolt(speed: 630, life: 0.9)),
            look: (trail: (count: 0.5, life: (0.08, 0.2), colors: [(230, 240, 255), (120, 160, 255)], speed: 15, drag: 4, glow: true))),
        // A strider's missile: slow, smoking, it homes (`homing`).
        (id: "missile", name: "Missile", mana: 6, color: (255, 190, 110), kind: Carrier(Bolt(speed: 230, life: 3.5)),
            look: (trail: (count: 3, life: (0.4, 1.1), colors: [(255, 225, 170), (175, 170, 165), (115, 112, 110), (70, 70, 72)], speed: 12, spread: 0.7, gravity: -25, drag: 1.5, size: 2))),
        // A strider's laser: a quick red bolt (creatures' own).
        (id: "laser", name: "Laser", mana: 3, color: (255, 70, 50), kind: Carrier(Bolt(speed: 900, life: 0.45)),
            look: (trail: (count: 3, life: (0.04, 0.12), colors: [(255, 245, 230), (255, 90, 60), (150, 20, 10)], speed: 8, drag: 6, size: 1.2, glow: true))),
        (id: "arrow", name: "Arrow", mana: 5, color: (220, 220, 200), kind: Carrier(Bolt(speed: 450, life: 2.5)),
            look: (trail: (count: 0.3, life: (0.1, 0.25), colors: [(240, 240, 220), (140, 140, 120)], speed: 6, drag: 3))),
        (id: "orb", name: "Orb", mana: 10, color: (255, 150, 60), kind: Carrier(Orb(speed: 345, life: 3.0, bounces: 2)),
            look: (burst: (count: 12, life: (0.15, 0.35), colors: [(255, 250, 220), (255, 190, 90)], speed: 135, spread: 1.2, drag: 4, glow: true))),
        (id: "flame_stream", name: "Flame stream", mana: 1.2, color: (255, 140, 40),
            kind: Carrier(Stream(material: "oil", rate: 27, speed: 450, spread: 0.1, burning: true, life: 0.33)),
            look: (trail: (count: 4, life: (0.15, 0.4), colors: [(255, 250, 210), (255, 200, 70), (255, 110, 30), (160, 40, 20)], speed: 420, spread: 0.18, gravity: -90, drag: 2.5, size: 1.5, glow: true))),
        // A spray of acid: it eats what it lands on.
        (id: "acid_stream", name: "Acid stream", mana: 1.2, color: (120, 240, 60),
            kind: Carrier(Stream(material: "acid", rate: 18, speed: 420, spread: 0.12, burning: false, life: 0.3)),
            look: (trail: (count: 3, life: (0.15, 0.35), colors: [(220, 255, 170), (150, 245, 70), (90, 200, 40)], speed: 390, spread: 0.16, gravity: -40, drag: 2.5, size: 1.3, glow: true))),
        (id: "lightning", name: "Lightning", mana: 25, color: (200, 220, 255), kind: Carrier(Lightning(range: 270, targets: 3)),
            look: (burst: (count: 26, life: (0.1, 0.35), colors: [(255, 255, 255), (170, 200, 255), (70, 110, 255)], speed: 165, drag: 5, jitter: 135, glow: true))),

        // Levels: bigger, lifts more, tears out harder rock.
        (id: "gravity_well", name: "Gravity well I", mana: 6, color: (150, 110, 255),
            kind: Carrier(Well(radius: 27, strength: 60, lift: 1013, pull: 90, grip: 7500, drain: 9)),
            look: (trail: (count: 3, life: (0.3, 0.8), colors: [(220, 205, 255), (140, 100, 240), (50, 30, 100)], speed: 90, drag: 1, glow: true))),
        (id: "gravity_well_ii", name: "Gravity well II", mana: 10, color: (150, 110, 255),
            kind: Carrier(Well(radius: 39, strength: 85, lift: 3600, pull: 158, grip: 10500, drain: 12)),
            look: (trail: (count: 5, life: (0.3, 0.9), colors: [(230, 215, 255), (150, 105, 250), (50, 30, 100)], speed: 105, drag: 1, glow: true))),
        (id: "force", name: "Force I", mana: 4, color: (140, 200, 255),
            kind: Carrier(Force(radius: 60, power: 450, strength: 30, pull: 105, drain: 18)),
            look: (trail: (count: 6, life: (0.15, 0.4), colors: [(240, 250, 255), (140, 195, 255), (40, 80, 160)], speed: 300, drag: 1.5, glow: true))),
        (id: "force_ii", name: "Force II", mana: 8, color: (140, 200, 255),
            kind: Carrier(Force(radius: 90, power: 750, strength: 65, pull: 225, drain: 26)),
            look: (trail: (count: 9, life: (0.15, 0.45), colors: [(245, 252, 255), (150, 205, 255), (40, 80, 160)], speed: 420, drag: 1.5, glow: true))),

        // A beam's carrier (its payloads are a tick's worth) ...
        (id: "ray", name: "Ray", mana: 0.25, color: (255, 255, 255), kind: Carrier(Beam(range: 225, width: 3))),
        (id: "cutting_ray", name: "Cutting ray", mana: 0.35, color: (255, 250, 230), kind: Carrier(Beam(range: 165, width: 5))),
        // Walls and clouds.
        // Painted (magic/brush.rs): ice where it's held up (ground, or ice it
        // painted that is: as far as the mana lasts), snow where it isn't.
        (id: "ice_wall", name: "Ice brush", mana: 0, color: (190, 230, 255), kind: Carrier(Brush(solid: "ice", loose: "snow", radius: 3.4, range: 280, per_cell: 0.15, sound: Some("frost_set"),
            set: Some((count: 4, life: (0.25, 0.6), colors: [(255, 255, 255), (210, 240, 255), (150, 205, 245)], speed: 30, spread: 3.14, gravity: 20, drag: 3, glow: true)),
            stream: Some((count: 1, life: (0.15, 0.35), colors: [(240, 250, 255), (170, 215, 250)], speed: 40, spread: 0.3, drag: 2, glow: true)))),
            look: (burst: (count: 0, life: (0.1, 0.2), colors: [(255, 255, 255)]))),
        // The rimebreath staff's: no line of sight wanted (it paints where
        // the cursor is), bigger, further.
        (id: "glacier_brush", name: "Glacier brush", mana: 0, color: (150, 210, 255), kind: Carrier(Brush(solid: "ice", loose: "snow", radius: 4.4, range: 320, per_cell: 0.15, through: true, sound: Some("frost_set"),
            set: Some((count: 6, life: (0.3, 0.8), colors: [(255, 255, 255), (190, 230, 255), (110, 175, 240)], speed: 38, spread: 3.14, gravity: 18, drag: 3, glow: true)),
            stream: Some((count: 1, life: (0.2, 0.45), colors: [(225, 245, 255), (130, 190, 250)], speed: 46, spread: 0.35, drag: 2, glow: true)))),
            look: (burst: (count: 0, life: (0.1, 0.2), colors: [(255, 255, 255)]))),
        // Painted (magic/brush.rs): flame where it's held up (ground, or the
        // flames it painted: a wall of fire off the ground),
        // kept burning five seconds; embers in the open air.
        (id: "fire_wall", name: "Fire brush", mana: 0, color: (255, 130, 40), kind: Carrier(Brush(solid: "fire", loose: "fire", radius: 2.8, range: 260, per_cell: 0.15, lasts: 5.0, sound: Some("ignite"),
            set: Some((count: 3, life: (0.25, 0.6), colors: [(255, 245, 200), (255, 170, 60), (220, 70, 20)], speed: 30, spread: 0.7, gravity: -110, drag: 2, glow: true)),
            stream: Some((count: 1, life: (0.12, 0.3), colors: [(255, 230, 150), (255, 130, 40)], speed: 40, spread: 0.35, gravity: -30, drag: 2, glow: true)))),
            look: (burst: (count: 0, life: (0.1, 0.2), colors: [(255, 255, 255)]))),
        // Fields (magic/field.rs): bent space opened where it's aimed, eight
        // seconds. A repulsor (a bubble) throws back what walks in and turns
        // back what's shot through it; in a slow field (a bubble) everything
        // runs at an eighth; an updraft (a column) rises from there to the
        // rock above, lifting what's in it.
        (id: "repulsor", name: "Repulsor", mana: 22, color: (140, 200, 255), kind: Carrier(Field(kind: Repulse, radius: 48, range: 420, lasts: 8.0, sound: Some("field_set"))),
            look: (burst: (count: 0, life: (0.1, 0.2), colors: [(255, 255, 255)]))),
        (id: "slow_field", name: "Slow field", mana: 26, color: (170, 120, 255), kind: Carrier(Field(kind: Slow, radius: 64, range: 420, lasts: 8.0, sound: Some("slow_set"))),
            look: (burst: (count: 0, life: (0.1, 0.2), colors: [(255, 255, 255)]))),
        (id: "updraft", name: "Updraft", mana: 18, color: (130, 235, 210), kind: Carrier(Field(kind: Lift, radius: 11, range: 450, lasts: 8.0, most: 3, sound: Some("updraft"))),
            look: (burst: (count: 0, life: (0.1, 0.2), colors: [(255, 255, 255)]))),
        // An elder watcher's: a cloud of blight where it lands, lingering.
        (id: "blight_cloud", name: "Blight cloud", mana: 10, color: (150, 60, 200), kind: Carrier(Cloud(material: "blight_fog", radius: 13, range: 300)),
            look: (burst: (count: 34, life: (0.5, 1.2), colors: [(220, 160, 255), (150, 60, 200), (80, 30, 110)], speed: 60, gravity: 10, drag: 2, glow: true))),
        (id: "toxic_cloud", name: "Toxic cloud", mana: 18, color: (150, 190, 70), kind: Carrier(Cloud(material: "miasma", radius: 15, range: 225)),
            look: (burst: (count: 30, life: (0.5, 1.2), colors: [(190, 220, 110), (140, 110, 160), (90, 120, 40)], speed: 60, gravity: 15, drag: 2))),
        // Called down from above.
        (id: "call_lightning", name: "Call lightning", mana: 30, color: (200, 220, 255), kind: Carrier(Call(range: 360, height: 330, sky: true, lightning: true))),
        (id: "meteor", name: "Meteor", mana: 22, color: (255, 120, 40), kind: Carrier(Call(range: 330, height: 390, speed: 570, sky: true)),
            look: (trail: (count: 3, life: (0.3, 0.9), colors: [(255, 250, 210), (255, 180, 60), (220, 70, 20), (90, 60, 50)], speed: 30, drag: 1.5, size: 2, gravity: -45, glow: true))),
        (id: "impact", name: "Impact", mana: 24, color: (255, 150, 60), kind: Payload(Blast(radius: 33, power: 150)),
            look: (burst: (count: 120, life: (0.3, 1.0), colors: [(255, 255, 230), (255, 210, 90), (255, 120, 30), (150, 50, 20), (60, 50, 50)], speed: 330, drag: 3, gravity: 90, size: 2, glow: true))),
        (id: "molten", name: "Molten", mana: 8, color: (255, 110, 30), kind: Payload(Matter(material: "magma", cells: 135))),
        // Void.
        (id: "void_bolt", name: "Void bolt", mana: 6, color: (180, 130, 255), kind: Carrier(Bolt(speed: 840, life: 0.6)),
            look: (trail: (count: 1.0, life: (0.15, 0.4), colors: [(240, 220, 255), (160, 110, 255), (60, 30, 130)], speed: 15, drag: 3, glow: true))),
        // A dread knight's void: a quick orb (weave between them, early),
        // dark smoke behind it, and what it does to you.
        (id: "dread_orb", name: "Dread orb", mana: 6, color: (150, 90, 230), kind: Carrier(Bolt(speed: 420, life: 1.8)),
            look: (trail: (count: 1.6, life: (0.25, 0.7), colors: [(230, 200, 255), (130, 70, 220), (50, 20, 90), (20, 8, 34)], speed: 12, drag: 2, size: 1.4, glow: true),
                   burst: (count: 40, life: (0.3, 0.8), colors: [(240, 220, 255), (140, 80, 230), (40, 16, 70)], speed: 140, spread: 3.14, drag: 3, glow: true))),
        (id: "void_haze", name: "Void haze", mana: 2, color: (60, 30, 100), kind: Modifier(Trail(material: "void_smoke", burning: false))),
        (id: "void_bite", name: "Void bite", mana: 2, color: (150, 90, 230), kind: Payload(Damage(8))),
        // (And it bursts where it strikes: a little void blast, the ground
        // left be.)
        (id: "void_burst", name: "Void burst", mana: 4, color: (150, 90, 230), kind: Payload(Nova(radius: 13, power: 24)),
            look: (burst: (count: 70, life: (0.25, 0.7), colors: [(245, 230, 255), (160, 100, 240), (70, 30, 130), (20, 8, 34)], speed: 190, spread: 3.14, drag: 3, size: 1.5, glow: true))),
        (id: "stasis_orb", name: "Stasis orb", mana: 10, color: (170, 140, 255), kind: Carrier(Orb(speed: 360, life: 1.0, bounces: 0)),
            look: (trail: (count: 0.8, life: (0.2, 0.5), colors: [(230, 220, 255), (150, 120, 240)], speed: 9, drag: 3, glow: true))),
        (id: "blink", name: "Blink", mana: 6, color: (200, 160, 255), kind: Payload(Blink)),
        (id: "portal", name: "Portal", mana: 8, color: (150, 120, 255), kind: Payload(Portal)),
        (id: "stasis", name: "Stasis", mana: 16, color: (170, 140, 255), kind: Payload(Stasis(radius: 33, secs: 4))),
        // A star: a bouncing orb of light.
        (id: "star", name: "Star", mana: 8, color: (255, 245, 200), kind: Carrier(Orb(speed: 405, life: 2.5, bounces: 2)),
            look: (trail: (count: 1.2, life: (0.15, 0.45), colors: [(255, 255, 255), (255, 240, 170), (255, 200, 90)], speed: 18, drag: 3, glow: true))),

        // ---- payloads ----
        // ... and a beam's (a tick's worth each: 60 a second).
        (id: "ray_burn", name: "Burning", mana: 0.05, color: (255, 150, 60), kind: Payload(Damage(0.35))),
        (id: "ray_ignite", name: "Kindling", mana: 0.05, color: (255, 130, 40), kind: Payload(Ignite(radius: 2))),
        (id: "ray_heat", name: "Searing", mana: 0.2, color: (255, 140, 50), kind: Payload(Heat(radius: 3, amount: 70)),
            look: (trail: (count: 0.05, life: (0.15, 0.4), colors: [(255, 240, 180), (255, 160, 50), (200, 60, 20)], speed: 30, spread: 0.5, gravity: -90, drag: 2, glow: true),
                   burst: (count: 3, life: (0.15, 0.45), colors: [(255, 250, 210), (255, 180, 60), (220, 70, 20)], speed: 90, spread: 1.2, gravity: -120, drag: 2, glow: true))),
        (id: "ray_chill", name: "Numbing", mana: 0.05, color: (190, 230, 255), kind: Payload(Damage(0.2))),
        (id: "ray_frost", name: "Freezing", mana: 0.25, color: (175, 225, 255), kind: Payload(Heat(radius: 2, amount: -350)),
            look: (trail: (count: 0.04, life: (0.3, 0.8), colors: [(255, 255, 255), (190, 230, 255)], speed: 12, gravity: 30, drag: 3, glow: true),
                   burst: (count: 3, life: (0.3, 0.8), colors: [(255, 255, 255), (200, 235, 255), (130, 190, 240)], speed: 68, spread: 1.3, gravity: 60, drag: 2, glow: true))),
        (id: "ray_sear", name: "Searing light", mana: 0.1, color: (255, 240, 200), kind: Payload(Damage(0.8))),
        (id: "ray_boil", name: "White heat", mana: 0.1, color: (255, 230, 180), kind: Payload(Heat(radius: 2, amount: 150))),
        (id: "vaporise", name: "Vaporise", mana: 0.3, color: (255, 236, 170), kind: Payload(Vaporise(radius: 3, power: 14, hardness: 130)),
            look: (trail: (count: 0.06, life: (0.1, 0.3), colors: [(255, 255, 255), (255, 230, 150)], speed: 38, drag: 3, glow: true),
                   burst: (count: 5, life: (0.1, 0.35), colors: [(255, 255, 255), (255, 235, 160), (255, 160, 60)], speed: 135, spread: 1.2, drag: 3, glow: true))),
        // A star bomb's burst: soft ground gone, what's near thrown.
        (id: "starburst", name: "Starburst", mana: 10, color: (255, 240, 180), kind: Payload(Vaporise(radius: 17, power: 255, hardness: 65)),
            look: (burst: (count: 90, life: (0.2, 0.8), colors: [(255, 255, 255), (255, 245, 190), (255, 210, 110), (200, 140, 60)], speed: 285, drag: 3.5, size: 1.5, glow: true))),
        (id: "nova", name: "Nova", mana: 6, color: (255, 250, 220), kind: Payload(Nova(radius: 20, power: 55))),
        (id: "arc", name: "Arc", mana: 4, color: (200, 220, 255), kind: Payload(Arc)),
        // (The iron strider's rockets: a third of a bomb each, through stone,
        // brick and iron; four to a salvo.)
        (id: "missile_blast", name: "Missile blast", mana: 6, color: (255, 150, 60), kind: Payload(Blast(radius: 30, power: 130)),
            look: (burst: (count: 110, life: (0.3, 1.0), colors: [(255, 255, 230), (255, 210, 90), (255, 120, 30), (150, 50, 20), (60, 50, 50)], speed: 310, drag: 3, gravity: 80, size: 2, glow: true))),
        (id: "laser_burn", name: "Laser burn", mana: 1, color: (255, 70, 50), kind: Payload(Damage(11)),
            look: (burst: (count: 12, life: (0.06, 0.2), colors: [(255, 250, 230), (255, 120, 70), (160, 30, 15)], speed: 110, spread: 1.2, drag: 5, glow: true))),
        (id: "spark", name: "Spark", mana: 1, color: (190, 210, 255), kind: Payload(Damage(14)),
            look: (trail: (count: 0.6, life: (0.05, 0.15), colors: [(255, 255, 255), (140, 180, 255)], speed: 30, jitter: 180, glow: true),
                   burst: (count: 14, life: (0.08, 0.25), colors: [(255, 255, 255), (150, 190, 255), (60, 90, 230)], speed: 120, spread: 1.3, drag: 5, jitter: 120, glow: true))),
        (id: "knock", name: "Knock", mana: 1, color: (190, 210, 255), kind: Payload(Knock(390))),
        (id: "shatter", name: "Shatter", mana: 2, color: (200, 190, 170), kind: Payload(Shatter(radius: 5, hardness: 60)),
            look: (burst: (count: 10, life: (0.2, 0.5), colors: [(220, 210, 190), (140, 130, 120)], speed: 90, spread: 1.2, gravity: 180, drag: 2))),
        (id: "blast", name: "Blast", mana: 16, color: (255, 150, 60), kind: Payload(Blast(radius: 24, power: 110)),
            look: (burst: (count: 70, life: (0.2, 0.7), colors: [(255, 255, 230), (255, 210, 90), (255, 120, 30), (150, 50, 20), (60, 50, 50)], speed: 255, drag: 3.5, gravity: 45, size: 1.5, glow: true))),
        (id: "ignite", name: "Ignite", mana: 3, color: (255, 120, 40), kind: Payload(Ignite(radius: 9)),
            look: (burst: (count: 30, life: (0.8, 1.8), colors: [(120, 100, 90), (70, 66, 64), (40, 40, 40)], speed: 45, gravity: -33, drag: 1.5, size: 2))),
        (id: "heat", name: "Heat", mana: 6, color: (255, 90, 30), kind: Payload(Heat(radius: 9, amount: 500)),
            look: (burst: (count: 24, life: (0.3, 0.8), colors: [(255, 200, 120), (255, 90, 30), (120, 30, 10)], speed: 60, gravity: -45, drag: 2, glow: true))),
        (id: "frost", name: "Frost", mana: 6, color: (160, 220, 255), kind: Payload(Heat(radius: 11, amount: -120)),
            look: (burst: (count: 30, life: (0.4, 1.0), colors: [(255, 255, 255), (180, 230, 255), (120, 180, 230)], speed: 75, gravity: 30, drag: 2, glow: true))),
        (id: "acid", name: "Acid", mana: 10, color: (120, 240, 60), kind: Payload(Matter(material: "acid", cells: 585)),
            look: (trail: (count: 0.7, life: (0.25, 0.6), colors: [(210, 255, 140), (120, 230, 50), (40, 110, 20)], speed: 9, gravity: 210, glow: true),
                   burst: (count: 36, life: (0.3, 0.8), colors: [(220, 255, 150), (110, 220, 40), (50, 120, 20)], speed: 165, spread: 1.4, gravity: 240, drag: 1, glow: true))),
        (id: "water", name: "Water", mana: 5, color: (80, 140, 255), kind: Payload(Matter(material: "water", cells: 270)),
            look: (trail: (count: 0.5, life: (0.2, 0.5), colors: [(200, 230, 255), (70, 130, 240)], speed: 8, gravity: 180),
                   burst: (count: 30, life: (0.3, 0.7), colors: [(220, 240, 255), (80, 140, 255)], speed: 150, spread: 1.4, gravity: 240))),

        // ---- modifiers ----
        // A spider's spit: the glob itself (it stings), and a few drops of
