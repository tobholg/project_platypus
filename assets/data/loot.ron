            (item: "bomb", weight: 8, count: (1, 3)),
            (item: "iron_helm", weight: 5, count: (1, 1)),
            (item: "chainmail", weight: 4, count: (1, 1)),
            (item: "iron_gauntlets", weight: 4, count: (1, 1)),
            (item: "iron_greaves", weight: 4, count: (1, 1)),
            (item: "iron_boots", weight: 4, count: (1, 1)),
            (item: "ring_of_vigour", weight: 3, count: (1, 1)),
        ]),
        (name: "skeleton", rolls: (1, 2), entries: [
            (item: "nothing", weight: 25, count: (1, 1)),
            (item: "cloth_hood", weight: 5, count: (1, 1)),
