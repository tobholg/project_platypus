// What's in a chest the first time it's opened, by how deep it is (cells below
// sea level, large world). Rolled from the world seed and the chest's place,
// so the same chest always holds the same things.
//
// rolls: (min, max) draws · each draw picks an entry by weight · count: (min,
// max) whole items (blocks: whole blocks) · several draws of one item stack ·
// "nothing" is an entry that gives nothing (a draw that comes up empty).
//
// A chest's table has `deeper_than`; a creature's has none and is named by
// its creature file (`loot`): rolled into its body when it dies, at the
// depth it died, with the player's luck. What it wears is in the body too.
// Item ids from items.ron (or gear.ron), or "block:<material>". Gear is
// rolled as it's found: a rarity and bonuses, its item level from the depth
// (a level every 150 cells down).
(
    tables: [
        // Above the underground: castles, the bottoms of lakes.
        (name: "high", deeper_than: -100000, rolls: (3, 5), entries: [
            (item: "torch", weight: 20, count: (4, 10)),
            (item: "bomb", weight: 14, count: (2, 5)),
            (item: "glowstick", weight: 12, count: (2, 6)),
            (item: "block:silver_ore", weight: 10, count: (4, 12)),
            (item: "block:gold_ore", weight: 7, count: (3, 8)),
            (item: "block:amethyst", weight: 6, count: (1, 3)),
            (item: "block:emerald", weight: 4, count: (1, 3)),
            (item: "block:ruby", weight: 2, count: (1, 2)),
            (item: "iron_pickaxe", weight: 6, count: (1, 1)),
            (item: "gold_pickaxe", weight: 3, count: (1, 1)),
            (item: "leather_cap", weight: 4, count: (1, 1)),
            (item: "leather_boots", weight: 4, count: (1, 1)),
            (item: "ring_of_vigour", weight: 2, count: (1, 1)),
            (item: "lucky_coin", weight: 1, count: (1, 1)),
        ]),
        (name: "underground", deeper_than: 0, rolls: (2, 4), entries: [
            (item: "torch", weight: 30, count: (4, 10)),
            (item: "glowstick", weight: 18, count: (2, 5)),
            (item: "bomb", weight: 12, count: (1, 3)),
            (item: "block:brick", weight: 10, count: (6, 16)),
            (item: "block:planks", weight: 10, count: (6, 16)),
            (item: "chest", weight: 4, count: (1, 1)),
            (item: "iron_pickaxe", weight: 3, count: (1, 1)),
            (item: "leather_jerkin", weight: 4, count: (1, 1)),
            (item: "leather_trousers", weight: 4, count: (1, 1)),
            (item: "leather_gloves", weight: 3, count: (1, 1)),
            (item: "cloth_hood", weight: 3, count: (1, 1)),
            (item: "iron_helm", weight: 2, count: (1, 1)),
            (item: "shortsword", weight: 2, count: (1, 1)),
        ]),
        (name: "caverns", deeper_than: 2500, rolls: (3, 5), entries: [
            (item: "torch", weight: 25, count: (6, 14)),
            (item: "glowstick", weight: 20, count: (3, 7)),
            (item: "bomb", weight: 18, count: (2, 5)),
            (item: "block:brick", weight: 8, count: (10, 24)),
            (item: "iron_pickaxe", weight: 8, count: (1, 1)),
            (item: "gold_pickaxe", weight: 3, count: (1, 1)),
            (item: "block:amethyst", weight: 5, count: (1, 3)),
            (item: "chest", weight: 4, count: (1, 1)),
            (item: "chainmail", weight: 3, count: (1, 1)),
            (item: "iron_greaves", weight: 3, count: (1, 1)),
            (item: "iron_gauntlets", weight: 3, count: (1, 1)),
            (item: "apprentice_robe", weight: 3, count: (1, 1)),
            (item: "silk_gloves", weight: 2, count: (1, 1)),
            (item: "ember_amulet", weight: 2, count: (1, 1)),
            (item: "frost_charm", weight: 2, count: (1, 1)),
            (item: "longsword", weight: 2, count: (1, 1)),
            (item: "bow", weight: 2, count: (1, 1)),
        ]),
        (name: "deep", deeper_than: 7000, rolls: (4, 6), entries: [
            (item: "bomb", weight: 25, count: (3, 7)),
            (item: "glowstick", weight: 20, count: (4, 9)),
            (item: "torch", weight: 15, count: (8, 16)),
            (item: "iron_pickaxe", weight: 6, count: (1, 1)),
            (item: "gold_pickaxe", weight: 8, count: (1, 1)),
            (item: "mithril_pickaxe", weight: 2, count: (1, 1)),
            (item: "block:emerald", weight: 5, count: (1, 3)),
            (item: "block:obsidian", weight: 8, count: (6, 14)),
            (item: "iron_boots", weight: 4, count: (1, 1)),
            (item: "chainmail", weight: 4, count: (1, 1)),
            (item: "iron_helm", weight: 4, count: (1, 1)),
            (item: "feather_boots", weight: 2, count: (1, 1)),
            (item: "storm_ring", weight: 2, count: (1, 1)),
            (item: "lucky_coin", weight: 2, count: (1, 1)),
            (item: "longsword", weight: 3, count: (1, 1)),
        ]),

        // ---- creatures' (their bodies) ----
        (name: "orc", rolls: (1, 2), entries: [
            (item: "nothing", weight: 30, count: (1, 1)),
            (item: "torch", weight: 12, count: (1, 3)),
            (item: "bomb", weight: 4, count: (1, 2)),
