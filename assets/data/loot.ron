            (item: "lucky_coin", weight: 1, count: (1, 1)),
        ]),
        (name: "orc_archer", rolls: (1, 2), entries: [
            (item: "arrow", weight: 30, count: (4, 12)),
            (item: "nothing", weight: 20, count: (1, 1)),
            (item: "leather_cap", weight: 4, count: (1, 1)),
