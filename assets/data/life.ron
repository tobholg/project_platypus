// Ambient life round the player (actors/critters.rs). Each kind:
//   place: Surface (open ground), Shore (within 45 cells of water), Water
//     (in cool liquid with room round it), Cave (in the open air of a cave,
//     a roof above, under the surface)
//   when: Any (default), Day or Night; out of its hours it leaves once out
//     of sight
//   above: (low, high): put that high above the spot (fliers in the air)
//   depth: (from, to): only that deep under the surface (cells)
//   zone: only in that underground biome (fungal, crystal, toxic, none)
//   (Enemies too: what lives down there turns up as you go.)
//   most: at most this many near the player; rate: a chance a second to add one
//   biomes: only over those surface biomes (plains, forest, desert, tundra,
//     jungle, swamp, deep forest, mountains, ocean); none: anywhere
//   group: (min, max): come as a pack, side by side
//   away: never within that many cells of the world's start (the big ones)
// Hot-reloaded. Add a kind here and it lives in the world.
[
    (kind: "rabbit", place: Surface, when: Day, most: 4, rate: 0.5),
    (kind: "bird", place: Surface, when: Day, most: 6, rate: 0.6),
    (kind: "frog", place: Shore, most: 4, rate: 0.6),
    (kind: "firefly", place: Surface, when: Night, above: (9, 36), most: 14, rate: 3.0),
    (kind: "fish", place: Water, most: 8, rate: 1.2),
    (kind: "bat", place: Cave, most: 3, rate: 0.35),
    (kind: "slime", place: Cave, depth: (60, 1350), zone: "none", most: 3, rate: 0.4),
    (kind: "acid_slime", place: Cave, zone: "toxic", most: 4, rate: 0.6),
    (kind: "skeleton", place: Cave, depth: (300, 150000), most: 2, rate: 0.25),
    (kind: "vampire_bat", place: Cave, depth: (450, 150000), most: 2, rate: 0.12),
    (kind: "spider", place: Cave, depth: (225, 150000), most: 1, rate: 0.06),
    // The bestiary's walkers (BE limbs), where they belong.
    (kind: "stalker", place: Surface, biomes: ["plains", "desert", "tundra"], most: 2, rate: 0.08),
    (kind: "crab", place: Shore, most: 2, rate: 0.15),
    (kind: "raptor", place: Surface, biomes: ["plains", "forest", "jungle"], group: (3, 4), most: 4, rate: 0.04, away: 1200),
    (kind: "scorpion", place: Surface, biomes: ["desert"], most: 2, rate: 0.12),
    (kind: "tyrant", place: Surface, biomes: ["jungle", "deep forest"], most: 1, rate: 0.01, away: 3000),
    (kind: "strider", place: Surface, biomes: ["desert", "mountains", "tundra"], most: 1, rate: 0.015, away: 2500),
    (kind: "centipede", place: Cave, depth: (150, 150000), most: 1, rate: 0.05),
]
