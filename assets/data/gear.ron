            gear: (slot: Head, weight: Medium, stats: { Armor: 4 },
            look: (palette: { 'a': (26, 20, 12), 'b': (46, 29, 13), 'e': (80, 47, 19), 'h': (114, 67, 28), 'k': (156, 95, 35), 'n': (199, 125, 51), 'p': (232, 156, 74) },
