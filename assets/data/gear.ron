        // ---- capes (cloth.rs): worn on the back, they hang and swing ----
        // cape: its outside and lining, points across and down and how far
        // apart, where it's pinned (from the middle: across, + the way it
        // faces, and up), how torn its hem, how heavy, how hard it falls
        // away behind you.
        (id: "travelers_cape", name: "Traveler's cape", color: (150, 38, 36),
            gear: (slot: Back, stats: { Armor: 1 },
            cape: (color: (150, 38, 36), lining: (92, 24, 28), cols: 5, rows: 10, gap: 2.5, pin: (-5.5, -1.5, 5.5), torn: 0.2, behind: 140))),
        // A dread knight's cloak: long, black, torn to rags at the hem.
        (id: "dread_cloak", name: "Dread cloak", color: (34, 32, 42),
            gear: (slot: Back, stats: { Armor: 4, FrostResist: 15 },
            cape: (color: (28, 28, 36), lining: (62, 22, 28), cols: 6, rows: 12, gap: 2.4, pin: (-6.0, -1.0, 5.5), torn: 0.55, weight: 1.2, behind: 120))),
        // ---- boots with a trick ----
        // rocket: Terraria's rocket boots. Hold jump in the air (once the
        // jump's rise slows, any air jumps spent): thrust up for `time` s,
        // refilled on landing; `thrust` cells/s² against gravity up to
        // `speed` rising; sideways up to `run` while it fires (kept after,
        // till you land or turn); `fire`: the exhaust is flame (it scorches
        // what's under it, and sets grass and wood alight). (Thrust 3450,
        // was 4600: it took off too fast to steer finely; its top speed up
        // and sideways as it was.)
        (id: "rocket_boots", name: "Rocket boots", color: (200, 70, 40),
            gear: (slot: Feet, stats: { Armor: 2, FireResist: 25 }, rocket: (time: 3.0, thrust: 3450, speed: 350, run: 240, fire: true),
            look: (recolor: [(colors: { 'B': (196, 64, 40), 'C': (140, 44, 30), 'U': (236, 196, 80), 'o': (64, 34, 28) })])),
            about: "Hold jump in the air: fly. Mind what's under you."),
        // Storm boots: a double jump that kicks off a storm: a thundercloud,
        // and out of it bolts at what's near (or into the ground), twice, a
        // breath apart (gear/storm.rs). `storm`: bolts in its first volley
        // (the second, half), their reach (cells), damage and stun (s).
        (id: "storm_boots", name: "Storm boots", color: (110, 104, 190),
            gear: (slot: Feet, weight: Light, stats: { AirJumps: 1, JumpHeight: 6, StormResist: 25, FallResist: 20 },
            // (22 a bolt: a jump over a foe's head is a risk, worth it.)
            storm: (bolts: 4, reach: 95, damage: 22, stun: 0.35),
            look: (recolor: [(colors: { 'B': (70, 66, 120), 'C': (48, 44, 88), 'U': (150, 140, 240), 'o': (30, 28, 56) })])),
            about: "A double jump kicks off a storm: bolts leap out of the cloud at what's near, and into the water it's in."),
        // The better double-jump boots: two jumps off thin air, higher.
        (id: "cloud_boots", name: "Zephyr treads", color: (200, 230, 255),
            gear: (slot: Feet, weight: Light, stats: { AirJumps: 2, JumpHeight: 12, FallResist: 40 },
            look: (recolor: [(colors: { 'B': (214, 234, 255), 'C': (170, 196, 230), 'U': (236, 246, 255), 'o': (128, 150, 186) })])),
            about: "Woven from a west wind: two jumps off thin air (a triple jump), higher, and a soft landing."),
        (id: "feather_boots", name: "Feather boots", color: (236, 236, 246),
            gear: (slot: Feet, weight: Light, stats: { AirJumps: 1, JumpHeight: 10, FallResist: 30 },
            look: (recolor: [(colors: { 'B': (236, 236, 246), 'C': (190, 190, 206), 'U': (250, 250, 255), 'o': (150, 150, 168) })])),
            about: "Light as down: a jump in the air, and a softer landing."),

        // ---- grappling hooks (the Hook slot; E) ----
        // hook: its rope. `length` cells it reaches, `reel` cells/s it pulls
        // you (or what it holds) in, `speed` cells/s it flies out, `damage`
        // to a creature it bites into; `rope` its colour, `links`: a chain.
        // The first: a rope and a three-pronged hook. Tossed (an arc, not a
        // shot), it reaches a short way, but there's a lot of rope: hook a
        // shaft's lip and rappel down (S); it doesn't reel you in, it holds,
        // and you climb (W), slower.
        (id: "rope_hook", name: "Rope hook", color: (150, 118, 74),
            gear: (slot: Hook, hook: (length: 450, throw: 170, speed: 560, gravity: 1100, pull: false, climb: 90, pay: 160, reel: 150, damage: 0, rope: (150, 118, 74))),
            about: "Hold E: its arc shows; let go: tossed. It holds; W: climb, S: rappel down (a long rope). A/D: swing. Jump to let go."),
        (id: "grappling_hook", name: "Grappling hook", color: (176, 140, 90),
            gear: (slot: Hook, hook: (length: 180, reel: 360, speed: 1200, rope: (176, 140, 90))),
            about: "E: throw it; it reels you to what it grabs. S: pay out, W: climb, A/D: swing. Jump to let go."),
        (id: "chain_hook", name: "Chain hook", color: (160, 162, 172),
            gear: (slot: Hook, stats: { Armor: 1 }, hook: (length: 255, reel: 495, speed: 1500, damage: 8, rope: (160, 162, 172), links: true)),
            about: "A longer reach, a faster pull, and a bite."),
        (id: "silk_line", name: "Silk line", color: (236, 236, 244),
            gear: (slot: Hook, hook: (length: 345, reel: 420, speed: 1800, damage: 2, rope: (236, 236, 244))),
            about: "Spider silk: light, and very long."),

