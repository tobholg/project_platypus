// Gear (DESIGN §7c): armour and trinkets. Each is an item (as in items.ron:
// id, name, color, about) with a `gear` block:
//
//   slot: Head | Body | Hands | Legs | Feet | Trinket (two may be worn)
//         | Held (weapons, tools and foci: while in the hand; in items.ron)
//   weight: Light (cloth: mages) | Medium (leather: rangers) | Heavy (mail
//     and plate: warriors). Every piece brings its weight's stats (below).
//   stats: { Stat: amount, .. } what it gives. Points: Armor, Health, Poise,
//     Stamina, Mana, AirJumps, Luck. Percent: FireResist, FrostResist,
//     StormResist, AcidResist, FallResist, Damage, AttackSpeed, Crit,
//     CritDamage, Knockback, StaminaRegen, ManaRegen, SpellPower, CastSpeed,
//     FirePower, FrostPower, StormPower, AcidPower, ForcePower,
//     GravityPower, RadiantPower, VoidPower, MoveSpeed, JumpHeight.
//
//   look: how it's drawn worn, on any humanoid (player, orc, skeleton...):
//     recolor: [(parts: [..], colors: { letter: colour })]: the wearer's
//       palette letters in new colours, in the parts named (all if none;
//       `arm*` = every part starting "arm"). The rig's letters: t/T/L tunic,
//       b belt, p/q trousers (near/far leg), B/C/U boots, s/S skin, h/H
//       hair; the player's (player.ron) adds W/Z skin, A/a its sleeves,
//       M/m its bracers, F/f/g its scarf, P/Q trousers, and names its head
//       `hero_head*` and torso `hero_torso*`: its helms and mail drawn over
//       those (a mail paints all of its torso, clipped, and pauldrons on
//       `arm`, `arm_pump_*` and `aim`), the old ones over `head`/`torso`
//       (orcs, skeletons). Its pack (`pack*`, the strap and buckle r/R/y) is
//       left as it is: off only while something's worn on the back.
//     over: [(parts: [..], at: (x, y), rows: [..], clip)]: rows drawn over
//       those parts wherever they're drawn, top-left at (x, y) in the part
//       (a head's top-left is (0, 0); -1 is a row above); its letters from
//       the look's own `palette`; with `clip`, only where the part is.
//     Its icon is what it changes on the player, standing.
//
// Armour stops armor / (armor + 35) of physical hurt (a full leather set,
// 22: two fifths; copper 24; iron 45: over half; silver 56; gold 66;
// mithril 80: seven tenths). Resistances stop their share of their element (at most 90%).
(
    // What each weight costs (or gives), per piece worn.
    weights: {
        Light: { ManaRegen: 4 },
        Medium: {},
        Heavy: { StaminaRegen: -4, ManaRegen: -8, MoveSpeed: -1 },
    },
    // Rarities, commonest first: a found piece rolls one (weight against the
    // others'; deeper finds and luck shift the odds toward the rare), and
    // that many bonuses. The last is for uniques (`unique: true`): never
    // rolled, always theirs.
    rarities: [
        (name: "Common", color: (205, 205, 210), bonuses: (0, 0), weight: 100),
        (name: "Uncommon", color: (110, 220, 110), bonuses: (1, 1), weight: 45),
        (name: "Rare", color: (100, 160, 255), bonuses: (2, 3), weight: 12),
        (name: "Epic", color: (190, 110, 255), bonuses: (3, 4), weight: 3),
        (name: "Legendary", color: (255, 165, 50), bonuses: (0, 0), weight: 0),
    ],
    // Bonuses gear can roll: `stat`, `base + per_level × item level` of it
    // (±25%), on the kinds in `on` (head, body, hands, legs, feet, trinket,
    // armour = any piece with a weight, melee, bow, focus; none: anything),
    // `weight` how often against the rest (10). The first prefix and the
    // first suffix rolled name the piece.
    bonuses: [
        (prefix: "Sturdy", stat: Armor, base: 2, per_level: 0.25, on: ["armour"]),
        (prefix: "Reinforced", stat: Armor, base: 4, per_level: 0.4, on: ["body", "legs"], weight: 6),
        (suffix: "of the Bear", stat: Health, base: 6, per_level: 0.8, on: ["head", "body", "legs", "trinket"]),
        (suffix: "of Balance", stat: Poise, base: 3, per_level: 0.3, on: ["body", "legs", "feet"]),
        (prefix: "Fireproof", stat: FireResist, base: 6, per_level: 0.4, on: ["armour", "trinket"]),
        (suffix: "of Warmth", stat: FrostResist, base: 6, per_level: 0.4, on: ["armour", "trinket"]),
        (suffix: "of Grounding", stat: StormResist, base: 6, per_level: 0.4, on: ["armour", "trinket"]),
        (suffix: "of the Marsh", stat: AcidResist, base: 6, per_level: 0.4, on: ["armour", "trinket"]),
        (suffix: "of Soft Landings", stat: FallResist, base: 8, per_level: 0.5, on: ["feet", "legs"], weight: 6),
        (prefix: "Swift", stat: MoveSpeed, base: 3, per_level: 0.1, on: ["feet", "legs"]),
        (suffix: "of Leaping", stat: JumpHeight, base: 4, per_level: 0.15, on: ["feet"]),
        (suffix: "of Endurance", stat: Stamina, base: 8, per_level: 0.6, on: ["body", "hands", "trinket"]),
        (suffix: "of Second Wind", stat: StaminaRegen, base: 5, per_level: 0.25, on: ["armour", "trinket"]),
        (suffix: "of the Owl", stat: Mana, base: 8, per_level: 0.8, on: ["head", "body", "trinket", "focus"]),
        (prefix: "Mystic", stat: ManaRegen, base: 5, per_level: 0.3, on: ["head", "body", "trinket", "focus"]),
        (prefix: "Arcane", stat: SpellPower, base: 4, per_level: 0.25, on: ["head", "body", "hands", "trinket", "focus"]),
        (prefix: "Deft", stat: CastSpeed, base: 3, per_level: 0.15, on: ["hands", "focus"]),
        (prefix: "Blazing", stat: FirePower, base: 6, per_level: 0.4, on: ["hands", "trinket", "focus"]),
        (prefix: "Rimed", stat: FrostPower, base: 6, per_level: 0.4, on: ["hands", "trinket", "focus"]),
        (prefix: "Thundering", stat: StormPower, base: 6, per_level: 0.4, on: ["hands", "trinket", "focus"]),
        (prefix: "Caustic", stat: AcidPower, base: 6, per_level: 0.4, on: ["hands", "trinket", "focus"]),
        (suffix: "of Fortune", stat: Luck, base: 2, per_level: 0.15, on: ["trinket", "head"], weight: 5),
        (prefix: "Sharp", stat: Damage, base: 4, per_level: 0.3, on: ["melee", "bow", "hands", "trinket"]),
        (prefix: "Brutal", stat: Damage, base: 8, per_level: 0.5, on: ["melee"], weight: 6),
        (prefix: "Quick", stat: AttackSpeed, base: 4, per_level: 0.2, on: ["melee", "bow", "hands"]),
        (prefix: "Keen", stat: Crit, base: 3, per_level: 0.15, on: ["melee", "bow", "hands", "trinket"]),
        (suffix: "of Slaughter", stat: CritDamage, base: 15, per_level: 1, on: ["melee", "bow"]),
        (prefix: "Heavy", stat: Knockback, base: 10, per_level: 0.5, on: ["melee"]),
    ],
    items: [
        // ---- cloth (Light): mages ----
        (id: "cloth_hood", name: "Cloth hood", color: (96, 82, 150),
            gear: (slot: Head, weight: Light, stats: { Armor: 2, Mana: 15 },
            look: (palette: { 'o': (96, 82, 150), 'O': (70, 58, 112), 'i': (126, 112, 182) }, over: [(parts: ["head", "blink"], at: (-1, -2), rows: [
                "....oooooo....",
                "..ooiiiioooo..",
                ".ooiioooooooo.",
                "oOoioooooooo..",
                "OOooooooooooo.",
                "OOoooooOOOOOO.",
                "OOoooooo......",
                "OOoooo........",
                "OOooo.........",
                "OOooo.........",
                ".OOoo.........",
                "..OOo.........",
                "...OO.........",
            ]),
                // (The player's head, its hair under it.)
                (parts: ["hero_head*"], at: (0, -2), rows: [
                "....oooooooooo....",
                "...ooiiiooooooo...",
                "...oioooooooooooo.",
                "..Oooooooooooooooo",
                "..Oooooooooooooooo",
                "..Oooooooooooooooo",
                "..Oooooooooooooooo",
                "..OooooooOOOOOOOOO",
                "..OoooO...........",
                "..OooO............",
                "..OooO............",
                "..Ooo.............",
                "...Oo.............",
                "...Oo.............",
                "....O.............",
            ])]))),
        (id: "apprentice_robe", name: "Apprentice robe", color: (84, 70, 140),
            gear: (slot: Body, weight: Light, stats: { Armor: 4, Mana: 25, SpellPower: 5 },
            look: (recolor: [(colors: { 't': (84, 70, 140), 'T': (62, 52, 106), 'L': (112, 98, 174), 'A': (112, 98, 174), 'a': (84, 70, 140), 'b': (200, 168, 80), 'P': (100, 86, 160), 'p': (84, 70, 140), 'q': (62, 52, 106), 'Q': (50, 42, 86) })]))),
        (id: "silk_gloves", name: "Spider-silk gloves", color: (226, 226, 232),
            gear: (slot: Hands, weight: Light, stats: { Armor: 1, CastSpeed: 10, AttackSpeed: 5 },
            look: (recolor: [(parts: ["arm*", "aim*"], colors: { 'W': (244, 244, 248), 's': (230, 230, 236), 'S': (190, 190, 200), 'Z': (164, 164, 178) })])),
            about: "Woven from what the spiders spin: nimble fingers."),
        (id: "cloth_trousers", name: "Cloth trousers", color: (74, 64, 118),
            gear: (slot: Legs, weight: Light, stats: { Armor: 2, ManaRegen: 5 },
            look: (recolor: [(colors: { 'P': (94, 84, 146), 'p': (74, 64, 118), 'q': (56, 48, 90), 'Q': (44, 38, 72) })]))),
