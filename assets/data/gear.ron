// Gear (DESIGN §7c): armour and trinkets. Each is an item (as in items.ron:
// id, name, color, about) with a `gear` block:
//
//   slot: Head | Body | Hands | Legs | Feet | Trinket (two may be worn)
//         | Held (weapons, tools and foci: while in the hand; in items.ron)
//   weight: Light (cloth: mages) | Medium (leather: rangers) | Heavy (mail
//     and plate: warriors). Every piece brings its weight's stats (below).
//   stats: { Stat: amount, .. } what it gives. Points: Armor, Health, Poise,
//     Stamina, Mana, AirJumps, Luck. Percent: FireResist, FrostResist,
//     StormResist, AcidResist, FallResist, Damage, AttackSpeed, Crit,
//     CritDamage, Knockback, StaminaRegen, ManaRegen, SpellPower, CastSpeed,
//     FirePower, FrostPower, StormPower, AcidPower, ForcePower,
//     GravityPower, MoveSpeed, JumpHeight.
//
//   look: how it's drawn worn, on any humanoid (player, orc, skeleton...):
//     recolor: [(parts: [..], colors: { letter: colour })]: the wearer's
//       palette letters in new colours, in the parts named (all if none;
//       `arm*` = every part starting "arm"). The rig's letters: t/T tunic,
//       b belt, p/q trousers (near/far leg), B/C boots, s/S skin, h/H hair.
//     over: [(parts: [..], at: (x, y), rows: [..], clip)]: rows drawn over
//       those parts wherever they're drawn, top-left at (x, y) in the part
//       (a head's top-left is (0, 0); -1 is a row above); its letters from
//       the look's own `palette`; with `clip`, only where the part is.
//     Its icon is what it changes on the player, standing.
//
// Armour stops armor / (armor + 50) of physical hurt (a full iron set, 45:
// nearly half). Resistances stop their share of their element (at most 90%).
(
    // What each weight costs (or gives), per piece worn.
    weights: {
        Light: { ManaRegen: 4 },
        Medium: {},
        Heavy: { StaminaRegen: -4, ManaRegen: -8, MoveSpeed: -1 },
    },
    items: [
        // ---- cloth (Light): mages ----
        (id: "cloth_hood", name: "Cloth hood", color: (96, 82, 150),
            gear: (slot: Head, weight: Light, stats: { Armor: 2, Mana: 15 },
            look: (palette: { 'o': (96, 82, 150), 'O': (70, 58, 112) }, over: [(parts: ["head", "blink"], at: (0, -1), rows: [
                "..oooo..",
                ".oooooo.",
                "oOoooooo",
                "OOoooooo",
                "OOoo....",
                "OOo.....",
                ".Oo.....",
            ])]))),
        (id: "apprentice_robe", name: "Apprentice robe", color: (84, 70, 140),
            gear: (slot: Body, weight: Light, stats: { Armor: 4, Mana: 25, SpellPower: 5 },
            look: (recolor: [(colors: { 't': (84, 70, 140), 'T': (62, 52, 106), 'b': (200, 168, 80), 'p': (84, 70, 140), 'q': (62, 52, 106) })]))),
        (id: "silk_gloves", name: "Spider-silk gloves", color: (226, 226, 232),
            gear: (slot: Hands, weight: Light, stats: { Armor: 1, CastSpeed: 10, AttackSpeed: 5 },
            look: (recolor: [(parts: ["arm*", "aim*"], colors: { 's': (230, 230, 236), 'S': (190, 190, 200) })])),
            about: "Woven from what the spiders spin: nimble fingers."),
        (id: "cloth_trousers", name: "Cloth trousers", color: (74, 64, 118),
            gear: (slot: Legs, weight: Light, stats: { Armor: 2, ManaRegen: 5 },
            look: (recolor: [(colors: { 'p': (74, 64, 118), 'q': (56, 48, 90) })]))),
        (id: "soft_boots", name: "Soft boots", color: (90, 70, 60),
            gear: (slot: Feet, weight: Light, stats: { Armor: 1, MoveSpeed: 5 },
            look: (recolor: [(colors: { 'B': (104, 82, 70), 'C': (80, 62, 52) })]))),

        // ---- leather (Medium): rangers ----
        (id: "leather_cap", name: "Leather cap", color: (132, 92, 58),
            gear: (slot: Head, weight: Medium, stats: { Armor: 4 },
            look: (palette: { 'c': (132, 92, 58), 'C': (100, 68, 42), 'L': (78, 52, 32) }, over: [(parts: ["head", "blink"], at: (0, -1), rows: [
                "..cccc...",
                ".cCcccc..",
                "cCcccccc.",
                "CCccccccL",
            ])]))),
        (id: "leather_jerkin", name: "Leather jerkin", color: (126, 88, 54),
            gear: (slot: Body, weight: Medium, stats: { Armor: 8, Crit: 3 },
            look: (recolor: [(colors: { 't': (126, 88, 54), 'T': (96, 66, 42) })],
                palette: { 'l': (196, 158, 104) }, over: [(parts: ["torso"], clip: true, rows: [
                ".......",
                "....l..",
                "...l...",
                "....l..",
            ])]))),
        (id: "leather_gloves", name: "Leather gloves", color: (110, 76, 46),
            gear: (slot: Hands, weight: Medium, stats: { Armor: 2, AttackSpeed: 4 },
            look: (recolor: [(parts: ["arm*", "aim*"], colors: { 's': (110, 76, 46), 'S': (84, 56, 34) })]))),
        (id: "leather_trousers", name: "Leather trousers", color: (104, 74, 48),
            gear: (slot: Legs, weight: Medium, stats: { Armor: 5 },
            look: (recolor: [(colors: { 'p': (104, 74, 48), 'q': (80, 56, 36) })]))),
        (id: "leather_boots", name: "Leather boots", color: (92, 64, 40),
            gear: (slot: Feet, weight: Medium, stats: { Armor: 3, MoveSpeed: 5 },
            look: (recolor: [(colors: { 'B': (92, 64, 40), 'C': (70, 48, 30) })]))),

        // ---- iron (Heavy): warriors ----
        (id: "iron_helm", name: "Iron helm", color: (168, 176, 194),
            gear: (slot: Head, weight: Heavy, stats: { Armor: 8, Poise: 5 },
            look: (palette: { 'm': (168, 176, 194), 'M': (112, 120, 140), 'w': (226, 228, 236) }, over: [(parts: ["head", "blink"], at: (0, -1), rows: [
                "..mmmm...",
                ".mwmmmmm.",
                "mMmmmmmmm",
                "MMmmmmmmm",
                "MMm..m...",
                "MM.......",
            ])]))),
        (id: "chainmail", name: "Chainmail", color: (150, 158, 176),
            gear: (slot: Body, weight: Heavy, stats: { Armor: 16, Health: 10, Poise: 10 },
            look: (recolor: [(colors: { 't': (150, 158, 176), 'T': (108, 116, 136) })],
                palette: { 'd': (104, 108, 120) }, over: [(parts: ["torso"], clip: true, rows: [
                ".......",
                ".d.d.d.",
                "..d.d..",
                ".d.d.d.",
                ".......",
                "..d.d..",
            ])]))),
        (id: "iron_gauntlets", name: "Iron gauntlets", color: (160, 162, 174),
            gear: (slot: Hands, weight: Heavy, stats: { Armor: 5, Damage: 3 },
            look: (recolor: [(parts: ["arm*", "aim*"], colors: { 's': (160, 168, 188), 'S': (114, 122, 142) })]))),
        (id: "iron_greaves", name: "Iron greaves", color: (140, 144, 156),
            gear: (slot: Legs, weight: Heavy, stats: { Armor: 10 },
            look: (recolor: [(colors: { 'p': (142, 150, 168), 'q': (102, 110, 130) })]))),
        (id: "iron_boots", name: "Iron boots", color: (130, 134, 146),
            gear: (slot: Feet, weight: Heavy, stats: { Armor: 6, FallResist: 10 },
            look: (recolor: [(colors: { 'B': (130, 138, 156), 'C': (94, 102, 120) })]))),

        // ---- boots with a trick ----
        (id: "feather_boots", name: "Feather boots", color: (236, 236, 246),
            gear: (slot: Feet, weight: Light, stats: { AirJumps: 1, JumpHeight: 10, FallResist: 30 },
            look: (recolor: [(colors: { 'B': (236, 236, 246), 'C': (190, 190, 206) })])),
            about: "Light as down: a jump in the air, and a softer landing."),

        // ---- trinkets ----
        (id: "ring_of_vigour", name: "Ring of vigour", color: (220, 60, 60),
            gear: (slot: Trinket, stats: { Health: 20, StaminaRegen: 10 })),
        (id: "ember_amulet", name: "Ember amulet", color: (255, 130, 40),
            gear: (slot: Trinket, stats: { FirePower: 25, FireResist: 15 })),
        (id: "frost_charm", name: "Frost charm", color: (150, 210, 255),
            gear: (slot: Trinket, stats: { FrostPower: 25, FrostResist: 15 })),
        (id: "storm_ring", name: "Storm ring", color: (210, 220, 255),
            gear: (slot: Trinket, stats: { StormPower: 25, StormResist: 15 })),
        (id: "lucky_coin", name: "Lucky coin", color: (240, 200, 70),
            gear: (slot: Trinket, stats: { Luck: 10, Crit: 5 }),
            about: "Heads, you find something better."),
    ],
)
