        // ---- shields (the off hand: raised with the right button, gear/shield.rs) ----
        // guard: the share of a caught blow it stops; stability: stamina a
        // caught blow costs per point of damage; drain: stamina a second up.
        (id: "wooden_shield", name: "Wooden shield", color: (150, 104, 60),
            about: "Planks and a boss. Hold the right button to raise it.",
            gear: (slot: OffHand, stats: { Armor: 2 }, shield: (guard: 0.8, stability: 1.3, drain: 5))),
        (id: "iron_shield", name: "Iron shield", color: (160, 166, 180),
            about: "Heavy, steady: a blow costs little to catch. Hold the right button to raise it.",
            gear: (slot: OffHand, stats: { Armor: 5, Poise: 5 }, shield: (guard: 1.0, stability: 0.8, drain: 7))),
        // A ward: held up (the right button, or Q), a repulsor bubble round
        // you that throws back what comes at you and turns back what's shot
        // into it; it drinks mana while it's up, more for each blow it
        // turns (gear/shield.rs `ward`). radius: cells round you.
        (id: "repulsor_ward", name: "Repulsor ward", color: (140, 200, 255),
            about: "A ring of force-worked silver. Hold the right button (or Q) and a bubble of bent space surrounds you: what walks into it is thrown back, what's shot into it turned back. It drinks your mana while it's up.",
            gear: (slot: OffHand, ward: (radius: 34, drain: 15, blow: 15))),

