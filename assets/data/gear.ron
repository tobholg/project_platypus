// Gear (DESIGN §7c): armour and trinkets. Each is an item (as in items.ron:
// id, name, color, about) with a `gear` block:
//
//   slot: Head | Body | Hands | Legs | Feet | Trinket (two may be worn)
//         | Held (weapons, tools and foci: while in the hand; in items.ron)
//   weight: Light (cloth: mages) | Medium (leather: rangers) | Heavy (mail
//     and plate: warriors). Every piece brings its weight's stats (below).
//   stats: { Stat: amount, .. } what it gives. Points: Armor, Health, Poise,
//     Stamina, Mana, AirJumps, Luck. Percent: FireResist, FrostResist,
//     StormResist, AcidResist, FallResist, Damage, AttackSpeed, Crit,
//     CritDamage, Knockback, StaminaRegen, ManaRegen, SpellPower, CastSpeed,
//     FirePower, FrostPower, StormPower, AcidPower, ForcePower,
//     GravityPower, RadiantPower, VoidPower, MoveSpeed, JumpHeight.
//
//   look: how it's drawn worn, on any humanoid (player, orc, skeleton...):
//     recolor: [(parts: [..], colors: { letter: colour })]: the wearer's
//       palette letters in new colours, in the parts named (all if none;
//       `arm*` = every part starting "arm"). The rig's letters: t/T tunic,
//       b belt, p/q trousers (near/far leg), B/C boots, s/S skin, h/H hair.
//     over: [(parts: [..], at: (x, y), rows: [..], clip)]: rows drawn over
//       those parts wherever they're drawn, top-left at (x, y) in the part
//       (a head's top-left is (0, 0); -1 is a row above); its letters from
//       the look's own `palette`; with `clip`, only where the part is.
//     Its icon is what it changes on the player, standing.
//
// Armour stops armor / (armor + 50) of physical hurt (a full iron set, 45:
// nearly half). Resistances stop their share of their element (at most 90%).
(
    // What each weight costs (or gives), per piece worn.
    weights: {
        Light: { ManaRegen: 4 },
        Medium: {},
        Heavy: { StaminaRegen: -4, ManaRegen: -8, MoveSpeed: -1 },
    },
    // Rarities, commonest first: a found piece rolls one (weight against the
    // others'; deeper finds and luck shift the odds toward the rare), and
    // that many bonuses. The last is for uniques (`unique: true`): never
    // rolled, always theirs.
    rarities: [
        (name: "Common", color: (205, 205, 210), bonuses: (0, 0), weight: 100),
        (name: "Uncommon", color: (110, 220, 110), bonuses: (1, 1), weight: 45),
        (name: "Rare", color: (100, 160, 255), bonuses: (2, 3), weight: 12),
        (name: "Epic", color: (190, 110, 255), bonuses: (3, 4), weight: 3),
        (name: "Legendary", color: (255, 165, 50), bonuses: (0, 0), weight: 0),
    ],
    // Bonuses gear can roll: `stat`, `base + per_level × item level` of it
    // (±25%), on the kinds in `on` (head, body, hands, legs, feet, trinket,
    // armour = any piece with a weight, melee, bow, focus; none: anything),
    // `weight` how often against the rest (10). The first prefix and the
    // first suffix rolled name the piece.
    bonuses: [
        (prefix: "Sturdy", stat: Armor, base: 2, per_level: 0.25, on: ["armour"]),
        (prefix: "Reinforced", stat: Armor, base: 4, per_level: 0.4, on: ["body", "legs"], weight: 6),
        (suffix: "of the Bear", stat: Health, base: 6, per_level: 0.8, on: ["head", "body", "legs", "trinket"]),
        (suffix: "of Balance", stat: Poise, base: 3, per_level: 0.3, on: ["body", "legs", "feet"]),
        (prefix: "Fireproof", stat: FireResist, base: 6, per_level: 0.4, on: ["armour", "trinket"]),
        (suffix: "of Warmth", stat: FrostResist, base: 6, per_level: 0.4, on: ["armour", "trinket"]),
        (suffix: "of Grounding", stat: StormResist, base: 6, per_level: 0.4, on: ["armour", "trinket"]),
        (suffix: "of the Marsh", stat: AcidResist, base: 6, per_level: 0.4, on: ["armour", "trinket"]),
        (suffix: "of Soft Landings", stat: FallResist, base: 8, per_level: 0.5, on: ["feet", "legs"], weight: 6),
        (prefix: "Swift", stat: MoveSpeed, base: 3, per_level: 0.1, on: ["feet", "legs"]),
        (suffix: "of Leaping", stat: JumpHeight, base: 4, per_level: 0.15, on: ["feet"]),
        (suffix: "of Endurance", stat: Stamina, base: 8, per_level: 0.6, on: ["body", "hands", "trinket"]),
        (suffix: "of Second Wind", stat: StaminaRegen, base: 5, per_level: 0.25, on: ["armour", "trinket"]),
        (suffix: "of the Owl", stat: Mana, base: 8, per_level: 0.8, on: ["head", "body", "trinket", "focus"]),
        (prefix: "Mystic", stat: ManaRegen, base: 5, per_level: 0.3, on: ["head", "body", "trinket", "focus"]),
        (prefix: "Arcane", stat: SpellPower, base: 4, per_level: 0.25, on: ["head", "body", "hands", "trinket", "focus"]),
        (prefix: "Deft", stat: CastSpeed, base: 3, per_level: 0.15, on: ["hands", "focus"]),
        (prefix: "Blazing", stat: FirePower, base: 6, per_level: 0.4, on: ["hands", "trinket", "focus"]),
        (prefix: "Rimed", stat: FrostPower, base: 6, per_level: 0.4, on: ["hands", "trinket", "focus"]),
        (prefix: "Thundering", stat: StormPower, base: 6, per_level: 0.4, on: ["hands", "trinket", "focus"]),
        (prefix: "Caustic", stat: AcidPower, base: 6, per_level: 0.4, on: ["hands", "trinket", "focus"]),
        (suffix: "of Fortune", stat: Luck, base: 2, per_level: 0.15, on: ["trinket", "head"], weight: 5),
        (prefix: "Sharp", stat: Damage, base: 4, per_level: 0.3, on: ["melee", "bow", "hands", "trinket"]),
        (prefix: "Brutal", stat: Damage, base: 8, per_level: 0.5, on: ["melee"], weight: 6),
        (prefix: "Quick", stat: AttackSpeed, base: 4, per_level: 0.2, on: ["melee", "bow", "hands"]),
        (prefix: "Keen", stat: Crit, base: 3, per_level: 0.15, on: ["melee", "bow", "hands", "trinket"]),
        (suffix: "of Slaughter", stat: CritDamage, base: 15, per_level: 1, on: ["melee", "bow"]),
        (prefix: "Heavy", stat: Knockback, base: 10, per_level: 0.5, on: ["melee"]),
    ],
    items: [
        // ---- cloth (Light): mages ----
        (id: "cloth_hood", name: "Cloth hood", color: (96, 82, 150),
            gear: (slot: Head, weight: Light, stats: { Armor: 2, Mana: 15 },
            look: (palette: { 'o': (96, 82, 150), 'O': (70, 58, 112), 'i': (126, 112, 182) }, over: [(parts: ["head", "blink"], at: (-1, -2), rows: [
                "....oooooo....",
                "..ooiiiioooo..",
                ".ooiioooooooo.",
                "oOoioooooooo..",
                "OOooooooooooo.",
                "OOoooooOOOOOO.",
                "OOoooooo......",
                "OOoooo........",
                "OOooo.........",
                "OOooo.........",
                ".OOoo.........",
                "..OOo.........",
                "...OO.........",
            ])]))),
        (id: "apprentice_robe", name: "Apprentice robe", color: (84, 70, 140),
            gear: (slot: Body, weight: Light, stats: { Armor: 4, Mana: 25, SpellPower: 5 },
            look: (recolor: [(colors: { 't': (84, 70, 140), 'T': (62, 52, 106), 'L': (112, 98, 174), 'b': (200, 168, 80), 'p': (84, 70, 140), 'q': (62, 52, 106) })]))),
        (id: "silk_gloves", name: "Spider-silk gloves", color: (226, 226, 232),
            gear: (slot: Hands, weight: Light, stats: { Armor: 1, CastSpeed: 10, AttackSpeed: 5 },
            look: (recolor: [(parts: ["arm*", "aim*"], colors: { 's': (230, 230, 236), 'S': (190, 190, 200) })])),
            about: "Woven from what the spiders spin: nimble fingers."),
        (id: "cloth_trousers", name: "Cloth trousers", color: (74, 64, 118),
            gear: (slot: Legs, weight: Light, stats: { Armor: 2, ManaRegen: 5 },
            look: (recolor: [(colors: { 'p': (74, 64, 118), 'q': (56, 48, 90) })]))),
        (id: "soft_boots", name: "Soft boots", color: (90, 70, 60),
            gear: (slot: Feet, weight: Light, stats: { Armor: 1, MoveSpeed: 5 },
            look: (recolor: [(colors: { 'B': (104, 82, 70), 'C': (80, 62, 52), 'U': (124, 100, 86), 'o': (56, 42, 36) })]))),

        // ---- leather (Medium): rangers ----
        (id: "leather_cap", name: "Leather cap", color: (132, 92, 58),
            gear: (slot: Head, weight: Medium, stats: { Armor: 4 },
            look: (palette: { 'c': (132, 92, 58), 'C': (100, 68, 42), 'L': (78, 52, 32), 'i': (164, 120, 80) }, over: [(parts: ["head", "blink"], at: (-1, -2), rows: [
                "....cccccc.....",
                "..cciiiicccc...",
                ".Ccciicccccccc.",
                "CCcicccccccccc.",
                "CCccccccccccccc",
                "CCCCCCCCCCCLLLL",
            ])]))),
        (id: "leather_jerkin", name: "Leather jerkin", color: (126, 88, 54),
            gear: (slot: Body, weight: Medium, stats: { Armor: 8, Crit: 3 },
            look: (recolor: [(colors: { 't': (126, 88, 54), 'T': (96, 66, 42), 'L': (156, 116, 76) })],
                palette: { 'l': (196, 158, 104) }, over: [(parts: ["torso"], clip: true, rows: [
                "...........",
                "......l.l..",
                ".......l...",
                "......l.l..",
                ".......l...",
                "......l.l..",
            ])]))),
        (id: "leather_gloves", name: "Leather gloves", color: (110, 76, 46),
            gear: (slot: Hands, weight: Medium, stats: { Armor: 2, AttackSpeed: 4 },
            look: (recolor: [(parts: ["arm*", "aim*"], colors: { 's': (110, 76, 46), 'S': (84, 56, 34) })]))),
        (id: "leather_trousers", name: "Leather trousers", color: (104, 74, 48),
            gear: (slot: Legs, weight: Medium, stats: { Armor: 5 },
            look: (recolor: [(colors: { 'p': (104, 74, 48), 'q': (80, 56, 36) })]))),
        (id: "leather_boots", name: "Leather boots", color: (92, 64, 40),
            gear: (slot: Feet, weight: Medium, stats: { Armor: 3, MoveSpeed: 5 },
            look: (recolor: [(colors: { 'B': (92, 64, 40), 'C': (70, 48, 30), 'U': (114, 84, 56), 'o': (46, 32, 22) })]))),

        // ---- iron (Heavy): warriors ----
        (id: "iron_helm", name: "Iron helm", color: (168, 176, 194),
            gear: (slot: Head, weight: Heavy, stats: { Armor: 8, Poise: 5 },
            look: (palette: { 'm': (168, 176, 194), 'M': (112, 120, 140), 'w': (226, 228, 236), 'n': (86, 92, 110) }, over: [(parts: ["head", "blink"], at: (-1, -2), rows: [
                "....mmmmmm....",
                "..mmwwwwmmm...",
                ".mmwwmmmmmmm..",
                "Mmmwmmmmmmmmm.",
                "MMmmmmmmmmmmm.",
                "MMnnnnnnnnnnnn",
                "MMmmm......m..",
                "MMmm.......m..",
                "MMm...........",
                ".M............",
            ])]))),
        (id: "chainmail", name: "Chainmail", color: (150, 158, 176),
            gear: (slot: Body, weight: Heavy, stats: { Armor: 16, Health: 10, Poise: 10 },
            look: (recolor: [(colors: { 't': (150, 158, 176), 'T': (108, 116, 136), 'L': (190, 196, 210) })],
                palette: { 'd': (104, 108, 120) }, over: [(parts: ["torso"], clip: true, rows: [
                "...........",
                ".d.d.d.d.d.",
                "...........",
                "..d.d.d.d..",
                "...........",
                ".d.d.d.d.d.",
                "...........",
                "..d.d.d.d..",
                "...........",
            ])]))),
        (id: "iron_gauntlets", name: "Iron gauntlets", color: (160, 162, 174),
            gear: (slot: Hands, weight: Heavy, stats: { Armor: 5, Damage: 3 },
            look: (recolor: [(parts: ["arm*", "aim*"], colors: { 's': (160, 168, 188), 'S': (114, 122, 142) })]))),
        (id: "iron_greaves", name: "Iron greaves", color: (140, 144, 156),
            gear: (slot: Legs, weight: Heavy, stats: { Armor: 10 },
            look: (recolor: [(colors: { 'p': (142, 150, 168), 'q': (102, 110, 130) })]))),
        (id: "iron_boots", name: "Iron boots", color: (130, 134, 146),
            gear: (slot: Feet, weight: Heavy, stats: { Armor: 6, FallResist: 10 },
            look: (recolor: [(colors: { 'B': (130, 138, 156), 'C': (94, 102, 120), 'U': (160, 166, 182), 'o': (66, 70, 84) })]))),

        // ---- boots with a trick ----
        // rocket: Terraria's rocket boots. Hold jump in the air (once the
        // jump's rise slows, any air jumps spent): thrust up for `time` s,
        // refilled on landing; `thrust` cells/s² against gravity up to
        // `speed` rising; `fire`: the exhaust is flame (it scorches what's
        // under it, and sets grass and wood alight).
        (id: "rocket_boots", name: "Rocket boots", color: (200, 70, 40),
            gear: (slot: Feet, stats: { Armor: 2, FireResist: 25 }, rocket: (time: 3.0, thrust: 3450, speed: 315, fire: true),
            look: (recolor: [(colors: { 'B': (196, 64, 40), 'C': (140, 44, 30), 'U': (222, 92, 60), 'o': (64, 34, 28) })],
                palette: { 'y': (236, 196, 80) }, over: [
                // A gold band round each boot's top, part by part.
                (parts: ["legs"], clip: true, at: (0, 7), rows: [".yyy..yyy.."]),
                (parts: ["run1", "run4"], clip: true, at: (0, 7), rows: ["yyy.......yyy."]),
                (parts: ["run2"], clip: true, at: (0, 5), rows: [".....yyy......", "..............", ".........yyy.."]),
                (parts: ["run3"], clip: true, at: (0, 5), rows: ["...yy.........", "..............", ".......yyy...."]),
                (parts: ["tuck"], clip: true, at: (0, 5), rows: ["........yyy.", "...yyy......"]),
                (parts: ["dangle"], clip: true, at: (0, 5), rows: ["..yyy......", ".......yyy."]),
                (parts: ["knees"], clip: true, at: (0, 3), rows: ["........yyy.", ".yyy........"]),
                (parts: ["kick_knee"], clip: true, at: (0, 5), rows: ["..........yyy.", "..............", "..yyy........."]),
                (parts: ["kick_leg"], clip: true, at: (0, 1), rows: [".............y....", ".............y....", ".............y....", "..................", "..................", "..................", "..yyy............."]),
            ])),
            about: "Hold jump in the air: fly. Mind what's under you."),
        (id: "cloud_boots", name: "Cloud boots", color: (200, 230, 255),
            gear: (slot: Feet, weight: Light, stats: { AirJumps: 2, FallResist: 20 },
            look: (recolor: [(colors: { 'B': (214, 234, 255), 'C': (170, 196, 230), 'U': (236, 246, 255), 'o': (128, 150, 186) })])),
            about: "Two jumps off thin air (a triple jump)."),
        (id: "feather_boots", name: "Feather boots", color: (236, 236, 246),
            gear: (slot: Feet, weight: Light, stats: { AirJumps: 1, JumpHeight: 10, FallResist: 30 },
            look: (recolor: [(colors: { 'B': (236, 236, 246), 'C': (190, 190, 206), 'U': (250, 250, 255), 'o': (150, 150, 168) })])),
            about: "Light as down: a jump in the air, and a softer landing."),

        // ---- grappling hooks (the Hook slot; E) ----
        // hook: its rope. `length` cells it reaches, `reel` cells/s it pulls
        // you (or what it holds) in, `speed` cells/s it flies out, `damage`
        // to a creature it bites into; `rope` its colour, `links`: a chain.
        (id: "grappling_hook", name: "Grappling hook", color: (176, 140, 90),
            gear: (slot: Hook, hook: (length: 180, reel: 360, speed: 1200, rope: (176, 140, 90))),
            about: "E: throw it; it reels you to what it grabs. S: pay out, W: climb, A/D: swing. Jump to let go."),
        (id: "chain_hook", name: "Chain hook", color: (160, 162, 172),
            gear: (slot: Hook, stats: { Armor: 1 }, hook: (length: 255, reel: 495, speed: 1500, damage: 8, rope: (160, 162, 172), links: true)),
            about: "A longer reach, a faster pull, and a bite."),
        (id: "silk_line", name: "Silk line", color: (236, 236, 244),
            gear: (slot: Hook, hook: (length: 345, reel: 420, speed: 1800, damage: 2, rope: (236, 236, 244))),
            about: "Spider silk: light, and very long."),

        // ---- trinkets ----
        (id: "ring_of_vigour", name: "Ring of vigour", color: (220, 60, 60),
            gear: (slot: Trinket, stats: { Health: 20, StaminaRegen: 10 })),
        (id: "ember_amulet", name: "Ember amulet", color: (255, 130, 40),
            gear: (slot: Trinket, stats: { FirePower: 25, FireResist: 15 })),
        (id: "frost_charm", name: "Frost charm", color: (150, 210, 255),
            gear: (slot: Trinket, stats: { FrostPower: 25, FrostResist: 15 })),
        (id: "storm_ring", name: "Storm ring", color: (210, 220, 255),
            gear: (slot: Trinket, stats: { StormPower: 25, StormResist: 15 })),
        (id: "lucky_coin", name: "Lucky coin", color: (240, 200, 70),
            gear: (slot: Trinket, stats: { Luck: 10, Crit: 5 }),
            about: "Heads, you find something better."),
    ],
)
