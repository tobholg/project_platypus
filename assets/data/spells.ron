// Spells (DESIGN §7b, §7c): each a recipe of runes (runes.ron), read left to
// right: modifiers until a carrier, the payloads after it, and with a
// `Trigger` the rest is cast where it lands; several casts go in turn.
//
// delay: seconds between its casts · recharge: after its last · tier: the
// least focus it needs (1 a wand, 2 a staff) · element: Fire, Frost, Storm,
// Acid, Force or Gravity (none: arcane): its element's power (and spell
// power) make it stronger, and its hurt is of that element · about: a line
// for tooltips · beast: a creature's own, never on a wand. The order matters where a focus readies a spell: the
// strongest of its element it can cast, the first of those.
(
    spells: [
        (id: "spark_bolt", name: "Spark bolt", runes: ["bolt", "spark", "knock", "shatter"], delay: 0.12, recharge: 0.12, element: Radiant,
            about: "Quick sparks of light: knock back what they hit and break earth and stone."),
        (id: "shock_bolt", name: "Shock bolt", runes: ["bolt", "spark", "arc"], delay: 0.4, recharge: 0.4, element: Storm,
            about: "A bolt that arcs where it lands: into water, and whatever's wet or standing in it."),
        (id: "star_bomb", name: "Star bomb", runes: ["star", "starburst", "nova"], delay: 0.8, recharge: 0.8, element: Radiant,
            about: "A bouncing star that bursts: soft ground vaporised, what's near thrown. No fire."),
        (id: "fireball", name: "Fireball", runes: ["trail_fire", "fire_drops", "orb", "blast", "ignite"], delay: 0.6, recharge: 0.6, element: Fire,
            about: "A bouncing orb of fire that bursts where it stops."),
        (id: "acid_arrow", name: "Acid arrow", runes: ["gravity", "arrow", "acid"], delay: 0.35, recharge: 0.35, element: Acid,
            about: "Lobbed acid: it eats what it lands on."),
        (id: "frost_bolt", name: "Frost bolt", runes: ["bolt", "frost"], delay: 0.3, recharge: 0.3, element: Frost,
            about: "Chills what it hits; freezes water it lands on (an ice patch to stand on)."),
        (id: "gravity_well", name: "Gravity well", runes: ["gravity_well"], delay: 0.2, recharge: 0.4, element: Gravity,
            about: "Hold: a well at the cursor lifts what it can (an orc and some rock). Swing it; let go to drop it all."),
        (id: "force", name: "Force", runes: ["force"], delay: 0.1, recharge: 0.2, element: Force,
            about: "Hold left: push everything away from the cursor. Hold right: pull it in."),
        (id: "flame_jet", name: "Flame jet", runes: ["flame_stream"], delay: 0.03, recharge: 0.03, tier: 2, element: Fire,
            about: "A stream of burning oil."),
        (id: "lightning", name: "Lightning", runes: ["lightning"], delay: 0.7, recharge: 0.7, tier: 2, element: Storm,
            about: "The sky's lightning, from your hand, to what's near where you aim."),
        (id: "great_well", name: "Great gravity well", runes: ["gravity_well_ii"], delay: 0.2, recharge: 0.4, tier: 2, element: Gravity,
            about: "A bigger well: lifts a crowd, tears out harder rock."),
        (id: "ice_wall", name: "Ice wall", runes: ["ice_wall"], delay: 1.0, recharge: 1.0, element: Frost,
            about: "A wall of ice raised where you aim: cover, a dam, a trap. It melts, slowly; fire thaws it."),
        (id: "toxic_cloud", name: "Toxic cloud", runes: ["toxic_cloud"], delay: 1.0, recharge: 1.0, element: Acid,
            about: "A heavy cloud of miasma: it sinks into pits, eats at what breathes it, and burns if lit."),
        (id: "fire_wall", name: "Fire wall", runes: ["fire_wall"], delay: 1.2, recharge: 1.2, tier: 2, element: Fire,
            about: "A wall of flame raised where you aim, burning for five seconds: what walks through catches."),
        (id: "fire_ray", name: "Fire ray", runes: ["ray", "ray_burn", "ray_ignite", "ray_heat"], delay: 0.0, recharge: 0.0, tier: 2, element: Fire,
            about: "Hold: a ray of heat. Lights what burns at range, boils water, melts ice."),
        (id: "frost_ray", name: "Frost ray", runes: ["ray", "ray_chill", "ray_frost"], delay: 0.0, recharge: 0.0, tier: 2, element: Frost,
            about: "Hold: a freezing ray. Sweep it over water for an ice bridge; over lava, it crusts to stone."),
        (id: "vaporiser", name: "Vaporiser", runes: ["cutting_ray", "ray_sear", "ray_boil", "vaporise"], delay: 0.0, recharge: 0.0, tier: 2, element: Radiant,
            about: "Hold: a cutting beam. Eats what it plays on, dirt at once, stone in a moment; burns through armour."),
        (id: "great_force", name: "Great force", runes: ["force_ii"], delay: 0.1, recharge: 0.2, tier: 2, element: Force,
            about: "Stronger force: wider, harder, tears out rock."),
        // Creatures' own (`beast`: never on a wand).
        (id: "spider_spit", name: "Spider spit", runes: ["gravity", "arrow", "venom_glob", "acid_drops"], delay: 0.1, recharge: 0.1, element: Acid, beast: true,
            about: "A glob of acid, lobbed."),
    ],
)
