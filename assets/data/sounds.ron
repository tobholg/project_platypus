// Sounds (sound/): every sound the game makes, as a recipe the game renders
// when it starts (and again when this file is saved), or a recording.
// The arena panel's Sounds row plays each. F11 mutes everything.
//
// volumes: the buses (master, effects, ambience, music), 0..1; cave_reverb:
//   how much of every effect echoes underground (a reverb the effects are
//   sent to, as deep as you are).
// sounds: by name (the code asks for them by these names). Each:
//   make: the recipe (sound/synth.rs has them all):
//     Thud(pitch, drop, noise, length, bright)  a blow: a falling tone, a burst
//     Clang(pitch, ring, length, grit, muffle)  metal or stone: partials ringing,
//                                               a gritty scrape
//     Whoosh(from, to, length, q)               air: noise through a sweeping band
//     Burst(cutoff, length, q, body, grit)      steps, digging: a noise burst,
//                                               a thump under it, crunch
//     Drip(pitch, rise, length)                 a water drop
//     Boom(length, sub)                         a blast
//     Zap(pitch, length)                        electricity
//     Chime(pitch, notes, length)               bell notes (semitones)
//     Blip(pitch, to, length)                   a sweep (interface)
//     Step(heel, scuff, q, grit, length, muffle)  a footstep: a soft pat
//     Swish(low, high, length, q, whistle)      a swing: a band rising to `high`
//                                               and back as the blade passes
//     Slash(chop, weight, edge, wet, tear, length, muffle)  a blade biting in:
//                                               the edge's bright tick, the chop (about
//                                               `chop` Hz, wet), tiny wet bursts (`tear`
//                                               a second), the weight behind it (0: none)
//     (Slash also: slice (a longer cut sweeping down from high), soft (the
//     chop's rise, s: longer, less of a knock).)
//     Cut(low, high, length, tail, tear, snap)  a blade's cut, shaped as its
//                                               swing: a band sweeping up, cut off
//                                               at the contact, a short wet fall
//     Song(root, bpm, bar, chords, phrases, form, arp, bright)  a piece: pads,
//                                               bass, arpeggio, and the melody (form:
//                                               a phrase per cycle, -1 none; notes
//                                               (semitones, beats), 99 a rest)
//     Impact(body, crack, flesh, slice, ring, length, muffle)  a blow: crack,
//                                               punch, thwack, a blade's slice,
//                                               a glassy ring (being hurt), all
//                                               muffled above `muffle` Hz
//   loops (seconds long): Fire(crackle, roar, hiss), Cave(rumble, wind, hum),
//     Rain(drops), Wind(gust), Water(bubbles), Lava(glops),
//     Thrust(roar, hiss, flutter),
//     Pads(root Hz, chords [[semitones]], chord s, bright Hz, plucks, scale)
//   file: "sounds/x.ogg" instead of make (a recording, under assets/).
//   variants: takes made (one picked each play); volume; pitch: each play
//   up to this much higher or lower; reverb (0..1, `room`: its time, s);
//   echo (each echo this much of the last); loops: seconds (a loop);
//   every: at most once this often (s).
//
// Ambience beds (`*_bed`) and music (`music_*`) are played by the world
// (sound/ambience.rs): fire nearby, a cave's air, wind and rain in the
// open, water moving, lava; the music's mood by where you are and when.
(
    volumes: (master: 0.8, sfx: 0.9, ambience: 0.7, music: 0.3, cave_reverb: 0.45),
    sounds: {
        // ---- combat ----
        // A blade landing (a heavy blow, a crit: the same, lower); you, hurt.
        // (hit_b, hit_i, hit_j, hit_k: other takes on "hit" to compare,
        // heard on every blow with PLATYPUS_HIT=b (i, j, k, old), or from
        // the arena's Sounds row; hit_old: the first one.)
        "hit": (make: Slash(chop: 850, weight: 130, edge: 0.55, wet: 0.45, length: 0.15, muffle: 5500), variants: 6, pitch: 0.07, volume: 0.85),
        "hit_b": (make: Slash(chop: 600, weight: 110, edge: 0.35, wet: 0.8, length: 0.2, muffle: 4000), variants: 6, pitch: 0.07, volume: 0.9),
        // i, j, k: a cut shaped as the swing (the band sweeping up as the
        // blade arrives, cut off at the contact with a snap, a short wet
        // fall), nothing under 500 Hz. i: balanced; j: a longer swing into
        // it; k: short and crisp.
        "hit_i": (make: Cut(low: 900, high: 3400, length: 0.03, tail: 0.07, tear: 260, snap: 0.5), variants: 6, pitch: 0.07, volume: 0.85),
        "hit_j": (make: Cut(low: 600, high: 2800, length: 0.045, tail: 0.08, tear: 200, snap: 0.4), variants: 6, pitch: 0.07, volume: 0.85),
        "hit_k": (make: Cut(low: 1200, high: 4200, length: 0.02, tail: 0.05, tear: 380, snap: 0.6), variants: 6, pitch: 0.07, volume: 0.8),
        "hit_old": (make: Impact(body: 150, crack: 0.25, flesh: 700, slice: 0.15, length: 0.16, muffle: 2800), variants: 5, pitch: 0.08, volume: 0.8),
        "hurt": (make: Impact(body: 95, crack: 0.15, flesh: 500, ring: 0.2, length: 0.22, muffle: 1600), variants: 3, pitch: 0.05, reverb: 0.12, room: 0.8, volume: 0.8, every: 0.25),
        "death": (make: Thud(pitch: 55, drop: 1.0, noise: 0.8, length: 0.6, bright: 1400), variants: 2, reverb: 0.3, volume: 0.8),
        "swing": (make: Swish(low: 250, high: 1800, length: 0.22, q: 1.8, whistle: 0.4), variants: 5, pitch: 0.08, volume: 0.5),
        "swing_heavy": (make: Swish(low: 120, high: 800, length: 0.34, q: 1.2, whistle: 0.15), variants: 4, pitch: 0.06, volume: 0.6),
        "clang": (make: Clang(pitch: 750, ring: 0.05, length: 0.16, grit: 1.0, muffle: 3500), variants: 5, pitch: 0.08, volume: 0.55),
        "bounce": (make: Clang(pitch: 1100, ring: 0.06, length: 0.15, grit: 0.4, muffle: 5000), variants: 3, pitch: 0.05, volume: 0.45),
        "slam": (make: Boom(length: 0.7, sub: 1.2), variants: 2, volume: 0.8),
        "bow": (make: Whoosh(from: 1800, to: 700, length: 0.12, q: 2.5), variants: 3, pitch: 0.08, volume: 0.4),

        // ---- moving ----
        "step_stone": (make: Step(heel: 90, scuff: 1400, q: 0.8, grit: 0.05, length: 0.07, muffle: 1800), variants: 6, pitch: 0.06, volume: 0.3),
        "step_dirt": (make: Step(heel: 75, scuff: 600, q: 0.7, grit: 0.1, length: 0.08, muffle: 1200), variants: 6, pitch: 0.06, volume: 0.35),
        "step_grass": (make: Step(heel: 70, scuff: 1100, q: 0.5, grit: 0.15, length: 0.09, muffle: 1600), variants: 6, pitch: 0.06, volume: 0.3),
        "step_sand": (make: Step(heel: 60, scuff: 1600, q: 0.5, grit: 0.4, length: 0.1, muffle: 2000), variants: 6, pitch: 0.06, volume: 0.28),
        "step_snow": (make: Step(heel: 70, scuff: 1100, q: 0.6, grit: 0.5, length: 0.11, muffle: 1800), variants: 5, pitch: 0.06, volume: 0.3),
        "step_wood": (make: Step(heel: 130, scuff: 700, q: 2.0, length: 0.07, muffle: 1500), variants: 5, pitch: 0.05, volume: 0.35),
        "step_water": (make: Step(scuff: 900, q: 1.2, grit: 0.3, length: 0.14, muffle: 2000), variants: 4, pitch: 0.08, volume: 0.3),
        "land": (make: Thud(pitch: 70, drop: 0.4, noise: 0.6, length: 0.14, bright: 1500), variants: 3, pitch: 0.05, volume: 0.55),
        "jump": (make: Burst(cutoff: 1500, length: 0.05, q: 0.7), variants: 3, pitch: 0.1, volume: 0.2),
        "air_jump": (make: Whoosh(from: 1600, to: 400, length: 0.18, q: 0.8), variants: 2, pitch: 0.05, volume: 0.35),
        "dash": (make: Whoosh(from: 600, to: 3000, length: 0.14, q: 0.9), variants: 3, pitch: 0.06, volume: 0.4),
        "hook_throw": (make: Whoosh(from: 1200, to: 500, length: 0.2, q: 1.5), variants: 2, pitch: 0.05, volume: 0.35),
        "hook_bite": (make: Clang(pitch: 800, ring: 0.04, length: 0.12, grit: 0.6, muffle: 4000), variants: 3, pitch: 0.06, volume: 0.4),

        // ---- hands ----
        "mine_stone": (make: Clang(pitch: 1000, ring: 0.03, length: 0.1, grit: 0.9, muffle: 3000), variants: 5, pitch: 0.08, volume: 0.3),
        "mine_dirt": (make: Burst(cutoff: 800, length: 0.08, q: 0.7, body: 80, grit: 0.4), variants: 5, pitch: 0.08, volume: 0.35),
        "mine_sand": (make: Burst(cutoff: 3500, length: 0.1, q: 0.6, grit: 0.6), variants: 4, pitch: 0.08, volume: 0.3),
        "mine_wood": (make: Burst(cutoff: 600, length: 0.08, q: 2.5, body: 140), variants: 4, pitch: 0.06, volume: 0.4),
        "break": (make: Burst(cutoff: 1200, length: 0.2, q: 0.6, body: 70, grit: 0.7), variants: 3, pitch: 0.08, volume: 0.45),
        "place": (make: Thud(pitch: 140, drop: 0.2, noise: 0.4, length: 0.08, bright: 2000), variants: 3, pitch: 0.06, volume: 0.35),
        "craft": (make: Chime(pitch: 700, notes: [0, 7], length: 0.4), volume: 0.35),
        "toast": (make: Chime(pitch: 660, notes: [0, 4, 7, 12], length: 0.9), reverb: 0.3, volume: 0.4),
        "pickup": (make: Blip(pitch: 700, to: 1400, length: 0.07), variants: 2, pitch: 0.05, volume: 0.25, every: 0.05),

        // ---- the world ----
        "boom": (make: Boom(length: 1.6, sub: 1.0), variants: 3, pitch: 0.05, reverb: 0.25, room: 2.5, volume: 1.0),
        "thunder": (make: Boom(length: 3.0, sub: 1.3), variants: 2, pitch: 0.1, reverb: 0.4, room: 3.5, volume: 1.0),
        "zap": (make: Zap(pitch: 180, length: 0.35), variants: 3, volume: 0.55),
        "cast": (make: Whoosh(from: 900, to: 3500, length: 0.22, q: 3.0), variants: 3, pitch: 0.08, reverb: 0.2, volume: 0.4),
        "spit": (make: Burst(cutoff: 1800, length: 0.15, q: 1.5, grit: 0.3), variants: 2, pitch: 0.1, volume: 0.45),
        "drip": (make: Drip(pitch: 650, rise: 0.6, length: 0.12), variants: 5, pitch: 0.12, echo: 0.35, reverb: 0.65, room: 4.0, volume: 0.45),

        // ---- ambience beds (loops the world fades in and out) ----
        "fire_bed": (make: Fire(crackle: 22, roar: 0.7, hiss: 0.12), loops: 14, volume: 1.0),
        "cave_bed": (make: Cave(rumble: 0.7, wind: 0.6, hum: 0.5), loops: 20, reverb: 0.45, room: 4.5, volume: 0.7),
        "wind_bed": (make: Wind(gust: 0.4), loops: 20, volume: 0.3),
        "rain_bed": (make: Rain(drops: 90), loops: 12, volume: 0.7),
        "water_bed": (make: Water(bubbles: 14), loops: 12, volume: 0.6),
        "lava_bed": (make: Lava(glops: 1.2), loops: 14, volume: 0.8),
        // Rocket boots firing (faded in while they fire, out when they stop).
        "rocket_bed": (make: Thrust(roar: 0.8, hiss: 1.2, flutter: 28), loops: 6, volume: 0.6),

        // ---- music (a mood each, crossfaded by where you are and when) ----
        // Day: D major, open and warm; a pluck now and then.
        "music_day": (make: Pads(root: 146.83, chords: [[0, 4, 7, 11], [5, 9, 12, 16], [9, 12, 16, 19], [7, 11, 14, 18]], chord: 6.0, bright: 1800, plucks: 0.25, scale: [0, 2, 4, 7, 9]), loops: 96, reverb: 0.5, room: 4.0, volume: 0.8),
        // Night: A minor, slower, darker.
        "music_night": (make: Pads(root: 110.0, chords: [[0, 3, 7, 10, 14], [-4, 0, 3, 7], [5, 8, 12, 15], [7, 10, 14, 17]], chord: 8.0, bright: 1100, plucks: 0.15, scale: [0, 3, 5, 7, 10]), loops: 128, reverb: 0.55, room: 5.0, volume: 0.8),
        // Options for the music (melody, chords, bass, a soft arpeggio in
        // one piece: the melody written against the chords), previews to
        // hear from the arena's Sounds row: an intro, two phrases, a
        // breath, two more.
        // A minor, Am F C G, 96 bpm: lyrical, flowing.
        "song_a": (make: Song(root: 220.0, bpm: 96, chords: [[0, 3, 7], [-4, 0, 3], [3, -2, 7], [-2, 2, 5]],
            phrases: [
                [(19, 1.5), (17, 0.5), (15, 1), (12, 1), (15, 1.5), (17, 0.5), (20, 1), (19, 1), (19, 2), (17, 0.5), (15, 0.5), (17, 1), (14, 1.5), (15, 0.5), (17, 2)],
                [(19, 1.5), (17, 0.5), (15, 1), (12, 1), (15, 1.5), (17, 0.5), (20, 0.5), (22, 0.5), (24, 1), (22, 0.75), (19, 0.25), (19, 1), (17, 0.5), (15, 1.5), (17, 1), (15, 0.5), (14, 0.5), (14, 1.5), (99, 0.5)],
                [(24, 0.75), (22, 0.25), (24, 0.5), (19, 0.5), (15, 0.5), (19, 0.5), (24, 1), (20, 0.75), (19, 0.25), (20, 0.5), (15, 0.5), (17, 0.5), (20, 0.5), (24, 1), (22, 0.75), (19, 0.25), (22, 0.5), (15, 0.5), (19, 1.5), (17, 0.5), (17, 0.75), (14, 0.25), (17, 0.5), (22, 0.5), (19, 1), (17, 1)],
                [(24, 0.75), (22, 0.25), (24, 0.5), (19, 0.5), (15, 0.5), (19, 0.5), (24, 1), (20, 0.75), (19, 0.25), (20, 0.5), (24, 0.5), (22, 0.5), (20, 0.5), (19, 1), (19, 0.75), (17, 0.25), (15, 0.5), (19, 0.5), (22, 1.5), (19, 0.5), (17, 0.5), (19, 0.5), (17, 0.5), (14, 0.5), (12, 1.5), (99, 0.5)]],
            form: [-1, 0, 1, -1, 2, 3], arp: 0.08), reverb: 0.45, room: 4.0, volume: 0.8),
        // E minor, Em C G D, 108 bpm: bouncy, syncopated.
        "song_b": (make: Song(root: 164.81, bpm: 108, chords: [[0, 3, 7], [-4, 0, 3], [3, 7, 10], [-2, 2, 5]],
            phrases: [
                [(19, 0.5), (22, 0.5), (24, 0.75), (22, 0.25), (19, 0.5), (15, 0.5), (19, 1), (20, 0.5), (19, 0.5), (15, 0.5), (12, 0.5), (15, 1), (19, 1), (22, 0.5), (19, 0.5), (15, 0.5), (19, 0.5), (22, 0.75), (24, 0.25), (22, 1), (26, 0.5), (24, 0.5), (22, 0.5), (17, 0.5), (14, 1), (17, 0.5), (22, 0.5)],
                [(24, 0.5), (27, 0.5), (26, 0.75), (24, 0.25), (22, 0.5), (19, 0.5), (24, 1), (20, 0.5), (24, 0.5), (27, 0.75), (24, 0.25), (20, 1), (19, 1), (22, 0.5), (19, 0.5), (15, 0.5), (22, 0.5), (27, 0.75), (26, 0.25), (24, 1), (22, 0.5), (26, 0.5), (24, 1), (22, 0.5), (22, 1), (99, 0.5)],
                [(12, 0.5), (15, 0.5), (19, 0.5), (24, 0.5), (22, 0.75), (19, 0.25), (15, 1), (12, 0.5), (15, 0.5), (19, 0.5), (20, 0.5), (19, 1), (15, 1), (15, 0.5), (19, 0.5), (22, 0.5), (27, 0.5), (26, 0.75), (22, 0.25), (19, 1), (14, 0.5), (17, 0.5), (22, 0.5), (26, 0.5), (24, 1), (22, 1)],
                [(24, 0.75), (22, 0.25), (19, 0.5), (22, 0.5), (24, 1), (27, 1), (24, 0.75), (20, 0.25), (19, 0.5), (20, 0.5), (24, 1), (19, 1), (22, 0.75), (19, 0.25), (15, 0.5), (19, 0.5), (22, 0.5), (24, 0.5), (26, 1), (24, 0.5), (22, 0.5), (19, 0.5), (17, 0.5), (19, 1.5), (99, 0.5)]],
            form: [-1, 0, 1, -1, 2, 3], arp: 0.08), reverb: 0.45, room: 4.0, volume: 0.8),
        // D dorian, Dm G F C, 100 bpm: hopeful minor.
        "song_c": (make: Song(root: 146.83, bpm: 100, chords: [[0, 3, 7], [5, 9, 12], [3, 7, 10], [-2, 2, 5]],
            phrases: [
                [(19, 1), (24, 0.5), (22, 0.5), (19, 1), (15, 1), (21, 1.5), (19, 0.5), (17, 0.5), (21, 0.5), (26, 1), (24, 1), (22, 0.5), (19, 0.5), (15, 0.5), (17, 0.5), (19, 1), (22, 1.5), (19, 0.5), (17, 0.5), (14, 0.5), (17, 1)],
                [(24, 0.75), (26, 0.25), (27, 0.5), (26, 0.5), (24, 1), (19, 1), (21, 0.75), (24, 0.25), (26, 0.5), (24, 0.5), (21, 1), (17, 1), (27, 0.75), (26, 0.25), (24, 0.5), (22, 0.5), (19, 1), (24, 1), (26, 0.5), (24, 0.5), (22, 0.5), (19, 0.5), (22, 1.5), (99, 0.5)],
                [(12, 0.5), (15, 0.5), (19, 0.5), (24, 0.5), (22, 1), (19, 1), (17, 0.5), (21, 0.5), (24, 0.5), (26, 0.5), (24, 1), (21, 1), (15, 0.5), (19, 0.5), (22, 0.5), (27, 0.5), (26, 1), (24, 1), (22, 0.5), (19, 0.5), (17, 0.5), (14, 0.5), (17, 1.5), (99, 0.5)],
                [(19, 0.75), (24, 0.25), (27, 0.5), (26, 0.5), (24, 1), (22, 1), (21, 0.75), (26, 0.25), (24, 0.5), (21, 0.5), (19, 1), (17, 1), (19, 0.75), (22, 0.25), (24, 0.5), (27, 0.5), (26, 1), (24, 1), (22, 0.75), (19, 0.25), (17, 0.5), (14, 0.5), (12, 1.5), (99, 0.5)]],
            form: [-1, 0, 1, -1, 2, 3], arp: 0.08), reverb: 0.45, room: 4.0, volume: 0.8),

        // Underground: low, open fifths, uneasy; sparse.
        "music_cave": (make: Pads(root: 73.42, chords: [[0, 7, 15], [-2, 5, 14], [3, 10, 15], [0, 7, 13]], chord: 10.0, bright: 700, plucks: 0.1, scale: [0, 3, 7, 8, 12]), loops: 120, reverb: 0.6, room: 6.0, volume: 0.9),
    },
)
