// Lighting and the day (SPEC §4.1). Edit while the game runs.
(
    // Light everywhere at least this bright: 0 is Noita-dark (unlit caves are
    // black), ~0.12 is Terraria-ish.
    ambient: 0.0,
    // Light kept per cell of clear air: higher reaches further. (Per cell:
    // at 1.5× the cells, 0.955^(1/1.5), the same reach on screen.)
    air_falloff: 0.970,
    // Spreading passes; 2 lets light turn corners.
    iterations: 2,
    // Light kept per cell going into rock from a lit face: how deep a lit
    // wall shows (it never passes through walls).
    rim: 0.932,
    // Haze added around glowing things (fire, lava, acid) in the dark.
    glow_haze: 0.3,

    // A full day and night, in real minutes, and the hour the game starts at.
    day_minutes: 20,
    start_hour: 8,
    // Moonlight: 1 = a dark blue night you can just see in, 0 = pitch black.
    moonlight: 0.45,

    // What the player carries: a lantern always (faint: underground it shows
    // you and the rock at your side, little more; bring a light); L steps through nothing, a
    // small flashlight, the big one (a cone toward the cursor, `angle`
    // degrees wide, `range` cells) and a torch in the off hand.
    lantern: (color: (255, 196, 130), strength: 0.08),
    flashlight: (color: (230, 238, 255), strength: 1.8, range: 360, angle: 46),
    flashlight_small: (color: (240, 236, 220), strength: 1.1, range: 195, angle: 30),
    // A torch (held, planted with G or the torch item): its light, and its
    // fire, a look only (counts are a second's worth; see runes.ron for the
    // fields): flames rising and shrinking from white to red, a wisp of
    // smoke, now and then an ember.
    // (haze: a share of its light hazing over the dark around it, as
    // glowing cells do.) A warm white, not orange: as bright as the old
    // (255, 158, 70) × 3.0 was (the same luminance), without its sepia
    // cast and glare.
    torch: (color: (255, 208, 152), strength: 2.4, haze: 0.15),
    fire: (
        flame: (count: 110, life: (0.14, 0.4), colors: [(255, 252, 230), (255, 222, 120), (255, 150, 50), (225, 80, 25), (140, 40, 20)], speed: 30, spread: 0.22, gravity: -90, drag: 3, glow: true),
        smoke: (count: 5, life: (0.8, 1.6), colors: [(70, 64, 60), (54, 50, 48), (40, 38, 38)], speed: 15, spread: 0.3, gravity: -12, drag: 1.2, size: 1.5),
        embers: (count: 1.5, life: (0.5, 1.1), colors: [(255, 236, 170), (255, 150, 60), (190, 70, 25)], speed: 51, spread: 0.5, gravity: -38, drag: 1.5, jitter: 38),
    ),
    glowstick: (strength: 2.2, secs: 90, haze: 0.4),
)
