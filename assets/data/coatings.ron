// What fluids leave on a creature (materials.ron: `coats: "wet"`), Noita's
// way: each is a share of the creature covered (0..100 %), several at once,
// never more than all of it together. In a fluid its share rises towards
// how deep in it you are (knee deep ~40 %, waist deep ~80 %, under: 100 %);
// a new one pushes the others off to make room, so jumping in water washes
// acid off. Out of it, a share wears off over `secs`. Edit while the game
// runs.
//
// secs:        how long all of it takes to wear off
// soak:        how readily it soaks in: its share rises towards this × the
//              share of the body in it (1.6 unless said)
// color:       its icon and tint
// fireproof:   wet: at 40 % or more it puts a fire out, and it can't catch;
//              under that, never more of you alight than you're dry (a
//              fire dries it where it burns)
// heat_resist: share of heat damage it ignores (0..1), all of it on
// burn:        set alight while coated, it burns this many times as long and
//              as hard (1 = normal), all of it on
// catches:     at 25 % or more it catches fire from heat alone (anything
//              above 60 °C), not just flames
// damage:      damage per second, all of it on (less as it wears off)
// sticks:      only a washing fluid pushes it off (other fluids don't)
// washes:      pushes even a sticky coating off
// slow:        how much of your speed it takes, all of it on
// look:        how it shows on a body, all of it on (less the less of it):
//   tint:  its tint (else `color`), `much` how far towards it (0.4)
//   throb: the tint pulsing this deep;  sheen: a glint now and then, this
//          bright;  glow: a faint light of its colour, this strong
//   shed:  sparks off it: `rate` a second, from anywhere on it (`low`: its
//          lower half), sent `dir`; `sparks` as in weapons.ron
//   sound: (name, every so many seconds, with at least this much on)
{
    // A little darker and cooler, dripping.
    "wet":    (label: "Wet",    secs: 6,  color: (80, 150, 235), fireproof: true, heat_resist: 0.5, washes: true,
        look: (tint: (120, 150, 200), much: 0.45, shed: [
            (rate: 8, low: true, dir: (0, -1), sparks: (count: 1, life: (0.25, 0.5), colors: [(170, 210, 255), (80, 140, 225)], speed: 6, spread: 0.3, gravity: 220, size: 1)),
        ])),
    // Dark and glossy, dripping heavy (and near fire, it shimmers a warning:
    // signs.rs).
    "oily":   (label: "Oily",   secs: 12, color: (120, 90, 40),  burn: 2.5, catches: true,
        look: (tint: (70, 52, 30), much: 0.6, sheen: 0.7, shed: [
            (rate: 5, low: true, dir: (0, -1), sparks: (count: 1, life: (0.4, 0.8), colors: [(90, 66, 34), (40, 28, 14)], speed: 3, spread: 0.2, gravity: 320, size: 1)),
        ])),
    "bloody": (label: "Bloody", secs: 5,  color: (170, 20, 30),  fireproof: true, heat_resist: 0.2),
    // Clings: a step in it coats your legs well, and it eats until it's worn
    // off or washed off (jump in water).
    // A sharp green glow, fizzing and hissing.
    "acid":   (label: "Acid",   secs: 8,  color: (130, 235, 50), damage: 6, soak: 5,
        look: (much: 0.45, glow: 0.07, sound: ("acid_hiss", 1.3, 0.15), shed: [
            (rate: 24, sparks: (count: 1, life: (0.1, 0.3), colors: [(230, 255, 170), (120, 230, 40)], speed: 25, spread: 1.2, gravity: -30, drag: 4, size: 1, jitter: 12, glow: true)),
            (rate: 3, low: true, dir: (0, -1), sparks: (count: 1, life: (0.3, 0.6), colors: [(150, 240, 70)], speed: 4, spread: 0.3, gravity: 200, size: 1)),
        ])),
    // A spider's sting (and a fang's bite): it burns in; wash it off.
    // A faint purple-green glow, a sickly throb, bubbling and dripping.
    "venom":  (label: "Venom",  secs: 7,  color: (150, 60, 200), damage: 7, harm: poison, sticks: true,
        look: (tint: (150, 110, 170), much: 0.5, throb: 0.45, glow: 0.05, shed: [
            (rate: 12, sparks: (count: 1, life: (0.5, 1.0), colors: [(200, 150, 240), (120, 190, 90)], speed: 5, spread: 0.6, gravity: -22, drag: 1, size: 1, glow: true)),
            (rate: 4, low: true, dir: (0, -1), sparks: (count: 1, life: (0.3, 0.7), colors: [(160, 80, 210), (90, 150, 70)], speed: 3, spread: 0.2, gravity: 200, size: 1)),
        ])),
    // A slime's goo: it clings and clogs (slower, the more of you it's on),
    // and green goo catches fire.
    "slimy":  (label: "Slimy",  secs: 6,  color: (110, 210, 90), slow: 0.55, sticks: true, burn: 1.5),
}
