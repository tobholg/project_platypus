// Progression (DESIGN §7d, progress.rs): milestones. Hot-reloaded.
//
// Each: id, name, about (a line), when, and what reaching it gives:
//   gives: items [(id, count in the item's units: blocks as blocks)];
//   unlocks: locked recipes (crafting.ron), by the item they make.
// when: Holds(item) (held or worn, ever) · Crafted(item) · Depth(cells below
//   sea level, the deepest you've been) · Killed(creature, count) · Done(milestone)
//   · All([..]) · Any([..])
//
// Examples to build on: the first steps up the crafting ladder, the depths,
// and some fights; the deeper ones unlock the recipes kept locked.
(
    milestones: [
        (id: "timber", name: "Timber", about: "Wood makes planks; planks make a workbench",
            when: Holds("block:wood")),
        (id: "workbench", name: "A place to work", about: "More to make at a workbench",
            when: Crafted("workbench")),
        (id: "ore", name: "Ore", about: "Smelt it in a furnace",
            when: Any([Holds("block:copper_ore"), Holds("block:iron_ore"), Holds("block:silver_ore"), Holds("block:gold_ore")])),
        (id: "first_bar", name: "Smelter", about: "Bars make tools at an anvil",
            when: Any([Crafted("copper_bar"), Crafted("iron_bar"), Crafted("silver_bar"), Crafted("gold_bar")]),
            gives: [("torch", 10)]),
        (id: "smith", name: "Smith",
            when: Crafted("anvil"), gives: [("iron_bar", 3)]),
        (id: "below", name: "Below", about: "The dark gets darker",
            when: Depth(300), gives: [("glowstick", 5)]),
        (id: "caverns", name: "The caverns",
            when: Depth(2500), gives: [("bomb", 3)]),
        (id: "gems", name: "Gemstones", about: "An arcane altar can be made at an anvil",
            when: Any([Holds("block:amethyst"), Holds("block:emerald"), Holds("block:ruby")]),
            unlocks: ["arcane_altar"]),
        (id: "deep", name: "The deep", about: "Mithril and void answer now",
            when: Depth(7000), unlocks: ["mithril_pickaxe", "void_wand", "void_staff"]),
        (id: "orc_hunter", name: "Orc hunter",
            when: Killed("orc", 5), gives: [("iron_bar", 5)]),
        (id: "troll_slayer", name: "Troll slayer",
            when: Killed("troll", 1), gives: [("gold_bar", 5)]),
        (id: "spider_slayer", name: "Nest breaker", about: "Silk can be spun into a line",
            when: Killed("spider", 1), unlocks: ["silk_line"]),
    ],
)
