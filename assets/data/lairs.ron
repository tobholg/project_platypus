// Lairs: cave chambers something has made its home (worldgen/src/lairs.rs).
// The world picks which chambers from its seed, at world creation (so a
// change here shows in a new world, or chunks not yet visited).
//   depth: how deep under the surface (cells, from, to)
//   zones: underground biomes (fungal, crystal, toxic, none = plain rock); [] any
//   bands: depth bands (underground, caverns, deep...: each as deep as it is in
//     this world's size); [] any
//   chance: share of the chambers it could take that it does
//   lining: what lines its walls (and hangs from its roof), density 0..1
//   keepers: who lives there, and how many; min_size: half width at least
//   start: one of the start valley's shallow caverns' (only those): Any
//     side, the Dark wood's or the Light forest's; each cavern takes one
//     of its side's in turn, so they differ
//   chest: a chest on its floor
//   litter: what lies heaped on its floor (a roost's guano), litter_density
//     how much of it (0..1)
[
    // The start valley's caverns.
    (name: "orc den", depth: (0, 400), chance: 1.0, start: Dark, chest: true,
     lining: "cobweb", density: 0.0, keepers: [("orc", 1), ("orc_archer", 1)]),
    (name: "bone crypt", depth: (0, 400), chance: 1.0, start: Any, chest: true,
     lining: "cobweb", density: 0.15, keepers: [("skeleton", 2)]),
    (name: "spider lair", depth: (0, 400), chance: 1.0, start: Dark, chest: true,
     lining: "cobweb", density: 0.5, keepers: [("spider", 1), ("egg_sac", 2), ("cocoon", 2)]),
    (name: "zombie burrow", depth: (0, 400), chance: 1.0, start: Dark, chest: true,
     lining: "cobweb", density: 0.05, keepers: [("zombie", 2)]),
    // A colony asleep on its roof (wake it and it pours out): guano heaped
    // under it.
    (name: "bat roost", depth: (0, 400), chance: 1.0, start: Light, chest: true,
     lining: "cobweb", density: 0.05, litter: "guano", litter_density: 0.6, keepers: [("cave_bat", 4)]),
    (name: "treasure grotto", depth: (0, 400), chance: 1.0, start: Light, chest: true,
     lining: "cobweb", density: 0.05, keepers: [("cave_bat", 2)]),
    (name: "spider nest", depth: (180, 150000), bands: ["caverns"], zones: ["none", "fungal"], chance: 0.1,
     lining: "cobweb", density: 0.55, keepers: [("spider", 1), ("egg_sac", 2), ("spiderling", 1), ("cocoon", 3)]),
    // A phase nest: the deep's spider nest, its eggs glowing.
    (name: "phase nest", depth: (180, 150000), bands: ["deep"], zones: ["none", "fungal", "crystal"], chance: 0.1,
     lining: "cobweb", density: 0.5, keepers: [("phase_spider", 1), ("phase_egg_sac", 3), ("phase_spiderling", 2), ("cocoon", 2)]),
    // Bat colonies: the upper caves' commonest lair; eight or so asleep on
    // the roof, guano heaped under them.
    // (Smaller in the Burrows, full size below.)
    (name: "bat colony", depth: (250, 150000), bands: ["underground"], zones: ["none", "fungal", "crystal"], chance: 0.1, min_size: 16,
     lining: "cobweb", density: 0.0, litter: "guano", litter_density: 0.6, keepers: [("cave_bat", 5)]),
    (name: "great bat colony", depth: (250, 150000), bands: ["caverns", "deep"], zones: ["none", "fungal", "crystal"], chance: 0.14, min_size: 16,
     lining: "cobweb", density: 0.0, litter: "guano", litter_density: 0.7, keepers: [("cave_bat", 9)]),
    // A rat nest: a pack's home in the upper caves.
    (name: "rat nest", depth: (40, 150000), bands: ["surface", "underground"], zones: ["none", "fungal"], chance: 0.07, min_size: 14,
     lining: "cobweb", density: 0.02, keepers: [("rat_lithe", 5)]),
    (name: "slime pit", depth: (90, 150000), zones: ["toxic"], chance: 0.3,
     lining: "slime", density: 0.25, keepers: [("acid_slime", 3)]),
    (name: "centipede hole", depth: (120, 150000), bands: ["surface", "underground", "caverns"], zones: ["none", "fungal"], chance: 0.06,
     lining: "cobweb", density: 0.04, keepers: [("centipede", 2)]),
    (name: "bone pit", depth: (600, 150000), bands: ["caverns", "deep"], zones: [], chance: 0.06,
     lining: "cobweb", density: 0.2, keepers: [("skeleton", 3), ("vampire_bat", 2)]),
]
