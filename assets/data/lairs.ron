// Lairs: cave chambers something has made its home (worldgen/src/lairs.rs).
// The world picks which chambers from its seed, at world creation (so a
// change here shows in a new world, or chunks not yet visited).
//   depth: how deep under the surface (cells, from, to)
//   zones: underground biomes (fungal, crystal, toxic, none = plain rock); [] any
//   chance: share of the chambers it could take that it does
//   lining: what lines its walls (and hangs from its roof), density 0..1
//   keepers: who lives there, and how many; min_size: half width at least
//   start: one of the start valley's shallow caverns' (only those): Any
//     side, the Dark wood's or the Light forest's; each cavern takes one
//     of its side's in turn, so they differ
//   chest: a chest on its floor
[
    // The start valley's caverns.
    (name: "orc den", depth: (0, 400), chance: 1.0, start: Any, chest: true,
     lining: "cobweb", density: 0.0, keepers: [("orc", 2), ("orc_archer", 1)]),
    (name: "bone crypt", depth: (0, 400), chance: 1.0, start: Any, chest: true,
     lining: "cobweb", density: 0.15, keepers: [("skeleton", 2)]),
    (name: "spider lair", depth: (0, 400), chance: 1.0, start: Dark, chest: true,
     lining: "cobweb", density: 0.5, keepers: [("spider", 1), ("egg_sac", 2), ("cocoon", 2)]),
    (name: "zombie burrow", depth: (0, 400), chance: 1.0, start: Dark, chest: true,
     lining: "cobweb", density: 0.05, keepers: [("zombie", 3)]),
    (name: "slime pool", depth: (0, 400), chance: 1.0, start: Light, chest: true,
     lining: "slime", density: 0.15, keepers: [("slime", 2), ("blue_slime", 1)]),
    (name: "treasure grotto", depth: (0, 400), chance: 1.0, start: Light, chest: true,
     lining: "cobweb", density: 0.05, keepers: [("bat", 2)]),
    (name: "spider nest", depth: (180, 150000), zones: ["none", "fungal"], chance: 0.08,
     lining: "cobweb", density: 0.55, keepers: [("spider", 1), ("egg_sac", 2), ("spiderling", 1), ("cocoon", 3)]),
    (name: "slime pit", depth: (90, 150000), zones: ["toxic"], chance: 0.3,
     lining: "slime", density: 0.25, keepers: [("acid_slime", 3)]),
    (name: "centipede hole", depth: (120, 150000), zones: ["none", "fungal"], chance: 0.06,
     lining: "cobweb", density: 0.04, keepers: [("centipede", 2)]),
    (name: "bone pit", depth: (600, 150000), zones: [], chance: 0.06,
     lining: "cobweb", density: 0.2, keepers: [("skeleton", 3), ("vampire_bat", 2)]),
]
