// Every material in the world. Hot-reloaded while the game runs.
//
// kind:         Empty | Static | Powder | Liquid | Gas | Fire | Plant
// density:      heavier powders/liquids sink through lighter liquids/gases
// hardness:     0 = instant … 255 = indestructible (tools dig up to their power)
// dispersion:   liquids: sideways cells per tick; gases: sideways jitter
// flammability: chance /256 per tick to catch from something burning or `hot`,
//               or when above `ignites_at`. Together with burn_time this sets how
//               far fire spreads: grass is tuned so one spark burns roughly half a
//               meadow, sometimes fizzles, occasionally runs (tested over 20 seeds).
// burn_time:    how long it burns in place, in steps of 4 ticks (default 45 = 3 s)
// burns_into:   what's left after burning out (+ burns_into_chance /256; default nothing)
// lifetime:     (min, max) decay steps for gases and fire; one step = `decay_every` ticks
// crumbles_into: what a solid shatters into when blasted but not destroyed
//
// Temperature (°C). Cells store heat relative to the local ambient (colder up
// high, warmer deep down); these thresholds are absolute:
// heat:         starting heat relative to ambient (lava 1200, ice -30)
// heat_source:  keeps its heat instead of cooling (lava, burning fire)
// conductivity: 0..255 how fast heat moves through it (default by kind)
// above / below: (°C, "material") melt/boil/freeze into something else
// ignites_at:   catches fire at this temperature
// explodes:     (radius, power, chance/256) when it catches fire
// still:        a plant that doesn't sway (illusory walls)
// hangs:        a plant held up from above as well as from below (cobwebs)
// grows:        a growth (wood, stems): in the background it carries what grows on
//               it and falls when cut off; background that doesn't grow (walls)
//               stays put and holds nothing up
// platform:     creatures stand on it but pass up through it (and drop through
//               holding down)
// pulse:        how much its glow breathes (0 steady … 255 full to nothing)
// shimmer:      how deep its glow glimmers, patch by patch (gems, crystals)
// motes:        glowing motes drift up off it (spores)
// eats:         (hardness, bites, chance, spent_into): eats solids, powders and
//               plants up to `hardness` (softer faster, `chance`/256 a tick at
//               the softest); each cell of it takes `bites` before it's spent
// inert:        nothing eats it (glass, gold)
// charges:      carries electricity: lightning into it charges all of it that's
//               connected (water, acid, blood, metal ores)
// colors:       gradient; each cell gets a fixed point on it
//
// `air` must stay first. Ids are assigned by order on first load and kept
// stable on reload, so reordering here is safe while the game runs.
(
    materials: [
        (name: "air", kind: Empty, colors: []),

        // ---- solids -------------------------------------------------------
        (name: "bedrock",  kind: Static, density: 9999, hardness: 255, colors: [(28, 26, 32), (44, 40, 50)]),
        (name: "stone",    kind: Static, density: 2600, hardness: 60,  crumbles_into: "gravel", above: (1400, "lava"), colors: [(92, 92, 100), (122, 120, 128), (104, 104, 112)]),
        (name: "dirt",     kind: Static, density: 1500, hardness: 20,  crumbles_into: "soil", colors: [(96, 62, 36), (118, 78, 44), (104, 68, 40)]),
        (name: "grass",    kind: Static, density: 1400, hardness: 10,  flammability: 2, ignites_at: 250, burn_time: 10, burns_into: "soil", crumbles_into: "soil", chars_at: 1.0, colors: [(58, 140, 44), (82, 170, 56)]),
        (name: "snow",     kind: Static, density: 400,  hardness: 5,   heat: -10, above: (1, "water"), conductivity: 15, coats: "wet", latent: 300, colors: [(226, 232, 240), (246, 248, 252)]),
        // Hard to get going: a small fire on a trunk often fizzles (fizzles:
        // a lone flame goes out), a crown or a blaze takes it (SPEC §3.8).
        (name: "wood",     kind: Static, grows: true, density: 700,  hardness: 25,  flammability: 6, ignites_at: 280, conductivity: 12, burn_time: 225, spread: 2, fizzles: 40, burns_into: "charcoal", burns_into_chance: 64, chars_into: "charcoal", colors: [(58, 36, 20), (88, 58, 30), (118, 80, 42), (138, 96, 54)]),
        (name: "obsidian", kind: Static, density: 2800, hardness: 120, crumbles_into: "gravel", above: (1600, "lava"), colors: [(34, 18, 52), (52, 30, 74)]),
        // The deep's rock: darker and harder than stone.
        (name: "slate",    kind: Static, density: 2800, hardness: 80, crumbles_into: "gravel", above: (1500, "lava"), colors: [(62, 64, 76), (74, 76, 90), (56, 58, 68), (68, 70, 82)]),
        // The underworld's rock: cooled lava.
        (name: "basalt",   kind: Static, density: 3000, hardness: 95, crumbles_into: "gravel", above: (1650, "lava"), colors: [(40, 36, 40), (52, 46, 50), (34, 30, 34), (60, 50, 50)]),
        // Laid, not grown: a pattern of shades anchored to the world grid (rows
        // from the top, hex 0 dark … f light), so bricks and planks tile.
        (name: "brick",    kind: Static, density: 2400, hardness: 70, crumbles_into: "gravel", above: (1450, "lava"),
            colors: [(52, 50, 54), (96, 94, 100), (132, 128, 134), (156, 152, 158)],
            pattern: ["33333333", "3cbbbaa9", "3baaa998", "3a999887", "33333333", "aa93cbbb", "9983baaa", "8873a999"]),
        (name: "planks",   kind: Static, density: 650, hardness: 22, flammability: 7, ignites_at: 270, conductivity: 12, burn_time: 180, spread: 3, fizzles: 30, burns_into: "charcoal", burns_into_chance: 64, chars_into: "charcoal",
            colors: [(60, 38, 22), (102, 68, 38), (136, 94, 54), (158, 112, 66)],
            pattern: ["aabbbabb", "99aaa2aa", "8899929a", "22222222", "bbabbbaa", "a2aaaa99", "92999888", "22222222"]),
        // Ores and gems (DESIGN §3.2 step 6): harder the deeper they lie, so a
        // pickaxe's tier sets how deep you can profit (copper 70, iron 100,
        // gold 115, mithril 150). Ores are rock flecked with metal (the ramp
        // alternates), gems glow faintly where they break into a cave.
        (name: "copper_ore",  kind: Static, charges: true, density: 2800, hardness: 50, crumbles_into: "gravel", above: (1300, "lava"),
            colors: [(98, 94, 98), (178, 96, 50), (112, 106, 108), (220, 134, 70), (96, 90, 92)]),
        (name: "iron_ore",    kind: Static, charges: true, density: 3200, hardness: 65, crumbles_into: "gravel", above: (1450, "lava"),
            colors: [(100, 96, 100), (176, 100, 74), (118, 110, 112), (216, 148, 110), (92, 88, 92)]),
        (name: "silver_ore",  kind: Static, charges: true, density: 3300, hardness: 75, crumbles_into: "gravel", above: (1350, "lava"),
            colors: [(84, 86, 96), (196, 202, 214), (100, 102, 112), (236, 240, 248), (80, 82, 92)]),
        (name: "gold_ore",    kind: Static, density: 3600, hardness: 85, inert: true, charges: true, crumbles_into: "gravel", above: (1300, "lava"),
            colors: [(78, 74, 76), (214, 170, 52), (92, 86, 84), (252, 214, 96), (74, 70, 72)]),
        (name: "mithril_ore", kind: Static, charges: true, density: 3000, hardness: 110, crumbles_into: "gravel", above: (1700, "lava"), glow: (6, 24, 28), shimmer: 220,
            colors: [(58, 60, 74), (80, 186, 200), (68, 70, 86), (150, 240, 244), (54, 56, 70)]),
        (name: "amethyst",    kind: Static, density: 2650, hardness: 60, crumbles_into: "gravel", glow: (46, 18, 70), opacity: 40, shimmer: 255,
            colors: [(96, 44, 146), (150, 86, 212), (196, 146, 246), (120, 60, 180)]),
        (name: "emerald",     kind: Static, density: 2750, hardness: 80, crumbles_into: "gravel", glow: (4, 22, 10), opacity: 40, shimmer: 255,
            colors: [(20, 112, 58), (46, 178, 96), (132, 236, 166), (30, 140, 72)]),
        (name: "ruby",        kind: Static, density: 4000, hardness: 100, crumbles_into: "gravel", glow: (44, 5, 10), opacity: 40, shimmer: 255,
            colors: [(132, 14, 32), (206, 42, 62), (255, 118, 128), (160, 22, 44)]),
        // A one-way platform: creatures stand on it, jump up through it, and
        // drop through it holding down. To everything else it's wood.
        (name: "platform", kind: Static, platform: true, density: 650, hardness: 20, flammability: 7, ignites_at: 270, conductivity: 12, burn_time: 150, spread: 3, fizzles: 30, burns_into: "charcoal", burns_into_chance: 64, chars_into: "charcoal", opacity: 60,
            colors: [(60, 38, 22), (102, 68, 38), (136, 94, 54), (158, 112, 66)],
            pattern: ["aabbbabb", "88999899", "aabbbabb", "88999899", "aabbbabb", "88999899", "aabbbabb", "88999899"]),
        // Built: what structures are made of (worldgen/src/structures.rs).
        // Crypt stone: big dark blocks in offset courses, hard enough that a
        // copper pickaxe won't dig a way round the rooms.
        (name: "crypt_stone", kind: Static, density: 2600, hardness: 90, crumbles_into: "gravel", above: (1400, "lava"),
            colors: [(40, 42, 40), (70, 76, 68), (98, 104, 92), (124, 130, 116)],
            pattern: ["11111111", "7a9b9a81", "69a9a871", "5878a761", "11111111", "9a81ba9b", "8971a9a8", "7861a878"]),
        // A weak wall: crypt stone, cracked (a sharp eye sees the cracks); one
        // hit breaks it.
        (name: "cracked_stone", kind: Static, density: 2400, hardness: 4, crumbles_into: "gravel",
            colors: [(40, 42, 40), (70, 76, 68), (98, 104, 92), (124, 130, 116)],
            pattern: ["11111111", "7a9b3a81", "69a3a871", "5873a761", "11111111", "9a81b39b", "8971a3a8", "7861a838"]),
        // An illusory wall: looks like crypt stone, but it's a (still) plant,
        // so creatures walk straight through it.
        (name: "false_wall", kind: Plant, still: true, density: 200, hardness: 4, opacity: 220,
            colors: [(40, 42, 40), (70, 76, 68), (98, 104, 92), (124, 130, 116)],
            pattern: ["11111111", "7a9b9a81", "69a9a871", "5878a761", "11111111", "9a81ba9b", "8971a9a8", "7861a878"]),
        // Castle stone: big pale ashlar blocks; harder than crypt stone.
        (name: "ashlar", kind: Static, density: 2600, hardness: 100, crumbles_into: "gravel", above: (1450, "lava"),
            colors: [(62, 58, 54), (116, 110, 100), (148, 140, 126), (176, 168, 152)],
            pattern: ["11111111", "9aba9ab1", "8a9a8a91", "7898a781", "11111111", "b1a9aba9", "a18a9a8a", "917898a7"]),
        (name: "cracked_ashlar", kind: Static, density: 2400, hardness: 4, crumbles_into: "gravel",
            colors: [(62, 58, 54), (116, 110, 100), (148, 140, 126), (176, 168, 152)],
            pattern: ["11111111", "9ab39ab1", "8a938a91", "78938781", "11111111", "b1a93ba9", "a18a3a8a", "91789387"]),
        (name: "false_ashlar", kind: Plant, still: true, density: 200, hardness: 4, opacity: 220,
            colors: [(62, 58, 54), (116, 110, 100), (148, 140, 126), (176, 168, 152)],
            pattern: ["11111111", "9aba9ab1", "8a9a8a91", "7898a781", "11111111", "b1a9aba9", "a18a9a8a", "917898a7"]),
        // Underground biomes (worldgen/src/caves.rs). Fungi are wet: they
        // take more heat than wood to catch (and shrivel to ash when very
        // hot). Fungal hollows: dark,
        // soft soil; sprouts on the floors (stems below, glowing tips);
        // giant mushrooms standing in the chambers (background).
        (name: "fungal_soil", kind: Static, density: 1400, hardness: 25, crumbles_into: "soil",
            colors: [(34, 26, 52), (48, 36, 70), (62, 48, 88), (44, 34, 60)]),
        (name: "glowcap",     kind: Plant, still: true, density: 150, hardness: 1, flammability: 6, ignites_at: 360, burn_time: 20, opacity: 30, glow: (10, 40, 44), pulse: 90, motes: true,
            colors: [(150, 140, 176), (176, 166, 200), (60, 210, 200), (170, 255, 240)]),
        (name: "mushroom_stem", kind: Static, grows: true, density: 600, hardness: 20, flammability: 3, ignites_at: 420, above: (500, "ash"), burn_time: 120, burns_into: "ash", burns_into_chance: 60,
            colors: [(128, 112, 150), (160, 146, 182), (190, 178, 210)]),
        (name: "mushroom_cap",  kind: Plant, still: true, density: 200, hardness: 2, flammability: 6, ignites_at: 380, above: (450, "ash"), burn_time: 40, opacity: 90, glow: (12, 44, 52), pulse: 110, motes: true,
            colors: [(16, 50, 70), (24, 96, 118), (40, 150, 160), (90, 210, 200), (200, 255, 240)]),
        (name: "mushroom_gills", kind: Plant, still: true, density: 150, hardness: 1, flammability: 6, ignites_at: 380, above: (450, "ash"), burn_time: 30, opacity: 60, glow: (40, 10, 60), pulse: 160,
            colors: [(110, 30, 140), (170, 60, 210), (220, 120, 250)]),
        // A cap's hanging strands and a lantern stalk's bulb: the brightest.
        (name: "mushroom_glow", kind: Plant, still: true, density: 150, hardness: 1, flammability: 6, ignites_at: 380, above: (450, "ash"), burn_time: 20, opacity: 30, glow: (24, 80, 84), pulse: 170, motes: true,
            colors: [(100, 220, 210), (160, 250, 240), (220, 255, 250)]),
        // Bracket fungi on the walls: shelves to stand on.
        (name: "fungus_shelf", kind: Static, platform: true, density: 500, hardness: 15, glow: (10, 14, 6), pulse: 60, flammability: 4, ignites_at: 400, above: (500, "ash"), burn_time: 90, burns_into: "ash", burns_into_chance: 60,
            colors: [(96, 60, 34), (140, 92, 50), (184, 128, 70), (212, 160, 96)]),
        // Glowing vines hanging from the ceilings; brighter toward the tip.
        (name: "glow_vine",   kind: Plant, hangs: true, density: 150, hardness: 1, flammability: 8, ignites_at: 360, burn_time: 20, opacity: 25, glow: (6, 34, 36), pulse: 120,
            colors: [(20, 60, 60), (30, 100, 96), (60, 170, 160), (150, 250, 230)]),
        // Crystal caves: crystals grow into the chambers and stud the walls.
        (name: "crystal",     kind: Static, density: 2650, hardness: 70, crumbles_into: "gravel", glow: (18, 30, 42), opacity: 40, shimmer: 255,
            colors: [(140, 200, 240), (180, 230, 255), (225, 245, 255), (205, 185, 250)]),
        // Toxic grottos: a glowing crust over the rock (acid in the pools). What
        // the acid has already left: it eats no further (inert), so the pools stay.
        (name: "toxic_crust", kind: Static, density: 2200, hardness: 30, inert: true, crumbles_into: "gravel", glow: (6, 22, 3),
            colors: [(60, 90, 30), (84, 130, 40), (110, 170, 50), (70, 110, 36)]),
        // Wax below, a flame on top (the worldgen shades each cell).
        (name: "candle", kind: Static, density: 900, hardness: 3, glow: (10, 6, 2), opacity: 10,
            colors: [(176, 166, 136), (222, 212, 180), (255, 176, 70), (255, 236, 150)]),
        // Traps: touching them hurts.
        (name: "spikes", kind: Static, density: 7800, hardness: 70, corrosive: 40,
            colors: [(58, 58, 64), (104, 104, 114), (150, 150, 162), (190, 190, 200)]),
        (name: "glass",    kind: Static, density: 2500, hardness: 30, inert: true,  above: (1500, "lava"), opacity: 25, colors: [(170, 200, 205), (196, 222, 226)]),
        (name: "ice",      kind: Static, density: 900,  hardness: 30,  heat: -30, above: (1, "water"), coats: "wet", opacity: 60, latent: 480, colors: [(170, 210, 240), (200, 230, 250)]),
        (name: "frozen_blood", kind: Static, density: 950, hardness: 28, heat: -30, above: (-1, "blood"), coats: "bloody", latent: 480, colors: [(112, 22, 30), (138, 40, 48), (96, 16, 24)]),

        // ---- plants: don't block creatures, burn readily, sway in the wind ----
        (name: "leaves",     kind: Plant, density: 200, hardness: 2, flammability: 18, ignites_at: 260, burn_time: 40, chars_at: 1.0, opacity: 70, colors: [(24, 64, 26), (36, 92, 34), (52, 122, 42), (76, 150, 54)]),
        // Conifer needles; the white end of the ramp is snow lying on them (the
        // worldgen shades a snowy tree's tops from it).
        (name: "needles",    kind: Plant, density: 200, hardness: 2, flammability: 22, ignites_at: 250, burn_time: 36, chars_at: 1.0, opacity: 85,
            colors: [(12, 30, 20), (20, 46, 28), (28, 60, 34), (36, 74, 40), (42, 84, 46), (206, 218, 230), (238, 242, 248)]),
        // Old growth in the deep forest: darker, and thick enough to keep the
        // light out.
        (name: "dark_leaves", kind: Plant, density: 200, hardness: 2, flammability: 16, ignites_at: 265, burn_time: 44, chars_at: 1.0, opacity: 140,
            colors: [(10, 30, 22), (16, 44, 30), (24, 60, 38), (34, 76, 46)]),
        // Age: a crypt's damp floors grow moss; corners gather cobwebs, which
        // hang from the ceiling and go up in a flash.
        (name: "moss",       kind: Plant, still: true, density: 150, hardness: 1, flammability: 6, ignites_at: 280, burn_time: 20, chars_at: 1.0, opacity: 20,
            colors: [(34, 62, 30), (52, 88, 40), (70, 110, 50), (92, 128, 62)]),
        (name: "cobweb",     kind: Plant, still: true, hangs: true, density: 20, hardness: 1, flammability: 90, ignites_at: 200, burn_time: 6, opacity: 12,
            colors: [(150, 150, 150), (190, 190, 194), (220, 220, 226)]),
        (name: "tall_grass", kind: Plant, density: 100, hardness: 1, flammability: 8, spread: 176, ignites_at: 240, burn_time: 5, chars_at: 1.0, colors: [(64, 146, 46), (92, 176, 62), (54, 124, 40)]),

        // ---- powders ------------------------------------------------------
        (name: "sand",     kind: Powder, density: 1600, hardness: 5,  above: (1100, "glass"), colors: [(206, 176, 110), (226, 198, 132), (196, 164, 100)]),
        // Under desert sand: sand pressed into rock.
        (name: "sandstone", kind: Static, density: 2200, hardness: 35, crumbles_into: "sand", colors: [(178, 142, 90), (192, 156, 100), (166, 132, 84), (184, 150, 96)]),
        (name: "gravel",   kind: Powder, density: 1900, hardness: 15, above: (1400, "lava"), colors: [(96, 94, 90), (130, 126, 120), (80, 78, 76)]),
        (name: "soil",     kind: Powder, density: 1400, hardness: 8,  colors: [(92, 60, 34), (112, 74, 42)]),
        (name: "ash",      kind: Powder, density: 300,  hardness: 1,  colors: [(70, 68, 66), (98, 96, 94)]),
        // What burnt wood leaves (and charred wood that was put out). Flames
        // don't spread onto it (spread 0) and heat lights it only above 700 °C,
        // hotter than burning wood, so it survives the fire that made it.
        // Blasts, lava, the heat gun or the igniter do. Burns long, down to
        // ash. Future smelting fuel.
        (name: "charcoal", kind: Powder, density: 450,  hardness: 12, flammability: 1, spread: 0, ignites_at: 700, conductivity: 20, burn_time: 250, burns_into: "ash", burns_into_chance: 200, chars_at: 1.0, colors: [(26, 24, 24), (38, 35, 34), (50, 46, 44), (20, 19, 19)]),
        (name: "coal",     kind: Powder, density: 1300, hardness: 10, flammability: 30, ignites_at: 350, burn_time: 200, burns_into: "ash", burns_into_chance: 90, colors: [(24, 24, 26), (40, 40, 44)]),

        // ---- liquids ------------------------------------------------------
        (name: "water",    kind: Liquid, density: 1000, charges: true, dispersion: 6, above: (100, "steam"), below: (0, "ice"), coats: "wet", opacity: 30, latent: 250, colors: [(38, 92, 196), (48, 110, 214)]),
        // Floats on water and burns on it (a burning liquid isn't put out by
        // what it floats on). A poor heat conductor, so a burning slick
        // doesn't boil away the lake under it.
        (name: "oil",      kind: Liquid, density: 800,  dispersion: 4, flammability: 90, ignites_at: 220, burn_time: 25, conductivity: 6, coats: "oily", viscosity: 40, colors: [(56, 38, 24), (72, 52, 30)]),
        // Boils and freezes like water (a little below 0: what's dissolved in it).
        (name: "blood",    kind: Liquid, density: 1060, charges: true, dispersion: 3, above: (100, "blood_steam"), below: (-2, "frozen_blood"), coats: "bloody", latent: 250, viscosity: 70, colors: [(136, 10, 16), (164, 18, 24)]),
        (name: "lava",     kind: Liquid, density: 2500, dispersion: 2, hot: true, heat: 1200, heat_source: true, conductivity: 60, glow: (255, 105, 30), viscosity: 200, colors: [(255, 96, 16), (255, 150, 40), (230, 60, 10)]),
        // Eats anything up to stone-and-ore hard (not glass or gold), each cell
        // good for 6 bites; burns what it touches (corrosive, damage/s); carries
        // lightning. Boils into acid fumes.
        (name: "acid",     kind: Liquid, density: 1100, dispersion: 4, corrosive: 30, charges: true,
            eats: (hardness: 90, bites: 6, chance: 48, spent_into: "smoke"), above: (110, "acid_fumes"), coats: "acid", glow: (70, 200, 25), viscosity: 15, colors: [(120, 230, 40), (150, 250, 70)]),

        // ---- gases --------------------------------------------------------
        (name: "steam",    kind: Gas, density: 1, dispersion: 3, lifetime: (60, 200), decay_every: 3, decays_into: "water", decays_into_chance: 70, vapour: true, opacity: 5, colors: [(200, 206, 216), (228, 232, 240)]),
        // Off boiling acid: corrodes what it drifts into, weaker than acid and
        // used up doing it, condenses into acid rain downwind, and is
        // flammable: a spark flashes the cloud into fire (and the odd pop),
        // which boils more acid.
        (name: "acid_fumes", kind: Gas, density: 2, dispersion: 2, lifetime: (80, 220), decay_every: 3, decays_into: "acid", decays_into_chance: 110, corrosive: 8, flammability: 60, ignites_at: 300, explodes: (radius: 3, power: 25, chance: 4), glow: (30, 90, 10), opacity: 6, colors: [(168, 214, 70), (190, 230, 96), (150, 196, 60)]),
        // A red haze off boiling blood; condenses back into blood like steam into water.
        (name: "blood_steam", kind: Gas, density: 1, dispersion: 3, lifetime: (60, 200), decay_every: 3, decays_into: "blood", decays_into_chance: 70, colors: [(196, 120, 124), (220, 150, 152), (180, 96, 102)]),
        // Underground gas pockets. Faintly visible; very explosive.
        (name: "methane",  kind: Gas, density: 1, dispersion: 1, flammability: 255, ignites_at: 500, explodes: (radius: 10, power: 70, chance: 40), colors: [(120, 150, 110), (134, 164, 120)]),
        (name: "smoke",    kind: Gas, density: 2, dispersion: 2, lifetime: (40, 120), decay_every: 2, opacity: 6, colors: [(56, 54, 54), (84, 80, 80)]),

        // ---- fire ---------------------------------------------------------
        (name: "fire",     kind: Fire, hot: true, heat: 800, heat_source: true, lifetime: (12, 40), decays_into: "smoke", glow: (255, 170, 70), colors: [(255, 220, 90), (255, 140, 30), (230, 70, 20)]),
    ],

    // (latent: how long freezing, melting and boiling take; see material.rs.)

    // Pairwise, while touching. Checked in both directions.
    reactions: [
        (a: "lava",  b: "water",  a_into: "obsidian", b_into: "steam", chance: 255),
        (a: "lava",  b: "ice",    a_into: "obsidian", b_into: "water", chance: 128),
        (a: "lava",  b: "snow",   a_into: "lava",     b_into: "water", chance: 64),
        (a: "fire",  b: "water",  a_into: "steam",    b_into: "water", chance: 220),
        (a: "fire",  b: "ice",    a_into: "steam",    b_into: "water", chance: 40),
        (a: "fire",  b: "snow",   a_into: "steam",    b_into: "water", chance: 60),
        (a: "water", b: "blood",  a_into: "water",    b_into: "water", chance: 2),
        // Acid fumes: the same appetite as acid, weaker, used up as they bite.
        (a: "acid_fumes", b: "stone",      a_into: "air", b_into: "air", chance: 5),
