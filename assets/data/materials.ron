// Every material in the world. Hot-reloaded while the game runs.
//
// kind:         Empty | Static | Powder | Liquid | Gas | Fire | Plant
// density:      heavier powders/liquids sink through lighter liquids/gases
// hardness:     0 = instant … 255 = indestructible (tools dig up to their power)
// dispersion:   liquids: sideways cells per tick; gases: sideways jitter
// flammability: chance /256 per tick to catch from something burning or `hot`,
//               or when above `ignites_at`. Together with burn_time this sets how
//               far fire spreads: grass is tuned so one spark burns roughly half a
//               meadow, sometimes fizzles, occasionally runs (tested over 20 seeds).
// burn_time:    how long it burns in place, in steps of 4 ticks (default 45 = 3 s)
// burns_into:   what's left after burning out (+ burns_into_chance /256; default nothing)
// lifetime:     (min, max) decay steps for gases and fire; one step = `decay_every` ticks
// crumbles_into: what a solid shatters into when blasted but not destroyed
//
// Temperature (°C). Cells store heat relative to the local ambient (colder up
// high, warmer deep down); these thresholds are absolute:
// heat:         starting heat relative to ambient (lava 1200, ice -30)
// heat_source:  keeps its heat instead of cooling (lava, burning fire)
// conductivity: 0..255 how fast heat moves through it (default by kind)
// above / below: (°C, "material") melt/boil/freeze into something else
// ignites_at:   catches fire at this temperature
// explodes:     (radius, power, chance/256) when it catches fire
// colors:       gradient; each cell gets a fixed point on it
//
// `air` must stay first. Ids are assigned by order on first load and kept
// stable on reload, so reordering here is safe while the game runs.
(
    materials: [
        (name: "air", kind: Empty, colors: []),

        // ---- solids -------------------------------------------------------
        (name: "bedrock",  kind: Static, density: 9999, hardness: 255, colors: [(28, 26, 32), (44, 40, 50)]),
        (name: "stone",    kind: Static, density: 2600, hardness: 60,  crumbles_into: "gravel", above: (1400, "lava"), colors: [(92, 92, 100), (122, 120, 128), (104, 104, 112)]),
        (name: "dirt",     kind: Static, density: 1500, hardness: 20,  crumbles_into: "soil", colors: [(96, 62, 36), (118, 78, 44), (104, 68, 40)]),
        (name: "grass",    kind: Static, density: 1400, hardness: 10,  flammability: 2, ignites_at: 250, burn_time: 10, burns_into: "soil", crumbles_into: "soil", colors: [(58, 140, 44), (82, 170, 56)]),
        (name: "snow",     kind: Static, density: 400,  hardness: 5,   heat: -10, above: (1, "water"), conductivity: 15, colors: [(226, 232, 240), (246, 248, 252)]),
        (name: "wood",     kind: Static, density: 700,  hardness: 25,  flammability: 6, ignites_at: 280, conductivity: 12, burn_time: 225, burns_into: "charcoal", burns_into_chance: 64, chars_into: "charcoal", colors: [(58, 36, 20), (88, 58, 30), (118, 80, 42), (138, 96, 54)]),
        (name: "obsidian", kind: Static, density: 2800, hardness: 120, crumbles_into: "gravel", above: (1600, "lava"), colors: [(34, 18, 52), (52, 30, 74)]),
        (name: "glass",    kind: Static, density: 2500, hardness: 30,  above: (1500, "lava"), colors: [(170, 200, 205), (196, 222, 226)]),
        (name: "ice",      kind: Static, density: 900,  hardness: 30,  heat: -30, above: (1, "water"), colors: [(170, 210, 240), (200, 230, 250)]),
        (name: "frozen_blood", kind: Static, density: 950, hardness: 28, heat: -30, above: (-1, "blood"), colors: [(112, 22, 30), (138, 40, 48), (96, 16, 24)]),

        // ---- plants: don't block creatures, burn readily, sway in the wind ----
        (name: "leaves",     kind: Plant, density: 200, hardness: 2, flammability: 18, ignites_at: 260, burn_time: 40, colors: [(24, 64, 26), (36, 92, 34), (52, 122, 42), (76, 150, 54)]),
        (name: "tall_grass", kind: Plant, density: 100, hardness: 1, flammability: 8, ignites_at: 240, burn_time: 5, colors: [(64, 146, 46), (92, 176, 62), (54, 124, 40)]),

        // ---- powders ------------------------------------------------------
        (name: "sand",     kind: Powder, density: 1600, hardness: 5,  above: (1100, "glass"), colors: [(206, 176, 110), (226, 198, 132), (196, 164, 100)]),
        (name: "gravel",   kind: Powder, density: 1900, hardness: 15, above: (1400, "lava"), colors: [(96, 94, 90), (130, 126, 120), (80, 78, 76)]),
        (name: "soil",     kind: Powder, density: 1400, hardness: 8,  colors: [(92, 60, 34), (112, 74, 42)]),
        (name: "ash",      kind: Powder, density: 300,  hardness: 1,  colors: [(70, 68, 66), (98, 96, 94)]),
        // What burnt wood leaves (and charred wood that was put out). Flames
        // don't catch on it (flammability 0): only heat above 700 °C lights it,
        // hotter than burning wood, so it survives the fire that made it.
        // Blasts, lava or the heat gun do. Burns long, down to ash. Future
        // smelting fuel.
        (name: "charcoal", kind: Powder, density: 450,  hardness: 12, flammability: 0, ignites_at: 700, conductivity: 20, burn_time: 250, burns_into: "ash", burns_into_chance: 200, chars_at: 1.0, colors: [(26, 24, 24), (38, 35, 34), (50, 46, 44), (20, 19, 19)]),
        (name: "coal",     kind: Powder, density: 1300, hardness: 10, flammability: 30, ignites_at: 350, burn_time: 200, burns_into: "ash", burns_into_chance: 90, colors: [(24, 24, 26), (40, 40, 44)]),

        // ---- liquids ------------------------------------------------------
        (name: "water",    kind: Liquid, density: 1000, dispersion: 6, above: (100, "steam"), below: (0, "ice"), colors: [(38, 92, 196), (48, 110, 214)]),
        // Floats on water and burns on it (a burning liquid isn't put out by
        // what it floats on). A poor heat conductor, so a burning slick
        // doesn't boil away the lake under it.
        (name: "oil",      kind: Liquid, density: 800,  dispersion: 4, flammability: 90, ignites_at: 220, burn_time: 25, conductivity: 6, colors: [(56, 38, 24), (72, 52, 30)]),
        // Boils and freezes like water (a little below 0: what's dissolved in it).
        (name: "blood",    kind: Liquid, density: 1060, dispersion: 3, above: (100, "blood_steam"), below: (-2, "frozen_blood"), colors: [(136, 10, 16), (164, 18, 24)]),
        (name: "lava",     kind: Liquid, density: 2500, dispersion: 1, hot: true, heat: 1200, heat_source: true, conductivity: 60, colors: [(255, 96, 16), (255, 150, 40), (230, 60, 10)]),
        // Eats stone, dirt, wood and grass (reactions below) and burns what it
        // touches (corrosive, damage/s). Boils into acid fumes.
        (name: "acid",     kind: Liquid, density: 1100, dispersion: 4, corrosive: 30, above: (110, "acid_fumes"), colors: [(120, 230, 40), (150, 250, 70)]),

        // ---- gases --------------------------------------------------------
        (name: "steam",    kind: Gas, density: 1, dispersion: 3, lifetime: (60, 200), decay_every: 3, decays_into: "water", decays_into_chance: 70, colors: [(200, 206, 216), (228, 232, 240)]),
        // Off boiling acid: corrodes what it drifts into, weaker than acid and
        // used up doing it, condenses into acid rain downwind, and is
        // flammable: a spark flashes the cloud into fire (and the odd pop),
        // which boils more acid.
        (name: "acid_fumes", kind: Gas, density: 2, dispersion: 2, lifetime: (80, 220), decay_every: 3, decays_into: "acid", decays_into_chance: 110, corrosive: 8, flammability: 60, ignites_at: 300, explodes: (radius: 3, power: 25, chance: 4), colors: [(168, 214, 70), (190, 230, 96), (150, 196, 60)]),
        // A red haze off boiling blood; condenses back into blood like steam into water.
        (name: "blood_steam", kind: Gas, density: 1, dispersion: 3, lifetime: (60, 200), decay_every: 3, decays_into: "blood", decays_into_chance: 70, colors: [(196, 120, 124), (220, 150, 152), (180, 96, 102)]),
        // Underground gas pockets. Faintly visible; very explosive.
        (name: "methane",  kind: Gas, density: 1, dispersion: 1, flammability: 255, ignites_at: 500, explodes: (radius: 10, power: 70, chance: 40), colors: [(120, 150, 110), (134, 164, 120)]),
        (name: "smoke",    kind: Gas, density: 2, dispersion: 2, lifetime: (40, 120), decay_every: 2, colors: [(56, 54, 54), (84, 80, 80)]),

        // ---- fire ---------------------------------------------------------
        (name: "fire",     kind: Fire, hot: true, heat: 800, heat_source: true, lifetime: (12, 40), decays_into: "smoke", colors: [(255, 220, 90), (255, 140, 30), (230, 70, 20)]),
    ],

    // Pairwise, while touching. Checked in both directions.
    reactions: [
        (a: "lava",  b: "water",  a_into: "obsidian", b_into: "steam", chance: 255),
        (a: "lava",  b: "ice",    a_into: "obsidian", b_into: "water", chance: 128),
        (a: "lava",  b: "snow",   a_into: "lava",     b_into: "water", chance: 64),
        (a: "fire",  b: "water",  a_into: "steam",    b_into: "water", chance: 220),
        (a: "fire",  b: "ice",    a_into: "steam",    b_into: "water", chance: 40),
        (a: "fire",  b: "snow",   a_into: "steam",    b_into: "water", chance: 60),
        (a: "acid",  b: "stone",  a_into: "smoke",    b_into: "air",   chance: 24),
        (a: "acid",  b: "dirt",   a_into: "smoke",    b_into: "air",   chance: 40),
        (a: "acid",  b: "wood",   a_into: "smoke",    b_into: "air",   chance: 40),
        (a: "acid",  b: "grass",  a_into: "smoke",    b_into: "air",   chance: 60),
        (a: "water", b: "blood",  a_into: "water",    b_into: "water", chance: 2),
        // Acid fumes: the same appetite as acid, weaker, used up as they bite.
        (a: "acid_fumes", b: "stone",      a_into: "air", b_into: "air", chance: 5),
        (a: "acid_fumes", b: "dirt",       a_into: "air", b_into: "air", chance: 8),
        (a: "acid_fumes", b: "wood",       a_into: "air", b_into: "air", chance: 8),
        (a: "acid_fumes", b: "grass",      a_into: "air", b_into: "air", chance: 12),
        (a: "acid_fumes", b: "tall_grass", a_into: "air", b_into: "air", chance: 30),
    ],
)
